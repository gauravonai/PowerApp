","b":"BHL INDIA"},{"e":"vikas.shinde@jcb.com","n":"Vikas Shinde","r":"Engineer","b":"BHL INDIA"},{"e":"vishal.kalugade@jcb.com","n":"Vishal Kalugade","r":"Engineer","b":"BHL INDIA"},{"e":"vishal.kharve@jcb.com","n":"Vishal Kharve","r":"Engineer","b":"BHL INDIA"},{"e":"yedlapalli.netaji@jcb.com","n":"Yedlapalli Netaji","r":"Engineer","b":"BHL INDIA"},{"e":"zeenat.sayyed@jcb.com","n":"Zeenat Sayyed","r":"Engineer","b":"BHL INDIA"},{"e":"hod.eds@jcb.com","n":"S. Khanduri","r":"Manager","b":"EDS"}],"pos":[{"no":"1310012168","t":"PO","v":"MOTHERSON SUMI WIRING INDIA ( M2740 )","d":"2025-10-03","n":58,"amt":84152.72},{"no":"1310012169","t":"PO","v":"MOTHERSON SUMI WIRING INDIA ( M2740 )","d":"2025-10-03","n":91,"amt":50182.26},{"no":"1310012641","t":"PO","v":"UNITECH","d":"2026-05-22","n":1,"amt":22470.0},{"no":"1310012739","t":"PO","v":"RS Components& Controls (I) Ltd.","d":"2026-06-11","n":13,"amt":21030.3},{"no":"281010497","t":"PO","v":null,"d":"2025-09-01","n":2,"amt":0.0},{"no":"46199","t":"PO","v":null,"d":"2026-02-13","n":1,"amt":0.0},{"no":"9700008285","t":"PO","v":"RS Components& Controls (I) Ltd.","d":"2025-09-01","n":1,"amt":81800.0},{"no":"9700008666","t":"PO","v":"MOGLI LABS INDIA PVT LTD","d":"2024-02-29","n":1,"amt":95400.0},{"no":"9700008677","t":"PO","v":"RS Components& Controls (I) Ltd.","d":"2024-03-06","n":1,"amt":38730.0},{"no":"9700008919","t":"PO","v":"Sujata Computers Pvt Ltd ( SP0303 )","d":"2024-06-24","n":1,"amt":39000.0},{"no":"9700009002","t":"PO","v":"MOTHERSON SUMI WIRING INDIA ( M2740 )","d":"2024-08-06","n":3,"amt":86750.0},{"no":"9700009294","t":"PO","v":"MOTHERSON SUMI WIRING INDIA ( M2740 )","d":"2025-01-23","n":39,"amt":888089.0},{"no":"9700009442","t":"PO","v":"REVINE TECHNOLOGIES","d":"2026-02-25","n":1,"amt":0.0},{"no":"9700009778","t":"PO","v":"REVINE","d":"2025-09-02","n":5,"amt":2650.0},{"no":"9700009779","t":"PO","v":"REVINE","d":"2025-09-02","n":9,"amt":25002.0},{"no":"9700009808","t":"PO","v":"REVINE","d":"2025-09-22","n":1,"amt":24000.0},{"no":"9700009838","t":"PO","v":"RS Components& Controls (I) Ltd.","d":"2025-09-01","n":6,"amt":0.0},{"no":"9700009860","t":"PO","v":"BALAJI EXTRUSIONS & CABLES PVT.LTD.","d":"2025-10-10","n":11,"amt":302722.0},{"no":"9700010133","t":"PO","v":"R J ELECTRICAL ( RP0123 )","d":"2025-09-01","n":16,"amt":158545.25},{"no":"9700010183","t":"PO","v":null,"d":"2026-06-04","n":6,"amt":51925.0},{"no":"9700010226","t":"PO","v":"ROYAL ENGINEERS AND CONTRACTORS","d":"2026-05-26","n":1,"amt":8000.0},{"no":"9700010241","t":"PO","v":null,"d":"2025-09-01","n":5,"amt":0.0},{"no":"FOC_TE_01","t":"FOC","v":"TE CONNECTIVITY","d":"2026-01-27","n":3,"amt":0.0},{"no":"FOC_TE_02","t":"FOC","v":"TE CONNECTIVITY","d":"2026-02-13","n":3,"amt":0.0},{"no":"FOC_TE_03","t":"FOC","v":"TE CONNECTIVITY","d":"2026-02-13","n":10,"amt":0.0},{"no":"FOC_TE_04","t":"FOC","v":"TE CONNECTIVITY","d":"2026-02-13","n":6,"amt":0.0},{"no":"FOC_TE_05","t":"FOC","v":"TE CONNECTIVITY","d":"2026-02-13","n":3,"amt":0.0},{"no":"FOC_TE_06","t":"FOC","v":"TE CONNECTIVITY","d":"2026-02-13","n":6,"amt":0.0},{"no":"FOC_TE_07","t":"FOC","v":"TE CONNECTIVITY","d":"2026-02-13","n":10,"amt":0.0},{"no":"FOC_TE_08","t":"FOC","v":"TE CONNECTIVITY","d":"2026-02-13","n":7,"amt":0.0},{"no":"FOC_TE_09","t":"FOC","v":"TE CONNECTIVITY","d":"2026-02-13","n":9,"amt":0.0},{"no":"FOC_TE_10","t":"FOC","v":"TE CONNECTIVITY","d":"2026-02-13","n":2,"amt":0.0},{"no":"FOC_TE_11","t":"FOC","v":"TE CONNECTIVITY","d":"2026-02-13","n":41,"amt":0.0},{"no":"FOC_TE_12","t":"FOC","v":null,"d":"2026-02-13","n":16,"amt":0.0},{"no":"FOC_TE_13","t":"FOC","v":null,"d":"2026-02-13","n":12,"amt":0.0},{"no":"FOC_TE_14","t":"FOC","v":null,"d":"2026-02-25","n":71,"amt":0.0},{"no":"FOC_TE_15","t":"FOC","v":null,"d":"2025-09-01","n":1,"amt":0.0},{"no":"FOC_TE_16","t":"FOC","v":null,"d":"2025-09-01","n":1,"amt":0.0},{"no":"FOC_TE_17","t":"FOC","v":null,"d":"2025-09-01","n":1,"amt":0.0},{"no":"FOC_TE_18","t":"FOC","v":null,"d":"2026-04-02","n":15,"amt":0.0},{"no":"FOC_TE_19","t":"FOC","v":null,"d":"2025-09-01","n":8,"amt":0.0},{"no":"FOC_TE_20","t":"FOC","v":null,"d":"2025-09-01","n":3,"amt":0.0},{"no":"FOC_TE_21","t":"FOC","v":null,"d":"2025-09-01","n":16,"amt":0.0},{"no":"FOC_TE_22","t":"FOC","v":"TE CONNECTIVITY","d":"2026-07-08","n":1,"amt":0.0},{"no":"FOC_TE_23","t":"FOC","v":"TE CONNECTIVITY","d":"2026-07-13","n":4,"amt":0.0},{"no":"FOC_TE_24","t":"FOC","v":"TE CONNECTIVITY","d":"2026-08-03","n":6,"amt":0.0},{"no":"FOC_TE_25","t":"FOC","v":null,"d":"2026-08-18","n":8,"amt":0.0},{"no":"MAHENDRA BACKUP","t":"PO","v":null,"d":"2025-09-01","n":2,"amt":0.0},{"no":"RIG MATERIAL_STU_XP","t":"PO","v":null,"d":"2025-09-01","n":9,"amt":0.0},{"no":"old parts","t":"PO","v":null,"d":"2025-09-01","n":7,"amt":0.0}]};</script>
<script type="text/javascript">
/* ===================================================================
   SHA-256, ES5, no dependencies.

   The .hta runs on the Windows IE engine: there is no SubtleCrypto it can
   call synchronously, and no way to install a library on a locked-down lab
   desktop. So the hash is written out here in plain bitwise arithmetic,
   which IE has done correctly since forever.

   What this buys, and what it does not:
     IT DOES stop one engineer signing in as another, which is the actual
     problem — until now anyone could pick any name off a list and be them.
     Passwords are salted per user and stretched, so the stored value cannot
     be read back, and the same password for two people hashes differently.
     IT DOES NOT make the workbook safe for someone determined who already
     has the file. Keep EDS-Lab-Data.xlsx in a permissioned folder; the
     password stops impersonation, the folder permission stops everything else.
   =================================================================== */
var SHA256 = (function(){
  var K=[
    0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,
    0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,
    0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,
    0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,
    0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,
    0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,
    0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,
    0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2];

  function rotr(x,n){ return (x>>>n)|(x<<(32-n)); }
  /* JScript has no >>> 0 trick issues, but addition must be forced back to
     unsigned 32-bit at every step or the result drifts. */
  function add(){ var s=0; for(var i=0;i<arguments.length;i++) s=(s+arguments[i])|0; return s>>>0; }

  function utf8(str){
    var out=[], i, c;
    for(i=0;i<str.length;i++){
      c=str.charCodeAt(i);
      if(c<0x80) out.push(c);
      else if(c<0x800){ out.push(0xc0|(c>>6), 0x80|(c&0x3f)); }
      else if(c<0xd800 || c>=0xe000){ out.push(0xe0|(c>>12), 0x80|((c>>6)&0x3f), 0x80|(c&0x3f)); }
      else {
        i++;
        c=0x10000+(((c&0x3ff)<<10)|(str.charCodeAt(i)&0x3ff));
        out.push(0xf0|(c>>18), 0x80|((c>>12)&0x3f), 0x80|((c>>6)&0x3f), 0x80|(c&0x3f));
      }
    }
    return out;
  }
  function hex(bytes){
    var s="", i;
    for(i=0;i<bytes.length;i++) s+=("0"+(bytes[i]&0xff).toString(16)).slice(-2);
    return s;
  }
  function digestBytes(bytes){
    var H=[0x6a09e667,0xbb67ae85,0x3c6ef372,0xa54ff53a,
           0x510e527f,0x9b05688c,0x1f83d9ab,0x5be0cd19];
    var msg=bytes.slice(0), len=bytes.length*8, i, j;
    msg.push(0x80);
    while(msg.length%64 !== 56) msg.push(0);
    /* length as 64-bit big-endian; lab passwords are far under 2^32 bits,
       so the high word is always zero */
    msg.push(0,0,0,0, (len>>>24)&0xff, (len>>>16)&0xff, (len>>>8)&0xff, len&0xff);

    var W=new Array(64);
    for(i=0;i<msg.length;i+=64){
      for(j=0;j<16;j++)
        W[j]=((msg[i+j*4]<<24)|(msg[i+j*4+1]<<16)|(msg[i+j*4+2]<<8)|msg[i+j*4+3])>>>0;
      for(j=16;j<64;j++){
        var s0=(rotr(W[j-15],7)^rotr(W[j-15],18)^(W[j-15]>>>3))>>>0;
        var s1=(rotr(W[j-2],17)^rotr(W[j-2],19)^(W[j-2]>>>10))>>>0;
        W[j]=add(W[j-16],s0,W[j-7],s1);
      }
      var a=H[0],b=H[1],c=H[2],d=H[3],e=H[4],f=H[5],g=H[6],h=H[7];
      for(j=0;j<64;j++){
        var S1=(rotr(e,6)^rotr(e,11)^rotr(e,25))>>>0;
        var ch=((e&f)^((~e)&g))>>>0;
        var t1=add(h,S1,ch,K[j],W[j]);
        var S0=(rotr(a,2)^rotr(a,13)^rotr(a,22))>>>0;
        var maj=((a&b)^(a&c)^(b&c))>>>0;
        var t2=add(S0,maj);
        h=g; g=f; f=e; e=add(d,t1); d=c; c=b; b=a; a=add(t1,t2);
      }
      H[0]=add(H[0],a); H[1]=add(H[1],b); H[2]=add(H[2],c); H[3]=add(H[3],d);
      H[4]=add(H[4],e); H[5]=add(H[5],f); H[6]=add(H[6],g); H[7]=add(H[7],h);
    }
    var out=[];
    for(i=0;i<8;i++) out.push((H[i]>>>24)&0xff,(H[i]>>>16)&0xff,(H[i]>>>8)&0xff,H[i]&0xff);
    return out;
  }
  return {
    hex:function(str){ return hex(digestBytes(utf8(str))); },
    bytes:function(str){ return digestBytes(utf8(str)); }
  };
})();

/* Salted and stretched. The salt is the person's own username, so the same
   password chosen by two people never produces the same stored value, and a
   precomputed table built for one lab is useless against another.
   1200 rounds is imperceptible to a person signing in and a real nuisance to
   anyone trying passwords in bulk against the workbook. */
var PW_ROUNDS = 1200;
var PW_TAG    = "EDSLAB-v7";

function pwHash(email, plain){
  var salt = PW_TAG+"|"+String(email||"").toLowerCase();
  var h = SHA256.hex(salt+"|"+String(plain));
  for(var i=0;i<PW_ROUNDS;i++) h = SHA256.hex(h+"|"+salt);
  return "s1$"+h;
}
function pwVerify(email, plain, stored){
  if(!stored) return false;
  return pwHash(email, plain) === String(stored);
}
/* What counts as acceptable. Deliberately modest — this is a shop-floor tool
   and a rule nobody can satisfy just becomes a password taped to a monitor. */
function pwProblem(p){
  p = String(p||"");
  if(p.length < 6) return "Use at least 6 characters.";
  if(!/[A-Za-z]/.test(p)) return "Include at least one letter.";
  if(!/[0-9]/.test(p)) return "Include at least one number.";
  if(/^(password|123456|qwerty|welcome|jcb12345)/i.test(p)) return "That password is too easy to guess.";
  return "";
}

/* ===================================================================
   DATES — one format, everywhere, with a calendar that actually appears.

   The Windows IE engine does NOT implement <input type="date">. It renders
   it as an ordinary text box containing a raw 2026-09-18, with no picker and
   no hint about what to type. In Chrome the same markup shows a calendar, so
   the problem is invisible during development and obvious on the lab desktop.

   So the portal stops using the native control. Every date in the app is:
     stored  as yyyy-mm-dd  (what Excel and sorting want)
     shown   as DD-MMM-YYYY (18-Sep-2026 — never ambiguous between
             day-first and month-first, which matters on a shared sheet)
     picked  from a calendar drawn here, identical in both engines.
   =================================================================== */
var MON = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
var DOW = ["Mo","Tu","We","Th","Fr","Sa","Su"];

function pad2(n){ return (n<10?"0":"")+n; }

/* yyyy-mm-dd -> 18-Sep-2026 (blank stays blank, never "Invalid Date") */
function fmtDate(iso){
  var m=/^(\d{4})-(\d{2})-(\d{2})/.exec(String(iso||""));
  if(!m) return String(iso||"");
  return m[3]+"-"+MON[Number(m[2])-1]+"-"+m[1];
}
/* Accept what a person might reasonably type, return yyyy-mm-dd or "" */
function parseDate(str){
  var s=String(str||"").replace(/^\s+|\s+$/g,"");
  if(!s) return "";
  var m=/^(\d{4})-(\d{1,2})-(\d{1,2})$/.exec(s);
  if(m) return m[1]+"-"+pad2(Number(m[2]))+"-"+pad2(Number(m[3]));
  m=/^(\d{1,2})[-\/. ]([A-Za-z]{3,})[-\/. ](\d{2,4})$/.exec(s);
  if(m){
    var mi=-1, want=m[2].slice(0,3).toLowerCase();
    for(var i=0;i<12;i++) if(MON[i].toLowerCase()===want) mi=i;
    if(mi<0) return "";
    var y=Number(m[3]); if(y<100) y+=2000;
    return y+"-"+pad2(mi+1)+"-"+pad2(Number(m[1]));
  }
  /* day-first, because that is how this lab writes dates */
  m=/^(\d{1,2})[-\/.](\d{1,2})[-\/.](\d{2,4})$/.exec(s);
  if(m){
    var yy=Number(m[3]); if(yy<100) yy+=2000;
    var dd=Number(m[1]), mm=Number(m[2]);
    if(mm>12) return "";
    return yy+"-"+pad2(mm)+"-"+pad2(dd);
  }
  return "";
}
function isoToday(){
  var d=new Date();
  return d.getFullYear()+"-"+pad2(d.getMonth()+1)+"-"+pad2(d.getDate());
}
function validDate(iso){
  var m=/^(\d{4})-(\d{2})-(\d{2})$/.exec(String(iso||"")); if(!m) return false;
  var y=Number(m[1]), mo=Number(m[2]), d=Number(m[3]);
  if(mo<1||mo>12||d<1||d>31) return false;
  var t=new Date(y,mo-1,d);
  return t.getFullYear()===y && t.getMonth()===mo-1 && t.getDate()===d;
}

/* A date field. The visible box holds DD-MMM-YYYY; the ISO value rides along
   in a data attribute so nothing has to re-parse the display text. */
function dfield(label,id,iso,req,guide){
  var v=String(iso||"");
  return '<div class="fg"><label>'+esc(label)+(req?' <i>*</i>':'')+'</label>'+
    '<span class="dtwrap">'+
      '<input type="text" class="dt" id="'+id+'" data-iso="'+esc(v)+'" '+
        'value="'+esc(v?fmtDate(v):"")+'" placeholder="DD-MMM-YYYY" maxlength="11">'+
      '<button type="button" class="dtbtn" data-cal="'+id+'" title="Pick a date">'+
        '<svg width="15" height="15" viewBox="0 0 16 16" aria-hidden="true">'+
        '<rect x="1.5" y="3" width="13" height="11.5" rx="1" fill="none" stroke="currentColor" stroke-width="1.3"/>'+
        '<path d="M1.5 6.5h13M5 1.5v3M11 1.5v3" stroke="currentColor" stroke-width="1.3" fill="none"/>'+
        '</svg></button>'+
    '</span>'+
    (guide?'<span class="guide">'+esc(guide)+'</span>':'')+
    '</div>';
}
/* Read a date field back as yyyy-mm-dd */
function dval(id){
  var el=$("#"+id); if(!el) return "";
  var typed=parseDate(el.value);
  if(typed && validDate(typed)){ el.setAttribute("data-iso",typed); return typed; }
  if(!String(el.value).replace(/\s/g,"")) { el.setAttribute("data-iso",""); return ""; }
  return el.getAttribute("data-iso")||"";
}
function dset(id,iso){
  var el=$("#"+id); if(!el) return;
  el.setAttribute("data-iso",iso||"");
  el.value = iso?fmtDate(iso):"";
}

var _calOpen=null;
function closeCal(){
  if(_calOpen && _calOpen.parentNode) _calOpen.parentNode.removeChild(_calOpen);
  _calOpen=null;
}
function openCal(id){
  closeCal();
  var el=$("#"+id); if(!el) return;
  var iso=dval(id)||isoToday();
  var m=/^(\d{4})-(\d{2})-(\d{2})$/.exec(iso);
  var year=Number(m[1]), month=Number(m[2])-1, sel=iso;

  /* Hang the calendar inside the field's own wrapper, which is
     position:relative. Walking offsetParent to page coordinates instead put it
     in the wrong place whenever the field sat inside a modal or a scrolled
     panel — the calendar appeared somewhere off near the top of the document. */
  var host = el.parentNode;                  /* .dtwrap */
  var box=document.createElement("div");
  box.className="cal";
  box.setAttribute("data-for",id);
  host.appendChild(box);
  _calOpen=box;

  function draw(){
    var first=new Date(year,month,1);
    var startDow=(first.getDay()+6)%7;            /* Monday-first */
    var days=new Date(year,month+1,0).getDate();
    var h='<div class="calhd">'+
        '<button type="button" class="calnav" data-mv="-1">&lsaquo;</button>'+
        '<b>'+MON[month]+' '+year+'</b>'+
        '<button type="button" class="calnav" data-mv="1">&rsaquo;</button></div>'+
      '<table class="calg"><tr>';
    for(var d=0;d<7;d++) h+='<th>'+DOW[d]+'</th>';
    h+='</tr><tr>';
    var col=0, i;
    for(i=0;i<startDow;i++){ h+='<td></td>'; col++; }
    for(i=1;i<=days;i++){
      if(col===7){ h+='</tr><tr>'; col=0; }
      var cell=year+"-"+pad2(month+1)+"-"+pad2(i);
      h+='<td><button type="button" class="calday'+(cell===sel?" on":"")+
         (cell===isoToday()?" tdy":"")+'" data-d="'+cell+'">'+i+'</button></td>';
      col++;
    }
    while(col<7){ h+='<td></td>'; col++; }
    h+='</tr></table><div class="calft">'+
       '<button type="button" class="calx" data-d="'+isoToday()+'">Today</button>'+
       '<button type="button" class="calx" data-d="">Clear</button></div>';
    box.innerHTML=h;
    $$(".calnav",box).forEach(function(b){
      b.onclick=function(){
        month+=Number(b.getAttribute("data-mv"));
        if(month<0){ month=11; year--; } if(month>11){ month=0; year++; }
        draw();
      };
    });
    $$(".calday,.calx",box).forEach(function(b){
      b.onclick=function(){
        dset(id,b.getAttribute("data-d"));
        closeCal();
        if(el.onchange) el.onchange();
        if(el.onkeyup) el.onkeyup();
      };
    });
  }
  draw();
}
/* Attach behaviour to every date field currently on screen. Safe to call
   repeatedly — each render re-wires whatever it just drew. */
function wireDates(){
  $$("[data-cal]").forEach(function(b){
    b.onclick=function(ev){
      if(ev&&ev.stopPropagation) ev.stopPropagation();
      var id=b.getAttribute("data-cal");
      if(_calOpen && _calOpen.getAttribute("data-for")===id){ closeCal(); return; }
      openCal(id);
    };
  });
  $$("input.dt").forEach(function(el){
    /* normalise on the way out of the field, so what is stored is never
       whatever half-typed text happened to be sitting there */
    el.onblur=function(){
      var iso=parseDate(el.value);
      if(iso && validDate(iso)) dset(el.id,iso);
      else if(!String(el.value).replace(/\s/g,"")) dset(el.id,"");
      else dset(el.id, el.getAttribute("data-iso")||"");
    };
  });
}

/* ===================================================================
   COLUMN FILTERS

   "Can add filter section in all column."

   Rather than hand-writing a filter for every screen, any table marked
   class="flt" grows a filter row under its header: a text box per column,
   or a dropdown where the column holds a small set of repeated values
   (a status, a role, a stage), which is where a dropdown genuinely beats
   typing. Filtering is done on the rendered rows, so it works the same on
   every screen without each one needing its own plumbing.

   No flex, no grid — a table row, which is what the IE engine wants anyway.
   =================================================================== */
/* textContent, not innerText. innerText makes the IE engine lay the page out
   to answer each call; on a 500-row ledger that is thousands of layouts just
   to build the filter lists. textContent reads the text without any. */
function cellText(td){
  var t = td.textContent !== undefined ? td.textContent : td.innerText;
  return String(t||"").replace(/\s+/g," ").replace(/^\s+|\s+$/g,"");
}
function wireFilters(){
  $$("table.flt").forEach(function(tb){
    if(tb.getAttribute("data-flt")==="on") return;     /* already built */
    var thead=tb.getElementsByTagName("thead")[0];
    var tbody=tb.getElementsByTagName("tbody")[0];
    if(!thead || !tbody) return;
    var hrow=thead.rows[thead.rows.length-1];
    if(!hrow) return;
    var ncol=hrow.cells.length;
    var rows=tbody.rows;
    if(!rows.length) return;

    /* Work out which columns are worth a dropdown: few distinct values,
       repeated often. Everything else gets a text box. */
    var cols=[], c, r;
    for(c=0;c<ncol;c++){
      var seen={}, list=[], blank=0;
      for(r=0;r<rows.length;r++){
        var cell=rows[r].cells[c];
        if(!cell){ continue; }
        var v=cellText(cell);
        if(!v){ blank++; continue; }
        if(!seen[v]){ seen[v]=1; list.push(v); }
        if(list.length>14) break;                       /* too varied for a list */
      }
      cols.push({pick: list.length>0 && list.length<=14 && list.length<rows.length,
                 vals: list.sort()});
    }

    var frow=thead.insertRow(-1);
    frow.className="fltrow";
    for(c=0;c<ncol;c++){
      var cellEl=frow.insertCell(-1);
      var head=cellText(hrow.cells[c]);
      if(cols[c].pick){
        var opts='<option value="">All</option>';
        for(var k=0;k<cols[c].vals.length;k++)
          opts+='<option>'+esc(cols[c].vals[k])+'</option>';
        cellEl.innerHTML='<select class="fx" data-c="'+c+'" title="Filter by '+esc(head)+'">'+opts+'</select>';
      } else {
        cellEl.innerHTML='<input type="text" class="fx" data-c="'+c+'" placeholder="–" title="Filter by '+esc(head)+'">';
      }
    }
    tb.setAttribute("data-flt","on");

    function apply(){
      var f=[], i;
      $$(".fx",frow).forEach(function(el){
        var v=String(el.value||"").replace(/^\s+|\s+$/g,"").toUpperCase();
        if(v) f.push({c:Number(el.getAttribute("data-c")), v:v,
                      exact: el.tagName.toLowerCase()==="select"});
      });
      var shown=0;
      for(i=0;i<rows.length;i++){
        var row=rows[i], ok=true;
        for(var j=0;j<f.length;j++){
          var cell=row.cells[f[j].c];
          var txt=cell?cellText(cell).toUpperCase():"";
          if(f[j].exact ? (txt!==f[j].v) : (txt.indexOf(f[j].v)<0)){ ok=false; break; }
        }
        row.style.display = ok ? "" : "none";
        if(ok) shown++;
      }
      var note=tb.parentNode ? $(".fltnote", tb.parentNode) : null;
      if(note) note.innerHTML = f.length
        ? (shown+" of "+rows.length+" rows match")
        : (rows.length+" rows");
    }
    $$(".fx",frow).forEach(function(el){ el.oninput=apply; el.onchange=apply; });
  });
}

/* ===================================================================
   ROLES — as people actually type them into the Users tab.

   The Users tab is edited by hand. "Lab Admin", "lab admin", "Admin",
   "LabAdmin", "Store", "Lab Incharge" all mean the same job, and v7 only
   recognised the exact string "Lab Admin" — anyone typed any other way
   simply never appeared behind the Admin door. Every role is folded to one
   of four canonical names here, once, as the workbook is read.
   Anything unrecognised becomes Engineer: the least access, never more.
   =================================================================== */
function canonRole(r){
  var k=String(r||"").toLowerCase().replace(/[^a-z]/g,"");
  if(!k) return "Engineer";
  if(k==="lablead"||k==="lead"||k==="labhead"||k==="teamlead") return "Lab Lead";
  if(k.indexOf("admin")>=0||k==="store"||k==="storekeeper"||k==="stores"||
     k.indexOf("incharge")>=0||k==="labincharge") return "Lab Admin";
  if(k.indexOf("manager")>=0||k==="mgr"||k==="hod"||k==="head") return "Manager";
  return "Engineer";
}

/* ===================================================================
   BIG TABLES, PAINTED IN TWO STEPS

   Laying out 400 table rows costs the browser ~100 ms in Chrome and a good
   deal more in the IE engine; the first 60 cost ~20 ms. So a big table is
   drawn with its first rows at once — the screen is there, readable, in
   the time it takes to click — and the full table replaces it a moment
   later. Nothing is truncated: every row still arrives, and the column
   filters are only built once the whole table is in, so they always search
   everything.
   =================================================================== */
var _paintTok=0;
function paintBig(el, htmlFor, total, after){
  if(!el) return;
  var tok=++_paintTok;
  if(total<=90){ el.innerHTML=htmlFor(total,false); if(after) after(); return; }
  el.innerHTML=htmlFor(60,true);
  setTimeout(function(){
    /* a newer paint (another search keystroke, another screen) wins */
    if(tok!==_paintTok || !el.parentNode) return;
    el.innerHTML=htmlFor(total,false);
    if(after) after();
  },15);
}

/* ===================================================================
   JCB EDS LAB — MATERIAL MANAGEMENT PORTAL
   One .hta file. Reads one Excel file. Nothing else to install.
   Open the same content in a browser and it runs as a safe demo.
   =================================================================== */
var IS_HTA = false;
try { IS_HTA = !!(window.ActiveXObject || "ActiveXObject" in window); } catch(e){}

var XL_NAME = "EDS-Lab-Data.xlsx";     // the one Excel file, sitting beside this portal
var POLL_MS = 10000;                   // how often we check whether the admin saved it

/* Who is sitting at this desk. Windows already knows — the portal asks it
   rather than making anyone type a name, and matches the answer against the
   Users tab. Returns "" in a browser, where the portal runs as a demo. */
function winUser(){
  try{ return new ActiveXObject("WScript.Network").UserName || ""; }catch(e){}
  try{ return new ActiveXObject("WScript.Shell").ExpandEnvironmentStrings("%USERNAME%") || ""; }catch(e){}
  return "";
}

/* ---------- THE EXCEL FILE --------------------------------------- */
var XLS = (function(){
  var folder="", path="", stamp=0, lastErr="", pending=[];
  function fso(){ return new ActiveXObject("Scripting.FileSystemObject"); }

  function here(){
    try{
      var p = decodeURIComponent(location.pathname).replace(/^\//,"").replace(/\//g,"\\");
      return fso().GetParentFolderName(p);
    }catch(e){ return ""; }
  }
  function locate(){
    folder = here();
    var f=fso(), cand = folder+"\\"+XL_NAME;
    try{
      if(f.FileExists(folder+"\\config.json")){
        var s=f.OpenTextFile(folder+"\\config.json",1), t=s.ReadAll(); s.Close();
        var cfg=eval("("+t+")");
        if(cfg.excelPath && f.FileExists(cfg.excelPath)){ path=cfg.excelPath; folder=f.GetParentFolderName(path); return true; }
      }
    }catch(e){}
    if(f.FileExists(cand)){ path=cand; return true; }
    lastErr = XL_NAME+" was not found next to the portal.";
    return false;
  }
  function mtime(){
    try{ return fso().GetFile(path).DateLastModified.valueOf(); }catch(e){ return 0; }
  }
  /* read one sheet's table into an array of rows, in ONE call */
  function grab(ws, table){
    var rng;
    try{ rng = ws.ListObjects(table).Range; }catch(e){ rng = ws.UsedRange; }
    var rc = rng.Rows.Count, cc = rng.Columns.Count, out=[];
    if(rc<2) return out;
    var flat = new VBArray(rng.Value2).toArray();   // column-major
    for(var r=1;r<rc;r++){                          // skip header row
      var row=[];
      for(var c=0;c<cc;c++) row.push(flat[c*rc+r]);
      out.push(row);
    }
    return out;
  }
  function xlDate(v){
    if(v==null) return "";
    if(typeof v==="number"){                        // Excel serial
      var d=new Date(Date.UTC(1899,11,30)+v*86400000);
      return d.toISOString().slice(0,10);
    }
    var s=String(v);
    var m=s.match(/(\d{4})-(\d{2})-(\d{2})/); if(m) return m[0];
    m=s.match(/(\d{1,2})[\/.-](\d{1,2})[\/.-](\d{4})/);
    if(m) return m[3]+"-"+("0"+m[2]).slice(-2)+"-"+("0"+m[1]).slice(-2);
    return s.slice(0,10);
  }
  var IN={"RECEIPT":1,"RETURN":1,"ADJUST+":1}, OUT={"ISSUE":1,"SCRAP":1,"ADJUST-":1};
  function parseLog(v){
    if(!v) return [];
    try{ var a=JSON.parse(String(v)); return (a && a.length!==undefined) ? a : []; }catch(e){ return []; }
  }

  function mapRows(P,M,U,S,PR,LC,NP,IV,PU,CB,RQ,RL){
      PR=PR||[]; LC=LC||[]; NP=NP||[]; IV=IV||[]; PU=PU||[]; CB=CB||[];
      RQ=RQ||[]; RL=RL||[];
      var parts=[], byPn={}, id=0, i;
      for(i=0;i<P.length;i++){
        var r=P[i]; if(r[0]==null||String(r[0])==="") continue;
        if(String(r[9]||"Yes").toLowerCase()==="no") continue;   // retired material
        id++;
        var p={id:id,pn:String(r[0]).replace(/^\s+|\s+$/g,""),jcb:"",lab:"",
               d:String(r[1]||""),c:String(r[2]||""),s:String(r[3]||""),
               u:String(r[4]||"NO"),l:String(r[5]||""),v:String(r[6]||""),
               cost:Number(r[7])||0,ref:Number(r[8])||0,f:"OK"};
        parts.push(p); byPn[p.pn.toUpperCase()]=p.id;
      }
      var led=[], n=0;
      for(i=0;i<M.length;i++){
        var m=M[i]; if(m[1]==null) continue;
        var pid=byPn[String(m[1]).replace(/^\s+|\s+$/g,"").toUpperCase()];
        if(!pid) continue;
        var t=String(m[2]||"").toUpperCase(), q=Math.abs(Number(m[3])||0);
        if(!q) continue;
        var sign = IN[t]?1:(OUT[t]?-1:0); if(!sign) continue;
        n++;
        led.push({id:n,p:pid,t:(t==="ISSUE"?"RELEASE":t),q:sign*q,dt:xlDate(m[0]),
                  by:String(m[6]||""),st:"",si:String(m[4]||""),c:Number(m[5])||0,r:String(m[7]||""),
                  key:String(m[8]||"")});
      }
      var users=[];
      for(i=0;i<U.length;i++){
        var u=U[i]; if(u[0]==null||String(u[0])==="") continue;
        users.push({e:String(u[0]).replace(/^\s+|\s+$/g,"").toLowerCase(),n:String(u[1]||u[0]),
                    r:canonRole(u[2]),rRaw:String(u[2]||""),b:String(u[3]||""),
                    /* stored as a hash, never the typed password itself */
                    pw:String(u[4]||""),pwOn:xlDate(u[5])});
      }
      var set={};
      for(i=0;i<S.length;i++) if(S[i][0]) set[String(S[i][0])]=S[i][1];

      var proc=[];
      for(i=0;i<PR.length;i++){
        var pr=PR[i]; if(pr[0]==null||String(pr[0])==="") continue;
        proc.push({no:String(pr[0]),dept:String(pr[1]||""),summary:String(pr[2]||""),
                   svc:String(pr[3]||""),qty:Number(pr[4])||0,raised:xlDate(pr[5]),
                   raisedBy:String(pr[6]||""),apprBy:String(pr[7]||""),apprDate:xlDate(pr[8]),
                   po:String(pr[9]||""),vendor:String(pr[10]||""),amt:Number(pr[11])||0,
                   stage:String(pr[12]||"PR RAISED"),poDate:xlDate(pr[13]),
                   delivered:xlDate(pr[14]),notes:String(pr[15]||""),
                   /* v6 — the five extra columns the manager's PR/PO form asks for */
                   prAmt:Number(pr[16])||0,inv:String(pr[17]||""),poApprDate:xlDate(pr[18]),
                   own:String(pr[19]||""),poCopy:String(pr[20]||"")});
      }
      var lic=[];
      for(i=0;i<LC.length;i++){
        var lc=LC[i]; if(lc[0]==null||String(lc[0])==="") continue;
        var exp=xlDate(lc[5]);
        lic.push({name:String(lc[0]),vendor:String(lc[1]||""),type:String(lc[2]||""),
                  seatsTotal:Number(lc[3])||0,seatsUsed:Number(lc[4])||0,expiry:exp,
                  cost:Number(lc[6])||0,notes:String(lc[8]||"")});
      }
      /* ---- v6 tabs ---- */
      var npart=[];
      for(i=0;i<NP.length;i++){
        var np=NP[i]; if(np[1]==null||String(np[1])==="") continue;
        npart.push({sr:Number(np[0])||0,no:String(np[1]),by:String(np[2]||""),
                    cat:String(np[3]||""),sub:String(np[4]||""),plant:String(np[5]||""),
                    name:String(np[6]||""),make:String(np[7]||""),model:String(np[8]||""),
                    specs:String(np[9]||""),rem:String(np[10]||""),uom:String(np[11]||"NO"),
                    hsn:String(np[12]||""),status:String(np[13]||"DRAFT"),on:xlDate(np[14])});
      }
      var invs=[];
      for(i=0;i<IV.length;i++){
        var v=IV[i]; if(v[0]==null||String(v[0])==="") continue;
        invs.push({no:String(v[0]),date:xlDate(v[1]),to:String(v[2]||""),cc:String(v[3]||""),
                   from:String(v[4]||""),ext:String(v[5]||""),mob:String(v[6]||""),
                   harness:String(v[7]||""),job:String(v[8]||""),bu:String(v[9]||""),
                   buc:String(v[10]||""),cost:String(v[11]||""),app:String(v[12]||""),
                   details:String(v[13]||""),circ:Number(v[14])||0,dcc:String(v[15]||""),
                   dcm:String(v[16]||""),recd:xlDate(v[17]),start:xlDate(v[18]),
                   done:xlDate(v[19]),mat:Number(v[20])||0,asm:Number(v[21])||0,
                   trn:Number(v[22])||0,tot:Number(v[23])||0,ref:String(v[24]||""),
                   img:String(v[25]||""),status:String(v[26]||"DRAFT"),notes:String(v[27]||"")});
      }
      var purch=[];
      for(i=0;i<PU.length;i++){
        var pu=PU[i]; if(pu[0]==null||String(pu[0])==="") continue;
        purch.push({pn:String(pu[0]),d:String(pu[1]||""),need:Number(pu[2])||0,
                    conf:Number(pu[3])||0,req:String(pu[4]||""),by:String(pu[5]||""),
                    pr:String(pu[6]||""),supNo:String(pu[7]||""),sup:String(pu[8]||""),
                    stage:String(pu[9]||"REQUIRED"),on:xlDate(pu[10]),
                    eta:xlDate(pu[11]),notes:String(pu[12]||"")});
      }
      var calib=[];
      for(i=0;i<CB.length;i++){
        var cb=CB[i]; if(cb[0]==null||String(cb[0])==="") continue;
        calib.push({no:String(cb[0]),name:String(cb[1]||""),loc:String(cb[2]||""),
                    last:xlDate(cb[3]),every:Number(cb[4])||0,due:xlDate(cb[5]),
                    own:String(cb[6]||""),status:String(cb[7]||""),notes:String(cb[8]||"")});
      }
      /* Requests, rebuilt from the workbook. The header tab carries the request
         and the lines tab carries its BOM; they are stitched back together here.
         The running history stays in the .jsonl sidecar — it is an append-only
         audit trail, not something anyone should be editing by hand in Excel. */
      var reqs=[], byNo={};
      for(i=0;i<RQ.length;i++){
        var q=RQ[i]; if(q[0]==null||String(q[0])==="") continue;
        var rq={no:String(q[0]),kind:String(q[1]||""),status:String(q[2]||"SUBMITTED"),
                by:String(q[3]||"").toLowerCase(),byName:String(q[4]||""),on:xlDate(q[5]),
                machine:String(q[6]||""),pcode:String(q[7]||""),harness:String(q[8]||""),
                stage:String(q[9]||""),bu:String(q[10]||""),cc:String(q[11]||""),
                buc:String(q[12]||""),dcc:String(q[13]||""),circ:Number(q[14])||0,
                need:xlDate(q[15]),scope:String(q[16]||""),parent:String(q[17]||""),
                upd:String(q[18]||""),updBy:String(q[19]||""),lines:[],log:parseLog(q[20])};
        if(!rq.kind) delete rq.kind;
        reqs.push(rq); byNo[rq.no]=rq;
      }
      for(i=0;i<RL.length;i++){
        var ln=RL[i]; if(ln[0]==null||String(ln[0])==="") continue;
        var host=byNo[String(ln[0])]; if(!host) continue;
        var lpn=String(ln[2]||"").replace(/^\s+|\s+$/g,"");
        host.lines.push({n:Number(ln[1])||host.lines.length+1,pn:lpn,
          pid:byPn[lpn.toUpperCase()]||null,d:String(ln[3]||""),
          q:Number(ln[4])||0,resv:Number(ln[5])||0,rel:Number(ln[6])||0,
          u:String(ln[7]||"NO"),st:String(ln[8]||""),cost:Number(ln[9])||0,
          rem:String(ln[11]||"")});
      }
      for(i=0;i<reqs.length;i++)
        reqs[i].lines.sort(function(a,b){ return a.n-b.n; });

      return {parts:parts,ledger:led,users:users,settings:set,proc:proc,lic:lic,
              npart:npart,invs:invs,purch:purch,calib:calib,reqs:reqs};
  }
  /* ==================================================================
     EXCEL ENGINE (v8) — built for a workbook on a shared network folder

     What v7 did on every write: launch a fresh Excel (1-3 s), open the
     workbook across the network (1-3 s), write, recalculate LiveStock after
     EVERY cell (418 parts x 6 SUMIFS over 20,000 rows), save (1-2 s), quit.
     A five-line release did that six times, one after another, and the
     screen did not change until all six had finished. That is the latency
     the lab measured.

     What this does instead:
       1. Every change made by one click is collected, then written in ONE
          workbook open — a five-line release is one open, one save.
       2. The screen updates first. The Excel write runs a moment later, when
          the person pauses, and a small pill in the header says so.
       3. One hidden Excel is kept alive between writes and released when
          idle, so the 1-3 s launch is paid once, not per click.
       4. Recalculation is switched off while cells are written and turned
          back on once, just before saving.
       5. Before paying for any of that, a millisecond file probe asks
          whether the workbook is open somewhere. If it is, the change goes
          straight into a journal file and waits — no Excel launch at all.
       6. Every write can be replayed safely. Movements carry an EntryId and
          everything else is an update-or-insert on its natural key, so a
          journal replayed after a crash or a power cut can never deduct the
          same stock twice.

     The journal is also what makes a read-only workbook workable: an
     engineer who can read the Excel but not write it still raises requests,
     they sit in the shared _pending folder, every portal shows them, and the
     first portal that CAN write — the store's — puts them into the workbook.
     ================================================================== */

  var SID = (function(){
    var n=""; try{ n=winUser(); }catch(e){}
    return String(n||"user").replace(/[^A-Za-z0-9._-]/g,"_").slice(0,30)+"-"+
           (+new Date()).toString(36)+"-"+Math.floor(Math.random()*46656).toString(36);
  })();
  var seq=0;

  /* ---- tab registry ------------------------------------------------ */
  var TAB = {
    moves : {sheet:"Movements",       table:"tblMoves"},
    proc  : {sheet:"Procurement",     table:"tblProc"},
    npart : {sheet:"NewPartRequest",  table:"tblNewPart"},
    inv   : {sheet:"Invoice",         table:"tblInvoice"},
    purch : {sheet:"OngoingPurchase", table:"tblPurch"},
    parts : {sheet:"Parts",           table:"tblParts"},
    lic   : {sheet:"Licenses",        table:"tblLicenses"},
    users : {sheet:"Users",           table:"tblUsers"},
    settings:{sheet:"Settings",       table:"tblSettings"},
    calib : {sheet:"Calibration",     table:"tblCalib"},
    req   : {sheet:"Requests",        table:"tblRequests"},
    reqln : {sheet:"RequestLines",    table:"tblReqLines"}
  };
  var REQUIRED = {parts:1, moves:1, users:1};

  /* ---- 1. one hidden Excel, reused -------------------------------- */
  var APP=null, appTimer=null, APP_IDLE_MS=20000;
  function getApp(){
    if(APP){
      try{ var probe=APP.Workbooks.Count; return APP; }catch(e){ APP=null; }   /* someone closed it */
    }
    APP=new ActiveXObject("Excel.Application");
    /* session-only settings. Nothing here is saved into the user's own Excel
       preferences — AskToUpdateLinks and IgnoreRemoteRequests are deliberately
       NOT touched, because those persist in the registry and would change how
       the person's normal Excel behaves afterwards. */
    try{ APP.Visible=false; }catch(e){}
    try{ APP.DisplayAlerts=false; }catch(e){}
    try{ APP.ScreenUpdating=false; }catch(e){}
    try{ APP.EnableEvents=false; }catch(e){}
    return APP;
  }
  function touchApp(){
    if(appTimer){ try{ clearTimeout(appTimer); }catch(e){} }
    try{ appTimer=setTimeout(releaseApp, APP_IDLE_MS); }catch(e){}
  }
  function releaseApp(){
    appTimer=null;
    if(!APP) return;
    try{
      /* If the person double-clicked one of their own spreadsheets while our
         hidden Excel was running, Windows may have opened it in here. Quitting
         would throw their work away, so hand the instance over instead. */
      if(APP.Workbooks.Count>0){
        try{ APP.ScreenUpdating=true; APP.EnableEvents=true; APP.DisplayAlerts=true;
             APP.Visible=true; APP.UserControl=true; }catch(e){}
        APP=null; return;
      }
      APP.Quit();
    }catch(e){}
    APP=null;
  }

  /* ---- 2. the millisecond lock probe ------------------------------ */
  /* Opening the workbook for append without writing anything fails at once if
     Excel has it open anywhere on the network, or if this person only has read
     access. Either way there is no point launching Excel to find out. */
  function writable(){
    try{ var s=fso().OpenTextFile(path,8,false); s.Close(); return true; }
    catch(e){ return false; }
  }

  function openBook(readOnly){
    var xl=getApp(), wb=null, i;
    /* a book left open by an earlier failure would be handed back stale */
    try{
      for(i=xl.Workbooks.Count;i>=1;i--){
        var b2=xl.Workbooks.Item(i);
        if(String(b2.FullName).toLowerCase()===String(path).toLowerCase()) b2.Close(false);
      }
    }catch(e){}
    wb=xl.Workbooks.Open(path,0,!!readOnly);
    if(!readOnly){
      var ro=false; try{ ro=!!wb.ReadOnly; }catch(e){}
      if(ro){ try{ wb.Close(false); }catch(e){} touchApp(); return null; }
    }
    return wb;
  }
  function closeBook(wb){
    if(wb){ try{ wb.Close(false); }catch(e){} }
    sweepApp();
    touchApp();
  }
  /* If Windows routed someone's own double-clicked spreadsheet into this
     hidden Excel — which can happen while it is alive — show it to them now
     rather than when the idle timer fires. Checked after every read and write
     and on every poll tick, so the worst case is a few seconds, and nothing is
     ever closed that this portal did not open. */
  function sweepApp(){
    if(!APP) return false;
    try{
      if(APP.Workbooks.Count>0){
        try{ APP.ScreenUpdating=true; APP.EnableEvents=true; APP.DisplayAlerts=true;
             APP.Visible=true; APP.UserControl=true; }catch(e){}
        APP=null;
        if(appTimer){ try{ clearTimeout(appTimer); }catch(e){} appTimer=null; }
        return true;
      }
    }catch(e){ APP=null; }
    return false;
  }
  function calc(mode){
    /* -4135 manual, -4105 automatic */
    try{ if(APP) APP.Calculation=mode; }catch(e){}
  }

  /* ---- 3. reading ------------------------------------------------- */
  var lastMissing=[];
  function readAll(){
    var wb=null, raw=null, missing=[], m0=mtime();
    try{
      wb=openBook(true);
      raw={};
      for(var k in TAB){
        try{ raw[k]=grab(wb.Worksheets(TAB[k].sheet),TAB[k].table); }
        catch(e){
          if(REQUIRED[k]) throw e;
          raw[k]=[]; missing.push(k);
        }
      }
      stamp=m0;            /* the time BEFORE reading: a save that lands mid-read
                              is then seen as a change and read on the next tick */
      lastErr="";
    }catch(e){
      raw=null;
      var why=String(e.message||e.description||e);
      /* say it the way a person at the desk can act on */
      if(/automation server|can't create object|cannot create object|ActiveX/i.test(why))
        why="Excel could not be started on this computer. Is Microsoft Excel installed?";
      else if(/no table|no sheet|subscript out of range/i.test(why))
        why="the workbook is missing a tab the portal needs (Parts, Movements or Users).";
      else if(/permission|access is denied/i.test(why))
        why="this login is not allowed to open the workbook.";
      lastErr="Could not read "+XL_NAME+": "+why;
    }finally{
      closeBook(wb);
    }
    lastMissing=missing;
    if(!raw) return null;
    /* Everything still waiting for the workbook — this portal's, and every
       other portal's in the shared _pending folder — is laid over the rows
       just read. That is why a request raised while the store has the Excel
       open still shows up for everyone straight away. */
    try{ applyOps(pendingOps(), arrayAdapter(raw)); }catch(e){}
    return mapRows(raw.parts,raw.moves,raw.users,raw.settings,raw.proc,raw.lic,
                   raw.npart,raw.inv,raw.purch,raw.calib,raw.req,raw.reqln);
  }

  /* ---- 4. operations, and the one interpreter for them ------------ */
  /* An operation is one of:
       add  append a row — only Movements; carries a unique EntryId so a
            replay finds it and skips it
       ups  update-or-insert the row matching `w`, writing the whole row
       upd  patch some columns of the row matching `w`; if it is not there
            (yet), nothing happens
     The same interpreter runs them against Excel (through COM) and against
     plain arrays (to overlay pending work onto what was just read). */
  function mkOp(k,t,extra){
    var o={k:k,t:t,id:SID+"."+(++seq),ts:+new Date(),n:seq,sid:SID};
    for(var x in extra) o[x]=extra[x];
    return o;
  }
  function norm(v,ci){
    var s=String(v==null?"":v).replace(/^\s+|\s+$/g,"");
    return ci?s.toLowerCase():s;
  }
  function rowMatches(row,w,ci){
    for(var c in w) if(norm(row[Number(c)-1],ci)!==norm(w[c],ci)) return false;
    return true;
  }
  function applyOps(ops, adapter){
    var done=0;
    for(var i=0;i<ops.length;i++){
      var o=ops[i], A=null;
      try{ A=adapter(o.t); }catch(e){ A=null; }
      if(!A) continue;
      try{
        if(o.k==="add"){
          if(o.u){ var wu={}; wu[o.u]=o.row[o.u-1]; if(A.seek(wu,false)) continue; }
          A.write(A.add(),o.row);
        } else if(o.k==="ups"){
          var h=A.seek(o.w,o.ci); if(!h) h=A.add();
          A.write(h,o.row);
        } else if(o.k==="upd"){
          var h2=A.seek(o.w,o.ci); if(!h2) continue;
          for(var c in o.p) A.set(h2,Number(c),o.p[c]);
        }
        done++;
      }catch(e){ /* one bad operation must never stop the rest landing */ }
    }
    return done;
  }
  function clean(v){ return (v===undefined||v===null)?"":v; }
  function arrayAdapter(raw){
    return function(key){
      var R=raw[key]; if(!R) return null;
      return {
        seek:function(w,ci){ for(var i=0;i<R.length;i++) if(rowMatches(R[i],w,ci)) return {i:i}; return null; },
        add:function(){ R.push([]); return {i:R.length-1}; },
        write:function(h,row){ for(var c=0;c<row.length;c++) R[h.i][c]=clean(row[c]); },
        set:function(h,col,v){ R[h.i][col-1]=clean(v); }
      };
    };
  }
  /* The Excel adapter keeps a JS copy of each table it touches, read in ONE
     call the first time a row has to be found. Looking a row up cell by cell
     through COM costs a round trip per cell; on a RequestLines tab with a few
     thousand rows that is seconds per request. */
  function comAdapter(wb){
    var cache={};
    return function(key){
      if(cache.hasOwnProperty(key)) return cache[key];
      var t=TAB[key], lo=null;
      try{ lo=wb.Worksheets(t.sheet).ListObjects(t.table); }catch(e){ cache[key]=null; return null; }
      var mirror=null;
      function load(){
        mirror=[];
        var rng=lo.Range, rc=rng.Rows.Count, cc=rng.Columns.Count;
        if(rc<2) return;
        var flat=new VBArray(rng.Value2).toArray();
        for(var r=1;r<rc;r++){ var row=[]; for(var c=0;c<cc;c++) row.push(flat[c*rc+r]); mirror.push(row); }
      }
      var A={
        seek:function(w,ci){
          if(!mirror) load();
          for(var i=0;i<mirror.length;i++) if(rowMatches(mirror[i],w,ci)) return {i:i};
          return null;
        },
        add:function(){
          var lr=lo.ListRows.Add();
          if(mirror){ mirror.push([]); return {rg:lr.Range,i:mirror.length-1}; }
          return {rg:lr.Range,i:-1};
        },
        write:function(h,row){
          var rg=h.rg||lo.ListRows.Item(h.i+1).Range;
          for(var c=0;c<row.length;c++){
            var v=clean(row[c]);
            rg.Cells(1,c+1).Value2=v;
            if(mirror && h.i>=0) mirror[h.i][c]=v;
          }
        },
        set:function(h,col,v){
          var rg=h.rg||lo.ListRows.Item(h.i+1).Range;
          rg.Cells(1,col).Value2=clean(v);
          if(mirror && h.i>=0) mirror[h.i][col-1]=clean(v);
        }
      };
      cache[key]=A;
      return A;
    };
  }

  /* ---- 5. the journal ---------------------------------------------- */
  var outbox=[], busy=false, timer=null, firstPendingAt=0, lastInputAt=0;
  var lastError="", lastSavedAt=0, syncMode=false, onStatus=null;
  var DEBOUNCE=1100, MAXWAIT=4500, RETRY=15000, IDLE_GAP=650;

  function pendDir(){ return folder+"\\_pending"; }
  function ownJournal(){ return pendDir()+"\\j-"+SID+".jsonl"; }
  function listPending(){
    var out=[];
    try{
      var f=fso(), d=pendDir(); if(!f.FolderExists(d)) return out;
      var e=new Enumerator(f.GetFolder(d).Files);
      for(;!e.atEnd();e.moveNext()){
        var fl=e.item(), nm=String(fl.Name);
        if(/^j-.+\.jsonl(\.c-.+)?$/.test(nm)) out.push({name:nm,path:String(fl.Path)});
      }
    }catch(e){}
    return out;
  }
  function readOps(p){
    var out=[];
    try{
      var f=fso(); if(!f.FileExists(p)) return out;
      var s=f.OpenTextFile(p,1), t=s.ReadAll(); s.Close();
      var L=String(t).split(/\r?\n/);
      for(var i=0;i<L.length;i++){
        if(L[i].length<5) continue;
        try{ var o=JSON.parse(L[i]); if(o && o.k && o.t) out.push(o); }catch(x){}
      }
    }catch(e){}
    return out;
  }
  function persist(ops){
    if(!ops.length) return true;
    try{
      var f=fso(), d=pendDir();
      if(!f.FolderExists(d)) f.CreateFolder(d);
      var s=f.OpenTextFile(ownJournal(),8,true), buf=[];
      for(var i=0;i<ops.length;i++) buf.push(JSON.stringify(ops[i]));
      s.Write(buf.join("\r\n")+"\r\n"); s.Close();
      return true;
    }catch(e){ return false; }
  }
  function dedupe(ops){
    var seen={}, out=[];
    for(var i=0;i<ops.length;i++){ var o=ops[i]; if(seen[o.id]) continue; seen[o.id]=1; out.push(o); }
    /* time order across portals; within one portal the sequence number keeps
       the order exact even when two operations share a millisecond */
    out.sort(function(a,b){
      if(a.ts!==b.ts) return a.ts-b.ts;
      if(a.sid!==b.sid) return a.sid<b.sid?-1:1;
      return (a.n||0)-(b.n||0);
    });
    return out;
  }
  function pendingOps(){
    var ops=outbox.slice(0), L=listPending();
    for(var i=0;i<L.length;i++) ops=ops.concat(readOps(L[i].path));
    return dedupe(ops);
  }
  /* What the header pill reports: this portal's own changes that are not in
     the workbook yet. Reading every other desk's journal across the network on
     every click just to show a number would reintroduce the latency this
     engine exists to remove. */
  function pendingCount(){
    var n=outbox.length, own="j-"+SID+".jsonl", L=listPending();
    for(var i=0;i<L.length;i++) if(L[i].name===own || L[i].name.indexOf(own+".c-")===0) n+=readOps(L[i].path).length;
    return n;
  }

  /* Claim every journal in the folder. This only ever runs while this portal
     holds the workbook open for writing, which Excel allows one portal at a
     time — so claiming is serialised by the workbook itself, and any claimed
     file already lying there is from a write that failed part-way and can
     safely be picked up. */
  function claimAll(){
    var L=listPending(), out=[], f=fso(), n=0;
    for(var i=0;i<L.length;i++){
      if(/\.c-/.test(L[i].name)){ out.push(L[i].path); continue; }
      var to=L[i].path+".c-"+SID+"-"+(n++);
      try{ f.MoveFile(L[i].path,to); out.push(to); }catch(e){ /* its owner is mid-append; next round */ }
    }
    return out;
  }

  function flush(memOps){
    memOps=memOps||[];
    if(!memOps.length && !listPending().length) return true;       /* nothing to do: no Excel at all */
    if(!writable()){ lastError="locked"; return false; }
    var wb=null, claimed=[], ok=false;
    try{
      wb=openBook(false);
      if(!wb){ lastError="locked"; return false; }
      ensureSchemaOn(wb);
      claimed=claimAll();
      var ops=memOps.slice(0);
      for(var i=0;i<claimed.length;i++) ops=ops.concat(readOps(claimed[i]));
      ops=dedupe(ops);
      if(ops.length){
        calc(-4135);
        try{ applyOps(ops, comAdapter(wb)); }
        finally{ calc(-4105); }            /* always back to automatic — one recalc, here */
        wb.Save();
      }
      ok=true;
    }catch(e){
      lastError=String(e.message||e.description||e);
      ok=false;
    }finally{
      calc(-4105);
      closeBook(wb);
    }
    if(ok){
      stamp=mtime();
      var f=fso();
      for(var j=0;j<claimed.length;j++){ try{ f.DeleteFile(claimed[j]); }catch(e){} }
    }
    return ok;
  }

  function notify(){
    if(!onStatus) return;
    try{ onStatus(status()); }catch(e){}
  }
  function status(){
    return {busy:busy, queued:outbox.length, error:lastError, savedAt:lastSavedAt};
  }
  function schedule(ms){
    if(syncMode) return;
    if(timer){ try{ clearTimeout(timer); }catch(e){} timer=null; }
    var now=+new Date(), wait=ms;
    if(firstPendingAt && (now-firstPendingAt)+ms>MAXWAIT) wait=Math.max(0,MAXWAIT-(now-firstPendingAt));
    timer=setTimeout(tick, wait);
  }
  function tick(){
    timer=null;
    /* never freeze the screen under someone's fingers — if they are mid-typing
       or mid-click, wait for the pause, unless the change has waited too long */
    var now=+new Date();
    if(lastInputAt && now-lastInputAt<IDLE_GAP && firstPendingAt && now-firstPendingAt<MAXWAIT){
      schedule(IDLE_GAP); return;
    }
    commit();
  }
  function commit(){
    if(busy){ schedule(400); return false; }
    /* a commit called directly supersedes any tick already scheduled —
       otherwise the status would go on claiming work is waiting */
    if(timer){ try{ clearTimeout(timer); }catch(e){} timer=null; }
    busy=true; notify();
    var ok=false, mem=outbox;
    outbox=[];
    try{
      /* durable first: if Excel then hangs or the machine loses power, the
         change is already on disk and the next portal to run picks it up */
      var kept = persist(mem) ? [] : mem;
      ok=flush(kept);
      if(!ok && kept.length) outbox=kept.concat(outbox);
    }catch(e){
      lastError=String(e.message||e.description||e);
      outbox=mem.concat(outbox);
      ok=false;
    }
    busy=false;
    if(ok){ firstPendingAt=outbox.length?(+new Date()):0; lastSavedAt=+new Date(); lastError=""; }
    if(outbox.length || (!ok && listPending().length)) schedule(ok?DEBOUNCE:RETRY);
    notify();
    return ok;
  }
  function enqueue(ops){
    for(var i=0;i<ops.length;i++) outbox.push(ops[i]);
    if(!firstPendingAt) firstPendingAt=+new Date();
    if(syncMode){ commit(); return true; }
    schedule(DEBOUNCE);
    notify();
    return true;
  }
  /* try to push through anything waiting — called by the poll loop */
  function kick(){
    sweepApp();
    if(busy || timer) return;
    if(outbox.length || listPending().length) schedule(0);
  }
  /* on close: make sure nothing is only in memory, then let Excel go */
  function shutdown(){
    try{ if(outbox.length && persist(outbox)) outbox=[]; }catch(e){}
    if(timer){ try{ clearTimeout(timer); }catch(e){} timer=null; }
    releaseApp();
  }

  /* ---- 6. self-migration ------------------------------------------ */
  var SCHEMA = [
    {sheet:"Requests", table:"tblRequests", cols:[
      "RequestNo","Kind","Status","RaisedByEmail","RaisedByName","DateRaised","Machine",
      "ProjectCode","HarnessPartNo","BuildStage","BusinessUnit","CostCentre","BUContact",
      "DCContact","NoOfCircuits","RequiredBy","ScopeOfWork","ParentRequest","LastUpdated",
      "LastUpdatedBy","History"]},
    {sheet:"RequestLines", table:"tblReqLines", cols:[
      "RequestNo","Sr","PartNo","Description","QtyRequested","QtyReserved","QtyReleased",
      "UOM","LineStatus","UnitCost","StoreLocation","Remarks"]},
    {sheet:"NewPartRequest", table:"tblNewPart", cols:[
      "SrNo","RequestNo","RequesterName","Category","SubCategory","PlantCode","PartName",
      "MakeBrand","ModelNo","OtherSpecs","Remarks","UOM","HSNCode","Status","DateRaised"]},
    {sheet:"Invoice", table:"tblInvoice", cols:[
      "InvoiceNo","InvoiceDate","ToName","CCName","FromName","FromExt","FromMobile",
      "HarnessPartNos","JobDescription","BusinessUnit","BUContact","CostCentre",
      "ApplicationDesc","DetailsOfRequest","NoOfCircuits","DCContact","DCMobile",
      "JobReceived","StartDate","CompletionDate","MaterialCost","AssemblyCost",
      "TransportCost","TotalCost","RefRequest","ImagePath","Status","Notes"]},
    {sheet:"OngoingPurchase", table:"tblPurch", cols:[
      "PartNo","Description","QtyRequired","QtyConfirmed","RequestNo","RaisedBy","PRNumber",
      "SupplierNo","SupplierName","Stage","DateRaised","ExpectedDate","Notes"]},
    {sheet:"Calibration", table:"tblCalib", cols:[
      "AssetNo","AssetName","Location","LastCalDate","IntervalMonths","DueDate","Owner",
      "Status","Notes"]}
  ];
  var ADDCOLS = [
    {sheet:"Users",       table:"tblUsers",    cols:["Password","PasswordSetOn"]},
    {sheet:"Procurement", table:"tblProc",     cols:["PRAmount","InvestmentType",
                                                     "POApprovedDate","Ownership","POCopyPath"]},
    /* v8: the replay key that makes a movement impossible to post twice */
    {sheet:"Movements",   table:"tblMoves",    cols:["EntryId"]},
    /* v8: each request carries its own history, so nothing lives outside Excel */
    {sheet:"Requests",    table:"tblRequests", cols:["History"]}
  ];
  var schemaOk=false, migrateNote="";
  function colLetter(n){
    var s2="";
    while(n>0){ var r=(n-1)%26; s2=String.fromCharCode(65+r)+s2; n=Math.floor((n-1)/26); }
    return s2;
  }
  /* Adds only what is missing — a sheet, or a column on the end of a table.
     Never touches existing data. Checked once per session, inside a write
     that is happening anyway, so it costs no extra workbook open. */
  function ensureSchemaOn(wb){
    if(schemaOk) return false;
    var changed=false, added=[], i, c;
    for(i=0;i<SCHEMA.length;i++){
      var def=SCHEMA[i], ws=null;
      try{ ws=wb.Worksheets(def.sheet); }catch(e){ ws=null; }
      if(!ws){
        try{
          ws=wb.Worksheets.Add(null, wb.Worksheets(wb.Worksheets.Count));
          ws.Name=def.sheet;
        }catch(e){ continue; }
      }
      var has=false;
      try{ ws.ListObjects(def.table); has=true; }catch(e){ has=false; }
      if(has) continue;
      try{
        for(c=0;c<def.cols.length;c++) ws.Cells(1,c+1).Value2=def.cols[c];
        var lo=ws.ListObjects.Add(1, ws.Range("A1:"+colLetter(def.cols.length)+"2"), null, 1);
        lo.Name=def.table;
        try{ lo.TableStyle="TableStyleMedium2"; }catch(e){}
        added.push(def.sheet); changed=true;
      }catch(e){}
    }
    for(i=0;i<ADDCOLS.length;i++){
      var a=ADDCOLS[i], lo2=null;
      try{ lo2=wb.Worksheets(a.sheet).ListObjects(a.table); }catch(e){ continue; }
      var have={}, n=0, k;
      try{ n=lo2.ListColumns.Count; }catch(e){ n=0; }
      for(k=1;k<=n;k++){ try{ have[String(lo2.ListColumns.Item(k).Name)]=1; }catch(e){} }
      for(c=0;c<a.cols.length;c++){
        if(have[a.cols[c]]) continue;
        try{ var nc=lo2.ListColumns.Add(); nc.Name=a.cols[c]; added.push(a.sheet+"."+a.cols[c]); changed=true; }
        catch(e){}
      }
    }
    schemaOk=true;
    if(added.length) migrateNote="Added to the workbook: "+added.join(", ");
    return changed;
  }

  return {
    locate:locate, path:function(){return path;}, folder:function(){return folder;},
    mtime:mtime, stampAt:function(){return stamp;}, changed:function(){ return mtime()!==stamp; },
    readAll:readAll, mapRows:mapRows, err:function(){return lastErr;},
    missing:function(){ return lastMissing.slice(0); },
    /* the write side */
    op:mkOp, enqueue:enqueue, commit:commit, kick:kick, shutdown:shutdown,
    writable:writable, pendingOps:pendingOps, pendingCount:pendingCount,
    status:status,
    /* busy: a write is running right now. hasWork: something is still to be
       written, including a retry waiting for a locked workbook. Different
       questions — the poll loop must only ever care about the first. */
    busy:function(){ return busy; },
    hasWork:function(){ return busy || outbox.length>0 || !!timer; },
    onStatus:function(fn){ onStatus=fn; },
    noteInput:function(){ lastInputAt=+new Date(); },
    sync:function(on){ syncMode=!!on; },
    sid:function(){ return SID; },
    /* for tests and diagnostics */
    applyOps:applyOps, arrayAdapter:arrayAdapter, releaseApp:releaseApp,
    ensureSchemaOn:ensureSchemaOn, migrateNote:function(){ return migrateNote; },
    reqDir:function(){ return folder+"\\Requests"; },
    pendDir:pendDir,
    imgDir:function(){ return folder+"\\InvoiceImages"; }
  };
})();


/* ---------- STORAGE ---------------------------------------------- */
var Store = (function(){
  var mem=null;
  function fso(){ return new ActiveXObject("Scripting.FileSystemObject"); }
  function lsGet(k,d){ try{ var v=localStorage.getItem(k); return v?JSON.parse(v):d; }catch(e){ return d; } }
  function lsSet(k,v){ try{ localStorage.setItem(k,JSON.stringify(v)); }catch(e){} }
  /* Live means: running as the .hta, found the workbook, AND read it. If the
     first read failed — Excel missing, file damaged, no permission — the
     portal must not show sample data under a live label and then write
     demo-based changes into the real journal. It runs as a demo instead, with
     the reason on screen. */
  var liveOk=false;
  function live(){ return IS_HTA && !!XLS.path() && liveOk; }

  /* Part ids are handed out in row order as the Parts tab is read. Retire a
     part (Active = No) half-way down the list and every part after it would
     get a new id on the next read — and anything held in memory meanwhile, a
     BOM being built, an open request, would quietly point at the wrong part.
     So each part number keeps the id it first got, for the whole session. */
  var PNID={}, nextPid=1;
  function stabilise(d){
    var remap={}, i, k;
    for(i=0;i<d.parts.length;i++){
      var p=d.parts[i]; k=String(p.pn).toUpperCase();
      if(!PNID[k]) PNID[k]=nextPid++;
      remap[p.id]=PNID[k]; p.id=PNID[k];
    }
    for(i=0;i<d.ledger.length;i++){ var l=d.ledger[i]; if(remap[l.p]!==undefined) l.p=remap[l.p]; }
    var R=d.reqs||[];
    for(i=0;i<R.length;i++) for(var j=0;j<R[i].lines.length;j++){
      var ln=R[i].lines[j]; ln.pid = ln.pn ? (PNID[String(ln.pn).toUpperCase()]||null) : null;
    }
    return d;
  }
  function put(ops){ return XLS.enqueue(ops); }
  function O(k,t,x){ return XLS.op(k,t,x); }

  var DEMO_PROC=[
    {no:"800011175",dept:"EDS",summary:"32 CHANNEL RELAY",svc:"MATERIAL",qty:1,raised:"2026-01-05",raisedBy:"",apprBy:"",apprDate:"",po:"",vendor:"",amt:0,stage:"PR RAISED",poDate:"",delivered:"",notes:""},
    {no:"800011158",dept:"EDS",summary:"GEAR COMPONENTS",svc:"MATERIAL",qty:1,raised:"2026-01-05",raisedBy:"",apprBy:"",apprDate:"",po:"",vendor:"",amt:0,stage:"PR RAISED",poDate:"",delivered:"",notes:""},
    {no:"800011128",dept:"EDS",summary:"AUTOMOTIVE TRAINING",svc:"SERVICE",qty:1,raised:"2026-01-05",raisedBy:"",apprBy:"",apprDate:"",po:"",vendor:"",amt:0,stage:"DELIVERED (CLOSED)",poDate:"",delivered:"",notes:""},
    {no:"800011096",dept:"EDS",summary:"WIRE WITH BOBBIN",svc:"MATERIAL",qty:1,raised:"2026-01-05",raisedBy:"",apprBy:"",apprDate:"",po:"",vendor:"",amt:0,stage:"PR RAISED",poDate:"",delivered:"",notes:""},
    {no:"800011192",dept:"EDS",summary:"CLOTH TAPE",svc:"MATERIAL",qty:1,raised:"2026-01-05",raisedBy:"",apprBy:"",apprDate:"",po:"",vendor:"",amt:0,stage:"PR RAISED",poDate:"",delivered:"",notes:""}
  ];
  var DEMO_LIC=[
    {name:"WinCC Professional",vendor:"Siemens",type:"Perpetual + SUS",seatsTotal:4,seatsUsed:4,expiry:"2026-06-09",cost:422000,notes:"Sample row — SAMPLE, verify against real renewal"},
    {name:"EPLAN Electric P8",vendor:"EPLAN Software",type:"Floating",seatsTotal:6,seatsUsed:4,expiry:"2027-07-10",cost:339000,notes:"Sample row — SAMPLE, verify against real renewal"},
    {name:"TIA Portal V18",vendor:"Siemens",type:"Perpetual + SUS",seatsTotal:12,seatsUsed:6,expiry:"2026-09-24",cost:236000,notes:"Sample row — SAMPLE, verify against real renewal"}
  ];
  function licStatus(exp){
    if(!exp) return "";
    var d=new Date(exp+"T00:00:00"), t=new Date(); t.setHours(0,0,0,0);
    var days=Math.round((d-t)/86400000);
    if(days<0) return "Expired";
    if(days<=45) return "Expiring Soon";
    return "Active";
  }

  /* ---- rows, exactly as each tab's columns are ordered ------------ */
  function procRow(p){
    return [p.no,p.dept,p.summary,p.svc,p.qty,p.raised,p.raisedBy,p.apprBy||"",p.apprDate||"",
            p.po||"",p.vendor||"",p.amt||0,p.stage,p.poDate||"",p.delivered||"",p.notes||"",
            p.prAmt||0,p.inv||"",p.poApprDate||"",p.own||"",p.poCopy||""];
  }
  function reqOps(r,user){
    var head=[r.no,r.kind||"",r.status,r.by,r.byName,r.on,r.machine,r.pcode,r.harness,
              r.stage,r.bu,r.cc,r.buc,r.dcc,Number(r.circ)||0,r.need,r.scope,
              r.parent||"",r.upd||new Date().toISOString(),user||"",
              /* the last sixty history lines ride in the row itself */
              JSON.stringify((r.log||[]).slice(-60))];
    var w={}; w[1]=r.no;
    var ops=[O("ups","req",{w:w,row:head})];
    for(var i=0;i<r.lines.length;i++){
      var l=r.lines[i], loc="";
      for(var k=0;k<mem.parts.length;k++) if(mem.parts[k].pn===l.pn){ loc=mem.parts[k].l||""; break; }
      var wl={}; wl[1]=r.no; wl[2]=l.n||(i+1);
      ops.push(O("ups","reqln",{w:wl,row:[r.no,l.n||(i+1),l.pn,l.d||"",Number(l.q)||0,
        Number(l.resv)||0,Number(l.rel)||0,l.u||"NO",l.st||"",Number(l.cost)||0,loc,l.rem||""]}));
    }
    return ops;
  }
  function patchOp(t,w,fields,COL,ci){
    var p={}, any=false;
    for(var f in fields) if(COL[f]){ p[COL[f]]=fields[f]; any=true; }
    return any ? O("upd",t,{w:w,p:p,ci:!!ci}) : null;
  }

  /* ---- bringing older portals' leftovers forward ------------------ */
  /* v5-v7 kept one queue file per tab, and v7 kept requests that could not
     reach Excel in a Requests sidecar. None of that may be lost when a desk
     moves to v8, so each is read once, turned into replay-safe operations
     and handed to the journal. */
  function adoptLegacy(fromExcel){
    var ops=[], f=null, d=XLS.pendDir(), i;
    try{ f=fso(); }catch(e){ return; }
    var LEG={
      "movements.jsonl":function(row){
        /* no EntryId in the old format: derive one from the row itself so a
           second adoption of the same file is recognised and skipped */
        var r=row.slice(0); while(r.length<8) r.push("");
        r[8]="LEG-"+SHA256.hex(JSON.stringify(row)).slice(0,20);
        return O("add","moves",{row:r,u:9});
      },
      "proc_new.jsonl":function(row){ var w={}; w[1]=row[0]; return O("ups","proc",{w:w,row:row}); },
      "newpart.jsonl": function(row){ var w={}; w[2]=row[1]; w[1]=row[0]; return O("ups","npart",{w:w,row:row}); },
      "invoice.jsonl": function(row){ var w={}; w[1]=row[0]; return O("ups","inv",{w:w,row:row}); },
      "purch.jsonl":   function(row){ var w={}; w[1]=row[0]; w[5]=row[4]; return O("ups","purch",{w:w,row:row}); },
      "licenses.jsonl":function(row){ var w={}; w[1]=row[0]; return O("ups","lic",{w:w,row:row}); }
    };
    try{
      /* a desk that crashed half-way through adopting leaves NAME.adopt-SID;
         give it five minutes, then treat it as the original file again */
      if(f.FolderExists(d)){
        var en0=new Enumerator(f.GetFolder(d).Files), stale=[];
        for(;!en0.atEnd();en0.moveNext()){
          var f0=en0.item(), m0=/^(.+\.jsonl)\.adopt-/.exec(String(f0.Name));
          if(m0 && LEG[m0[1]] && (+new Date()-f0.DateLastModified.valueOf())>300000) stale.push([String(f0.Path),d+"\\"+m0[1]]);
        }
        for(var z=0;z<stale.length;z++){ try{ if(!f.FileExists(stale[z][1])) f.MoveFile(stale[z][0],stale[z][1]); }catch(e){} }
      }
    }catch(e){}
    try{
      if(f.FolderExists(d)){
        for(var nm in LEG){
          var p=d+"\\"+nm; if(!f.FileExists(p)) continue;
          var mine=p+".adopt-"+XLS.sid();
          try{ f.MoveFile(p,mine); }catch(e){ continue; }      /* another desk got it first */
          var s=f.OpenTextFile(mine,1), t=s.ReadAll(); s.Close();
          var L=String(t).split(/\r?\n/);
          for(i=0;i<L.length;i++){
            if(L[i].length<3) continue;
            try{ var row=JSON.parse(L[i]); if(row && row.length) ops.push(LEG[nm](row)); }catch(x){}
          }
          adopted.push(mine);
        }
      }
    }catch(e){}
    /* v7 requests that never reached Excel, and history for those that did */
    try{
      var rd=XLS.reqDir(), have={}, logs={};
      for(i=0;i<fromExcel.length;i++) have[fromExcel[i].no]=fromExcel[i];
      if(f.FolderExists(rd)){
        var en=new Enumerator(f.GetFolder(rd).Files);
        for(;!en.atEnd();en.moveNext()){
          var fl=en.item(); if(String(fl.Name).slice(-6)!==".jsonl") continue;
          var s2=f.OpenTextFile(fl.Path,1), t2=s2.ReadAll(); s2.Close();
          var L2=String(t2).split(/\r?\n/), latest={};
          for(var j=0;j<L2.length;j++){
            if(L2[j].length<3) continue;
            try{ var rec=JSON.parse(L2[j]); if(rec && rec.no) latest[rec.no]=rec; }catch(x){}
          }
          for(var no in latest){
            var rec2=latest[no];
            if(have[no]){ if(!have[no].log.length && rec2.log) have[no].log=rec2.log; }
            else { if(!rec2.log) rec2.log=[]; if(!rec2.lines) rec2.lines=[]; ops=ops.concat(reqOps(rec2,rec2.by||"")); }
          }
        }
      }
    }catch(e){}
    if(ops.length) put(ops);
  }
  var adopted=[];
  function finishAdoption(){
    /* the adopted files are now safely in this portal's journal on disk */
    var f=null; try{ f=fso(); }catch(e){ return; }
    for(var i=0;i<adopted.length;i++){ try{ f.DeleteFile(adopted[i]); }catch(e){} }
    adopted=[];
  }

  function fromExcel(d){
    stabilise(d);
    return {parts:d.parts,users:d.users,ledger:d.ledger,reqs:d.reqs||[],settings:d.settings,
            proc:d.proc,lic:d.lic,npart:d.npart||[],invs:d.invs||[],purch:d.purch||[],calib:d.calib||[]};
  }

  return {
    live:live,
    init:function(seed){
      if(IS_HTA && XLS.locate()){
        var d=XLS.readAll();
        if(d && d.parts.length){
          liveOk=true;
          mem=fromExcel(d);
          var before=XLS.pendingOps().length;
          adoptLegacy(mem.reqs);
          /* adoption may have queued work the read above could not show yet */
          if(XLS.pendingOps().length!==before){
            XLS.commit();                    /* persists to the journal, then tries Excel */
            /* only let go of the old files once their contents are safely on
               disk in the journal — if even that failed, keep them for next time */
            if(XLS.status().queued===0) finishAdoption();
            var d2=XLS.readAll(); if(d2 && d2.parts.length) mem=fromExcel(d2);
          }
          XLS.kick();
          return mem;
        }
      }
      mem = IS_HTA ? null : lsGet("eds.db",null);
      if(!mem){ mem={parts:seed.parts,users:seed.users,ledger:seed.ledger.slice(0),reqs:[],settings:{},
                     proc:DEMO_PROC.slice(0),lic:DEMO_LIC.slice(0)}; }
      if(!mem.proc) mem.proc=DEMO_PROC.slice(0);
      if(!mem.lic) mem.lic=DEMO_LIC.slice(0);
      if(!mem.npart) mem.npart=[];
      if(!mem.invs)  mem.invs=[];
      if(!mem.purch) mem.purch=[];
      if(!mem.calib) mem.calib=[];
      for(var i=0;i<(mem.users||[]).length;i++) mem.users[i].r=canonRole(mem.users[i].rRaw||mem.users[i].r);
      if(!IS_HTA) lsSet("eds.db",mem);
      return mem;
    },
    reload:function(){
      if(!live()) return false;
      var d=XLS.readAll(); if(!d||!d.parts.length) return false;
      var n=fromExcel(d);
      for(var k in n) mem[k]=n[k];
      XLS.kick();
      return true;
    },
    licStatus:licStatus,

    /* Every method below changes memory first — so the screen can redraw at
       once — and then hands Excel a replay-safe operation. They all return
       true: a change is never refused because the workbook happens to be
       open; it waits in the journal instead, and the header says so. */
    pushTxn:function(t,user,part){
      mem.ledger.push(t);
      if(live()){
        var type = t.q>0 ? (t.t==="RECEIPT"?"RECEIPT":(t.t==="RETURN"?"RETURN":"ADJUST+"))
                         : (t.t==="RELEASE"?"ISSUE":(t.t==="SCRAP"?"SCRAP":"ADJUST-"));
        if(!t.key) t.key=uid("TXN");
        return put([O("add","moves",{row:[t.dt,part,type,Math.abs(t.q),t.si||"",t.c||0,user,t.r||"",t.key],u:9})]);
      }
      lsSet("eds.db",mem); return true;
    },
    pushProc:function(p){
      mem.proc.push(p);
      if(live()){ var w={}; w[1]=p.no; return put([O("ups","proc",{w:w,row:procRow(p)})]); }
      lsSet("eds.db",mem); return true;
    },
    advanceProc:function(no,patchFields){
      var p=null, i;
      for(i=0;i<mem.proc.length;i++) if(mem.proc[i].no===no) p=mem.proc[i];
      if(!p) return false;
      for(var k in patchFields) p[k]=patchFields[k];
      if(live()){
        var COL={dept:2,summary:3,svc:4,qty:5,raised:6,apprBy:8,apprDate:9,po:10,vendor:11,amt:12,
                 stage:13,poDate:14,delivered:15,notes:16,prAmt:17,inv:18,poApprDate:19,own:20,poCopy:21};
        var w={}; w[1]=no;
        var op=patchOp("proc",w,patchFields,COL,true);
        return op ? put([op]) : true;
      }
      lsSet("eds.db",mem); return true;
    },
    pushReq:function(r,user){
      var i, found=false;
      for(i=0;i<mem.reqs.length;i++) if(mem.reqs[i].no===r.no){ mem.reqs[i]=r; found=true; break; }
      if(!found) mem.reqs.push(r);
      if(typeof bust==="function") bust();
      if(live()) return put(reqOps(r,user));
      lsSet("eds.db",mem); return true;
    },
    pushNewPart:function(r){
      mem.npart.push(r);
      if(live()){
        var w={}; w[2]=r.no; w[1]=r.sr;
        return put([O("ups","npart",{w:w,row:[r.sr,r.no,r.by,r.cat,r.sub,r.plant,r.name,r.make,
          r.model,r.specs,r.rem,r.uom,r.hsn,r.status,r.on]})]);
      }
      lsSet("eds.db",mem); return true;
    },
    updateNewPart:function(no,sr,patchFields){
      for(var i=0;i<mem.npart.length;i++)
        if(mem.npart[i].no===no && mem.npart[i].sr===sr)
          for(var k in patchFields) mem.npart[i][k]=patchFields[k];
      if(live()){
        var COL={status:14,rem:11,hsn:13,uom:12,name:7,cat:4,sub:5,plant:6,make:8,model:9,specs:10};
        var w={}; w[2]=no; w[1]=sr;
        var op=patchOp("npart",w,patchFields,COL,false);
        return op ? put([op]) : true;
      }
      lsSet("eds.db",mem); return true;
    },
    pushInvoice:function(v){
      mem.invs.push(v);
      if(live()){
        var w={}; w[1]=v.no;
        return put([O("ups","inv",{w:w,row:[v.no,v.date,v.to,v.cc,v.from,v.ext,v.mob,v.harness,v.job,
          v.bu,v.buc,v.cost,v.app,v.details,v.circ,v.dcc,v.dcm,v.recd,v.start,v.done,v.mat,v.asm,
          v.trn,v.tot,v.ref,v.img,v.status,v.notes]})]);
      }
      lsSet("eds.db",mem); return true;
    },
    updateInvoice:function(no,patchFields){
      for(var i=0;i<mem.invs.length;i++)
        if(mem.invs[i].no===no) for(var k in patchFields) mem.invs[i][k]=patchFields[k];
      if(live()){
        var COL={date:2,to:3,cc:4,from:5,ext:6,mob:7,harness:8,job:9,bu:10,buc:11,cost:12,
                 app:13,details:14,circ:15,dcc:16,dcm:17,recd:18,start:19,done:20,
                 mat:21,asm:22,trn:23,tot:24,ref:25,img:26,status:27,notes:28};
        var w={}; w[1]=no;
        var op=patchOp("inv",w,patchFields,COL,false);
        return op ? put([op]) : true;
      }
      lsSet("eds.db",mem); return true;
    },
    pushPurch:function(p){
      mem.purch.push(p);
      if(live()){
        var w={}; w[1]=p.pn; w[5]=p.req;
        return put([O("ups","purch",{w:w,ci:true,row:[p.pn,p.d,p.need,p.conf,p.req,p.by,p.pr,
          p.supNo,p.sup,p.stage,p.on,p.eta,p.notes]})]);
      }
      lsSet("eds.db",mem); return true;
    },
    updatePurch:function(pn,req,patchFields){
      for(var i=0;i<mem.purch.length;i++)
        if(mem.purch[i].pn===pn && mem.purch[i].req===req)
          for(var k in patchFields) mem.purch[i][k]=patchFields[k];
      if(live()){
        var COL={need:3,conf:4,pr:7,supNo:8,sup:9,stage:10,eta:12,notes:13};
        var w={}; w[1]=pn; w[5]=req;
        var op=patchOp("purch",w,patchFields,COL,true);
        return op ? put([op]) : true;
      }
      lsSet("eds.db",mem); return true;
    },
    setLocation:function(pn,loc){
      for(var i=0;i<mem.parts.length;i++) if(mem.parts[i].pn===pn) mem.parts[i].l=loc;
      if(live()){
        /* part numbers are matched case- and space-insensitively, the same way
           the rest of the portal looks them up */
        var w={}, p={}; w[1]=pn; p[6]=loc;
        return put([O("upd","parts",{w:w,p:p,ci:true})]);
      }
      lsSet("eds.db",mem); return true;
    },
    setPassword:function(email,hash){
      for(var i=0;i<mem.users.length;i++)
        if(mem.users[i].e===email){ mem.users[i].pw=hash; mem.users[i].pwOn=hash?today():""; }
      if(live()){
        /* the Username cell may be typed in any case — match it that way */
        var w={}, p={}; w[1]=email; p[5]=hash; p[6]=hash?today():"";
        return put([O("upd","users",{w:w,p:p,ci:true})]);
      }
      lsSet("eds.db",mem); return true;
    },
    pushLicence:function(l){
      mem.lic.push(l);
      if(live()){
        var w={}; w[1]=l.name;
        return put([O("ups","lic",{w:w,ci:true,row:[l.name,l.vendor,l.type,l.seatsTotal,l.seatsUsed,
          l.expiry,l.cost,licStatus(l.expiry),l.notes]})]);
      }
      lsSet("eds.db",mem); return true;
    },
    updateLicence:function(name,l){
      for(var i=0;i<mem.lic.length;i++) if(mem.lic[i].name===name){ for(var k in l) mem.lic[i][k]=l[k]; }
      if(live()){
        var w={}, p={}; w[1]=name;
        p[2]=l.vendor; p[3]=l.type; p[4]=l.seatsTotal; p[5]=l.seatsUsed;
        p[6]=l.expiry; p[7]=l.cost; p[8]=licStatus(l.expiry); p[9]=l.notes;
        return put([O("upd","lic",{w:w,p:p,ci:true})]);
      }
      lsSet("eds.db",mem); return true;
    },
    saveParts:function(){ if(!live()) lsSet("eds.db",mem); },
    reset:function(){ try{ localStorage.removeItem("eds.db"); }catch(e){} location.reload(); },
    /* the workbook was found but could not be read (network drive not up yet,
       Excel busy starting): try again quietly; true once it reads */
    canRetryLive:function(){ return IS_HTA && !!XLS.path() && !liveOk; },
    retryLive:function(){
      if(!(IS_HTA && XLS.path()) || liveOk) return false;
      var d=XLS.readAll();
      return !!(d && d.parts && d.parts.length);
    }
  };
})();


/* ---------- STATE ------------------------------------------------ */
var DB=null, ME=null, VIEW="dash", SEL=null, BOM=[], _bal=null;

/* ---------- HELPERS ---------------------------------------------- */
function $(s,r){ return (r||document).querySelector(s); }
function $$(s,r){ return [].slice.call((r||document).querySelectorAll(s)); }
function esc(s){ return String(s==null?"":s).replace(/[&<>"']/g,function(c){
  return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]; }); }
function num(n,d){ n=Number(n)||0; return n.toLocaleString("en-IN",{minimumFractionDigits:d||0,maximumFractionDigits:d||0}); }
function inr(n){ return "₹"+ (Number(n)||0).toLocaleString("en-IN",{minimumFractionDigits:2,maximumFractionDigits:2}); }
function inrShort(n){
  n=Number(n)||0;
  if(n>=10000000) return "\u20B9"+(n/10000000).toFixed(2)+" Cr";
  if(n>=100000)   return "\u20B9"+(n/100000).toFixed(2)+" L";
  return "\u20B9"+Math.round(n).toLocaleString("en-IN");
}
function today(){ var d=new Date(); return d.toISOString().slice(0,10); }
function initials(n){ return String(n||"?").split(/\s+/).map(function(w){return w[0];}).slice(0,2).join("").toUpperCase(); }
function uid(p){ return p+"-"+Date.now().toString(36).toUpperCase()+"-"+Math.floor(Math.random()*1296).toString(36).toUpperCase(); }
function toast(msg,title,bad){
  var d=document.createElement("div"); d.className="tst"+(bad?" e":"");
  d.innerHTML="<b>"+esc(title||(bad?"Not done":"Done"))+"</b>"+esc(msg);
  $("#toast").appendChild(d);
  setTimeout(function(){ d.style.opacity="0"; d.style.transition="opacity .4s";
    setTimeout(function(){ if(d.parentNode) d.parentNode.removeChild(d); },420); }, bad?7000:3600);
}
function modal(title,body,footer){
  $("#modal").innerHTML='<div class="mw"><h3>'+esc(title)+'</h3><div class="mb">'+body+'</div><div class="mf">'+footer+'</div></div>';
  $("#modal").className="on";
}
function closeModal(){ $("#modal").className=""; $("#modal").innerHTML=""; }

/* ---------- DERIVED STOCK ---------------------------------------- */
function balances(){
  if(_bal) return _bal;
  var on={}, res={}, i, l;
  for(i=0;i<DB.ledger.length;i++){ l=DB.ledger[i]; on[l.p]=(on[l.p]||0)+Number(l.q); }
  var R=reqIndex();
  for(var k in R){ var r=R[k];
    if(r.status==="RESERVED"||r.status==="READY FOR RELEASE"||r.status==="PARTIALLY RELEASED"||r.status==="PURCHASE REQUIRED"){
      for(i=0;i<r.lines.length;i++){ var ln=r.lines[i];
        var pend=(ln.resv||0)-(ln.rel||0); if(pend>0) res[ln.pid]=(res[ln.pid]||0)+pend; }
    }
  }
  _bal={};
  for(i=0;i<DB.parts.length;i++){
    var p=DB.parts[i], o=Math.round((on[p.id]||0)*1000)/1000, rv=res[p.id]||0;
    _bal[p.id]={on:o,res:rv,av:Math.round((o-rv)*1000)/1000,st:stat(p,o,o-rv)};
  }
  return _bal;
}
function setting(k,d){ var v=DB.settings&&DB.settings[k]; return (v===undefined||v===null||v==="")?d:v; }
function stat(p,on,av){
  if(on<=0) return "OUT OF STOCK";
  var pct = p.s==="Connector" ? Number(setting("LowStockPct_Connector",25))
          : p.s==="Terminal"  ? Number(setting("LowStockPct_Terminal",20))
          : Number(setting("LowStockPct_Default",20));
  if(p.ref>0 && on <= p.ref*pct/100) return "LOW STOCK";
  if(av<=0) return "FULLY RESERVED";
  return "IN STOCK";
}
/* Caches. Balances, the request index and the part index are all derived
   data; bust() throws them away whenever the underlying rows change. The
   request index used to be rebuilt from scratch on every call — and the stock
   ledger called it once per row it drew. */
var _ridx=null, _ridxSrc=null, _ridxN=-1, _pidx=null, _pidxSrc=null, _pnidx=null;
function bust(){ _bal=null; _ridx=null; _pidx=null; _pnidx=null; }
function bal(pid){ return balances()[pid]||{on:0,res:0,av:0,st:"OUT OF STOCK"}; }
function partById(pid){
  if(!_pidx || _pidxSrc!==DB.parts){
    _pidx={}; _pidxSrc=DB.parts;
    for(var i=0;i<DB.parts.length;i++) _pidx[DB.parts[i].id]=DB.parts[i];
  }
  return _pidx[pid]||null;
}
function partBy(pn){
  pn=String(pn||"").replace(/^\s+|\s+$/g,"").toUpperCase();
  for(var i=0;i<DB.parts.length;i++) if(String(DB.parts[i].pn).toUpperCase()===pn) return DB.parts[i];
  return null;
}
function reqIndex(){
  /* rebuilt if the array itself was replaced (a reload) or grew/shrank, even
     if nobody remembered to call bust() — a stale index here would make a
     request look missing, which is worse than rebuilding once too often */
  if(!_ridx || _ridxSrc!==DB.reqs || _ridxN!==DB.reqs.length){
    var m={}; for(var i=0;i<DB.reqs.length;i++) m[DB.reqs[i].no]=DB.reqs[i];
    _ridx=m; _ridxSrc=DB.reqs; _ridxN=DB.reqs.length;
  }
  return _ridx;
}
function reqList(){
  var m=reqIndex(), out=[]; for(var k in m) out.push(m[k]);
  out.sort(function(a,b){ return (b.on||"").localeCompare(a.on||""); });
  return out;
}
function saveReq(r){ r.upd=new Date().toISOString(); Store.pushReq(r,ME.e); bust(); }

/* ---------- STOCK ENGINE — the only way stock ever moves --------- */
function move(pid,qty,type,srcType,srcId,reason,unitCost){
  var b=bal(pid), p=partById(pid);
  if(!p) return {ok:false,msg:"Part not found."};
  if(qty===0) return {ok:false,msg:"Quantity cannot be zero."};
  if(qty<0 && b.on + qty < -0.0001)
    return {ok:false,msg:"Only "+num(b.on,3)+" "+p.u+" of "+p.pn+" is physically in store. Cannot issue "+num(-qty,3)+"."};
  if((type==="ADJUST"||type==="SCRAP") && !reason)
    return {ok:false,msg:"A reason is required for an adjustment or scrap."};
  var t={id:DB.ledger.length+1,key:uid("TXN"),p:pid,t:type,q:Number(qty),
         dt:today(),by:ME.e,st:srcType||"",si:srcId||"",c:Number(unitCost||p.cost||0),
         r:reason||"",bb:b.on,ba:Math.round((b.on+qty)*1000)/1000};
  Store.pushTxn(t,ME.e,p.pn); bust();
  return {ok:true,txn:t,bal:t.ba};
}

/* ---------- NAVIGATION ------------------------------------------- */
var NAV={
 "Engineer":[["Overview",[["dash","Dashboard"]]],
             ["Material",[["stock","Check Stock"],["bom","BOM Compare"],["newreq","NEW REQUEST"],
                          ["myreq","My Requests"],["newpart","Brand New Purchase Part"]]]],
 "Lab Admin":[["Overview",[["dash","Dashboard"]]],
             ["Requests",[["queue","Request Queue"],["newpartq","New Purchase Parts"]]],
             ["Inventory",[["inventory","Component Inventory"],["inward","Material Inward"],
                           ["ledger","Stock Transactions"],["demand","High Demand Parts"]]],
             ["Deliveries",[["invoice","Create Invoice"],["invlist","Invoices"],["cost","Cost Sheet"]]],
             ["Purchasing",[["proc","Procurement (PR/PO)"],["purch","Ongoing Purchase"],
                            ["lic","Software Licenses"]]],
             ["Tools",[["stock","Check Stock"],["bom","BOM Compare"],["team","Team access"]]]],
 "Manager":[["Overview",[["dash","Dashboard"]]],
             ["Reports",[["queue","All Requests"],["invlist","Invoices"],["proc","Procurement (PR/PO)"],
                         ["purch","Ongoing Purchase"],["demand","High Demand Parts"],
                         ["lic","Software Licenses"],["inventory","Inventory"]]]]
};
NAV["Lab Lead"]=NAV["Lab Admin"];
function isAdmin(){ return ME && (ME.r==="Lab Admin"||ME.r==="Lab Lead"); }
function isMgr(){ return ME && ME.r==="Manager"; }

/* ---------- LOGIN ------------------------------------------------ */
/* Everyone in the Users tab can sign in — this is a whole-roster picker
   (with search), not a fixed 4-person demo list. The 4-person shortcut used
   to be the ENTIRE login screen, which meant nobody outside those 4 exact
   e-mails could ever sign in once real Users data replaced the demo seed —
   a real gap, not a stylistic choice. Login itself is a no-password "which
   of these am I" pick, matching the file being already inside a
   permissioned company drive. */
/* ------------------------------------------------------------------
   SIGN IN — three doors, not a staff directory.

   Listing 97 names on the front door is not how a company portal opens,
   and it gets worse as the lab grows. Instead the portal asks which of
   the three jobs you are here to do, then works out WHO you are from the
   Windows account you are already logged in with, matched against the
   Users tab of the Excel. Nobody types a password, because the file
   already sits inside a permissioned company folder — if you can open
   it, you are staff.

   Only when the Windows account can't be matched (a shared machine, or
   the Username column not filled in yet) does it fall back to asking you
   to find yourself in a list — and even then, only among people who hold
   the role you picked, never the whole company.
------------------------------------------------------------------- */
var ROLE_DOORS = [
  { k:"eng", t:"Engineer", roles:["Engineer"],
    d:"Check what is in stock, paste a harness BOM, and raise a material request. See where your own requests stand.",
    ic:'<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#f2b01e" stroke-width="1.8"><path d="M3 7h18M3 12h12M3 17h7"/><circle cx="19" cy="16" r="3"/></svg>' },
  { k:"admin", t:"Lab Admin", roles:["Lab Admin","Lab Lead"],
    d:"Everything: material inward and outward, reserve and issue, approve requests, raise PR/PO, licences and reports.",
    ic:'<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#f2b01e" stroke-width="1.8"><path d="M3 8l9-5 9 5-9 5-9-5z"/><path d="M3 12l9 5 9-5M3 16l9 5 9-5"/></svg>' },
  { k:"mgr", t:"Manager", roles:["Manager"],
    d:"A read-only view of stock health, spend, PR/PO progress and where every request has reached. Nothing can be changed.",
    ic:'<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#f2b01e" stroke-width="1.8"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></svg>' }
];

function usersForDoor(door){
  var out=[];
  for(var i=0;i<DB.users.length;i++){
    /* canonRole() has already folded "admin", "Lab admin", "Store"... into
       one of four names as the workbook was read; fold again here in case a
       row reached memory some other way */
    var r=canonRole(DB.users[i].r);
    for(var j=0;j<door.roles.length;j++){
      if(r===door.roles[j]){ out.push(DB.users[i]); break; }
    }
  }
  out.sort(function(a,b){ return String(a.n).localeCompare(String(b.n)); });
  return out;
}

/* Match the signed-in Windows account against a Users row. Tries the
   Username column first, then the part of the e-mail before the @, then
   the person's name with dots/spaces removed. */
function matchWinUser(list){
  var w=(winUser()||"").toLowerCase();
  if(!w) return null;
  var wSquash=w.replace(/[^a-z0-9]/g,"");
  for(var i=0;i<list.length;i++){
    var u=list[i];
    if(u.u && String(u.u).toLowerCase()===w) return u;
    var local=String(u.e||"").split("@")[0].toLowerCase();
    if(local && local===w) return u;
    if(local && local.replace(/[^a-z0-9]/g,"")===wSquash) return u;
    if(String(u.n||"").toLowerCase().replace(/[^a-z0-9]/g,"")===wSquash) return u;
  }
  return null;
}

function rememberMe(email){ try{ localStorage.setItem("edslab_me", email); }catch(e){} }
function rememberedIn(list){
  var e=null; try{ e=localStorage.getItem("edslab_me"); }catch(err){}
  if(!e) return null;
  for(var i=0;i<list.length;i++) if(list[i].e===e) return list[i];
  return null;
}

function renderLogin(){
  var b=balances(), low=0;
  for(var k in b){ if(b[k].st==="LOW STOCK"||b[k].st==="OUT OF STOCK") low++; }
  $("#login .stats").innerHTML =
    '<div><b>'+num(DB.parts.length)+'</b><span>Components</span></div>'+
    '<div><b>'+num(DB.ledger.length)+'</b><span>Transactions</span></div>'+
    '<div><b>'+num(DB.users.length)+'</b><span>Users</span></div>'+
    '<div><b>'+num(low)+'</b><span>Need attention</span></div>';

  showRoles();
  $("#modeline").innerHTML = Store.live()
    ? "Live. Reading <b>"+esc(XL_NAME)+"</b> from the shared folder. When the store saves that file, every open portal updates itself within seconds."
    : (IS_HTA
       ? "<b>"+esc(XLS.err()||("Could not find "+XL_NAME))+"</b><br>Running on sample data for now. Put "+esc(XL_NAME)+" in the same folder as this portal and reopen."
       : "Demo mode &mdash; data is kept in this browser only, so you can click anything without touching real records.");
}

function showRoles(){
  $("#picklbl").innerHTML="Open the portal as";
  $("#roles").style.display="block";
  $("#who").style.display="none";
  var h="";
  for(var i=0;i<ROLE_DOORS.length;i++){
    var d=ROLE_DOORS[i], n=usersForDoor(d).length;
    h+='<button class="role" data-k="'+d.k+'">'+
         '<span class="ic">'+d.ic+'</span>'+
         '<span class="go">&rsaquo;</span>'+
         '<span class="rt"><b>'+esc(d.t)+'</b><small>'+esc(d.d)+'</small>'+
           '<small class="cnt">'+num(n)+' '+(n===1?"person":"people")+' in the Users tab</small></span>'+
       '</button>';
  }
  $("#roles").innerHTML=h;
  var btns=$$("#roles button");
  for(var j=0;j<btns.length;j++){
    (function(btn){
      btn.onclick=function(){ openDoor(btn.getAttribute("data-k")); };
    })(btns[j]);
  }
}

function openDoor(key){
  var door=null;
  for(var i=0;i<ROLE_DOORS.length;i++) if(ROLE_DOORS[i].k===key) door=ROLE_DOORS[i];
  if(!door) return;
  var list=usersForDoor(door);
  if(!list.length){
    toast("No one holds that role yet","Add a person with the role \""+door.roles[0]+"\" in the Users tab of "+XL_NAME+".",true);
    return;
  }
  /* Windows tells us who is probably at this desk, and the portal remembers
     the last person to sign in here — but neither is proof. Both now only
     pre-select the person; the password is what actually signs them in.
     Before v7 this branch let anyone through as whoever matched. */
  /* Only a role held by ONE person skips the list. As soon as there are two
     admins, clicking Admin must show both names — v7 jumped straight to the
     password of whoever last signed in on this desk (or whoever Windows
     matched), so the second admin could never pick themselves. Windows and
     the memory of the last sign-in now only move that name to the top. */
  if(list.length===1){ askPassword(list[0], door); return; }
  var me = matchWinUser(list) || rememberedIn(list);
  showWho(door, list, me);
}

var _door=null, _doorList=null, _doorMe=null;
function showWho(door, list, me){
  _door=door; _doorList=list; _doorMe=me||null;
  if(me){
    /* the likely person first, everyone else in roster order after */
    var rest=[]; for(var r=0;r<list.length;r++) if(list[r].e!==me.e) rest.push(list[r]);
    list=[me].concat(rest);
  }
  $("#picklbl").innerHTML="Which "+esc(door.t)+" are you?";
  $("#roles").style.display="none";
  $("#who").style.display="block";
  var big=list.length>12;
  var q=$("#loginq");
  if(q && q.parentNode) q.parentNode.removeChild(q);   /* not q.remove() — IE has no DOM4 remove() */
  if(big){
    var wrap=document.createElement("div");
    wrap.innerHTML='<input type="text" id="loginq" placeholder="Type your name &mdash; '+num(list.length)+' '+esc(door.t.toLowerCase())+'s on the roster">';
    $("#who").insertBefore(wrap.firstChild, $("#pick"));
    $("#loginq").onkeyup=function(){
      var s=this.value.replace(/^\s+|\s+$/g,"").toUpperCase(), f=[];
      for(var i=0;i<list.length && f.length<40;i++){
        var u=list[i];
        if(!s || (u.n+" "+u.e+" "+(u.b||"")).toUpperCase().indexOf(s)>=0) f.push(u);
      }
      renderLoginList(f);
    };
  }
  renderLoginList(list.slice(0,12));
}

function renderLoginList(list){
  var h="";
  for(var i=0;i<list.length;i++){ var u=list[i];
    var tag = (_doorMe && u.e===_doorMe.e)
      ? '<em class="here">'+(matchWinUser([u])?"This Windows login":"Last signed in here")+'</em>' : '';
    h+='<button data-e="'+esc(u.e)+'"'+(tag?' class="likely"':'')+'><span class="av">'+esc(initials(u.n))+'</span>'+
       '<span class="go">&rsaquo;</span>'+
       '<span class="pt"><b>'+esc(u.n)+'</b><small>'+esc(u.r)+(u.b?" &middot; "+esc(u.b):"")+'</small>'+tag+'</span></button>';
  }
  if(!list.length) h='<div class="empty" style="padding:18px"><b>No match</b>Try a different name, or check the Users tab.</div>';
  $("#pick").innerHTML=h;
  $$("#pick button").forEach(function(btn){
    btn.onclick=function(){
      for(var j=0;j<DB.users.length;j++) if(DB.users[j].e===btn.getAttribute("data-e")){
        askPassword(DB.users[j]);
      }
    };
  });
}
/* ---------- PASSWORD -------------------------------------------------
   One person, one password. Until v7 the sign-in screen was a "which of
   these am I" pick, which meant anyone could open the portal as anyone —
   raise a request in someone else's name, or release stock as the store.
   The first time a person signs in they choose their own password; the
   workbook only ever stores the salted hash. */
function askPassword(u, door){
  var first = !u.pw;
  var others = _doorList && _doorList.length>1;
  var h='<div class="pwwho"><span class="av">'+esc(initials(u.n))+'</span>'+
        '<div><b>'+esc(u.n)+'</b><small>'+esc(u.r)+(u.b?" &middot; "+esc(u.b):"")+'</small></div></div>';
  if(first){
    h+='<p class="muted" style="font-size:13px;margin:0 0 14px">This is your first sign-in. '+
       'Choose a password &mdash; you will need it every time, and nobody else can open the portal as you.</p>'+
       '<div class="fg"><label>New password</label><input type="password" id="pw1" autocomplete="new-password"></div>'+
       '<div class="fg"><label>Type it again</label><input type="password" id="pw2" autocomplete="new-password"></div>'+
       '<span class="guide">At least 6 characters, with a letter and a number.</span>';
  } else {
    h+='<div class="fg"><label>Password</label><input type="password" id="pw1" autocomplete="current-password"></div>'+
       '<span class="guide">Forgotten it? The lab admin can reset it for you under Team access.</span>';
  }
  h+='<div id="pwerr" class="pwerr"></div>';
  modal(first?"Set your password":"Sign in",h,
    (others?'<button class="btn sec" id="pwother" style="float:left">Not '+esc(String(u.n).split(" ")[0])+'? Choose another name</button>':'')+
    '<button class="btn sec" id="pwcancel">Cancel</button>'+
    '<button class="btn" id="pwgo">'+(first?"Save and sign in":"Sign in")+'</button>');
  $("#pwcancel").onclick=function(){ closeModal(); };
  if($("#pwother")) $("#pwother").onclick=function(){
    closeModal();
    /* forget the guess, so the list no longer puts this person on top */
    try{ localStorage.removeItem("edslab_me"); }catch(e){}
    showWho(_door,_doorList,null);
  };
  function fail(m){ $("#pwerr").innerHTML=esc(m); $("#pwerr").style.display="block";
                    $("#pw1").value=""; if($("#pw2")) $("#pw2").value=""; $("#pw1").focus(); }
  function go(){
    var p1=$("#pw1").value;
    if(first){
      var bad=pwProblem(p1);
      if(bad){ fail(bad); return; }
      if(p1!==$("#pw2").value){ fail("The two passwords do not match."); return; }
      var hash=pwHash(u.e,p1);
      if(!Store.setPassword(u.e,hash)){
        fail("The workbook is open somewhere, so the password could not be saved. Close it and try again.");
        return;
      }
      u.pw=hash;
      closeModal(); rememberMe(u.e); boot(u);
      toast("Password set. You will need it next time you open the portal.","Welcome, "+u.n);
      return;
    }
    if(!pwVerify(u.e,p1,u.pw)){ fail("That password is not right."); return; }
    closeModal(); rememberMe(u.e); boot(u);
  }
  $("#pwgo").onclick=go;
  $("#pw1").onkeydown=function(e){ var k=(e||window.event).keyCode; if(k===13){ if(first&&$("#pw2")) $("#pw2").focus(); else go(); } };
  if($("#pw2")) $("#pw2").onkeydown=function(e){ if(((e||window.event).keyCode)===13) go(); };
  try{ $("#pw1").focus(); }catch(e){}
}

/* ---------- TEAM ACCESS (admin) -------------------------------------- */
function vTeam(){
  var L=DB.users.slice(0), i, set=0;
  for(i=0;i<L.length;i++) if(L[i].pw) set++;
  var h=head("Team access",
    "Everyone in the Users tab of the workbook. Add or remove people there; reset a forgotten password here.");
  h+='<div class="tiles">'+
     tile("b","People",L.length,"in the Users tab")+
     tile("g","Password set",set,"have signed in at least once")+
     tile(L.length-set?"w":"","Never signed in",L.length-set,"will choose a password on first use")+
     '</div>';
  h+='<div class="bar"><input type="text" id="tm_q" placeholder="Search name, username or business unit">'+
     '<select id="tm_r"><option value="">Any role</option><option>Engineer</option>'+
     '<option>Lab Admin</option><option>Lab Lead</option><option>Manager</option></select></div>'+
     '<div class="card"><div id="tm_out"></div></div>';
  return h;
}
vTeam.after=function(){
  function run(){
    var q=$("#tm_q").value.replace(/^\s+|\s+$/g,"").toUpperCase(), r=$("#tm_r").value;
    var L=DB.users.filter(function(u){
      if(r && u.r!==r) return false;
      if(!q) return true;
      return (u.n+" "+u.e+" "+(u.b||"")).toUpperCase().indexOf(q)>=0;
    });
    if(!L.length){ $("#tm_out").innerHTML='<div class="empty"><b>No match</b>Try a different search.</div>'; return; }
    var h='<div class="tw"><table class="flt"><thead><tr><th>Name</th><th>Username</th><th>Role</th>'+
      '<th>Business unit</th><th>Password</th><th class="mono">Set on</th><th></th></tr></thead><tbody>';
    for(var i=0;i<L.length;i++){ var u=L[i];
      h+='<tr><td>'+esc(u.n)+'</td><td class="mono">'+esc(u.e)+'</td><td>'+esc(u.r)+'</td>'+
         '<td>'+esc(u.b||"—")+'</td>'+
         '<td>'+(u.pw?'<span class="pill k-ok">SET</span>':'<span class="pill k-w">NOT SET</span>')+'</td>'+
         '<td class="mono muted">'+esc(u.pwOn?fmtDate(u.pwOn):"—")+'</td>'+
         '<td class="num">'+(u.pw?'<button class="btn sec sm" data-pwreset="'+esc(u.e)+'">Reset</button>':'<span class="muted">—</span>')+'</td></tr>';
    }
    $("#tm_out").innerHTML=h+'</tbody></table></div>';
    $$("#tm_out [data-pwreset]").forEach(function(b){
      b.onclick=function(){ resetPw(b.getAttribute("data-pwreset")); };
    });
  }
  $("#tm_q").oninput=run; $("#tm_r").onchange=run; run();
};
function resetPw(email){
  var u=null, i;
  for(i=0;i<DB.users.length;i++) if(DB.users[i].e===email) u=DB.users[i];
  if(!u) return;
  modal("Reset password for "+u.n,
    '<p>This clears '+esc(u.n)+'\u2019s password. The next time they open the portal they choose a new one.</p>'+
    '<p class="muted" style="font-size:12.5px">You are not shown their old password &mdash; the workbook only ever holds a hash of it, never the password itself.</p>',
    '<button class="btn sec" onclick="closeModal()">Cancel</button>'+
    '<button class="btn dg" id="rp_go">Reset it</button>');
  $("#rp_go").onclick=function(){
    if(!Store.setPassword(u.e,"")){
      toast("The workbook is open somewhere, so the reset could not be saved. Close it and try again.","Could not reset",true);
      return;
    }
    u.pw=""; u.pwOn="";
    closeModal(); toast(u.n+" will choose a new password at their next sign-in.","Password reset"); render();
  };
}

function boot(u){
  ME=u; VIEW="dash";
  $("#login").style.display="none";
  $("#shell").classList.add("on");
  $("#whoName").textContent=u.n;
  $("#whoRole").textContent=u.r;
  $("#whoAv").textContent=initials(u.n);
  renderNav(); render();
}
/* display:block, not grid — the login screen is absolutely positioned now,
   and IE would reject an unknown display value outright. */
function logout(){ ME=null; $("#shell").classList.remove("on"); $("#login").style.display="block"; renderLogin(); }

function renderNav(){
  var groups=NAV[ME.r]||NAV["Engineer"], h="", counts=navCounts();
  for(var g=0;g<groups.length;g++){
    h+='<div class="grp">'+esc(groups[g][0])+'</div>';
    var items=groups[g][1];
    for(var i=0;i<items.length;i++){
      var c=counts[items[i][0]];
      h+='<a data-v="'+items[i][0]+'" class="'+(VIEW===items[i][0]?"on":"")+'">'+esc(items[i][1])+
         (c?'<span class="cnt">'+c+'</span>':'')+'</a>';
    }
  }
  $("#nav").innerHTML=h;
  $$("#nav a").forEach(function(a){ a.onclick=function(){ VIEW=a.getAttribute("data-v"); SEL=null; renderNav(); render(); }; });
}
function navCounts(){
  var c={}, L=reqList(), mine=0, open=0;
  for(var i=0;i<L.length;i++){
    if(L[i].by===ME.e && L[i].status!=="COMPLETED"&&L[i].status!=="CANCELLED") mine++;
    if(L[i].status==="SUBMITTED"||L[i].status==="ADMIN REVIEW") open++;
  }
  if(mine) c.myreq=mine;
  if(open && (isAdmin()||isMgr())) c.queue=open;
  if(isAdmin()){
    var np=0, NP=DB.npart||[];
    for(i=0;i<NP.length;i++) if(NP[i].status==="SUBMITTED") np++;
    if(np) c.newpartq=np;
    var sh=shortageBook().length;
    if(sh) c.purch=sh;
  }
  return c;
}

/* Which screens a role is actually allowed to open. The nav already only
   shows the right links, but the router would happily render any screen for
   anyone if VIEW were set another way. With passwords now guarding who you
   are, it would be odd to leave what you can reach ungoverned. */
function allowedViews(){
  var groups=NAV[ME.r]||NAV["Engineer"], ok={}, g, i;
  for(g=0;g<groups.length;g++){
    var items=groups[g][1];
    for(i=0;i<items.length;i++) ok[items[i][0]]=1;
  }
  ok.dash=1;
  ok.jobcard=1;                 /* reached from a request, not from the nav */
  return ok;
}
function canView(v){ return !!allowedViews()[v]; }

/* ---------- ROUTER ----------------------------------------------- */
function render(){
  var m=$("#main");
  m.scrollTop=0;
  if(ME && !canView(VIEW)) VIEW="dash";
  var f={dash:vDash,stock:vStock,bom:vBom,newreq:vNewReq,myreq:vMyReq,
         queue:vQueue,inventory:vInventory,inward:vInward,ledger:vLedger,proc:vProc,
         lic:vLicenses,jobcard:vJobCard,
         /* v6 */
         newpart:vNewPart,newpartq:vNewPartQ,demand:vDemand,purch:vPurch,
         cost:vCost,invoice:vInvoice,invlist:vInvList,
         /* v7 */
         team:vTeam}[VIEW];
  m.innerHTML = f ? f() : "";
  if(f && f.after) f.after();
  wire();
}
function head(t,s,right){
  return '<div class="ph"><h2>'+esc(t)+'</h2><p>'+esc(s||"")+'</p><span class="sp"></span>'+(right||"")+'</div>';
}
function kpill(st){
  var m={"IN STOCK":"k-ok","LOW STOCK":"k-w","OUT OF STOCK":"k-r","FULLY RESERVED":"k-b",
    "AVAILABLE":"k-ok","SHORTAGE":"k-r","NEW PART":"k-b","PARTIAL":"k-w",
    "DRAFT":"k-m","SUBMITTED":"k-b","ADMIN REVIEW":"k-w","RESERVED":"k-a",
    "READY FOR RELEASE":"k-ok","PARTIALLY RELEASED":"k-w","RELEASED":"k-ok",
    "COMPLETED":"k-m","CANCELLED":"k-r","REJECTED":"k-r","PURCHASE REQUIRED":"k-r",
    "PR RAISED":"k-b","APPROVED":"k-a","PO RAISED":"k-a","GRN IN PROGRESS":"k-w",
    "DELIVERED (CLOSED)":"k-ok","EXPIRED":"k-r","EXPIRING SOON":"k-w","ACTIVE":"k-ok"};
  return '<span class="pill '+(m[st]||"k-m")+'">'+esc(st)+'</span>';
}
function meter(on,ref){
  var pc=ref>0?Math.max(0,Math.min(100,on/ref*100)):(on>0?100:0);
  var col=pc<=20?"#dc7361":(pc<=40?"#d99b3c":"#4fae7d");
  return '<span class="meter"><i style="width:'+pc.toFixed(0)+'%;background:'+col+'"></i></span>';
}

/* ---------- DASHBOARD -------------------------------------------- */
function vDash(){
  /* The manager asked for a quite different first screen — revenue, deliveries,
     PR/PO status and project counts rather than day-to-day stock — so that
     role gets its own dashboard instead of extra tiles bolted onto this one. */
  if(isMgr()) return vMgrDash();
  var b=balances(), L=reqList(), i, k;
  var tot=0,low=0,out=0,resv=0,val=0;
  for(i=0;i<DB.parts.length;i++){ var p=DB.parts[i], x=b[p.id];
    tot++; if(x.st==="LOW STOCK")low++; if(x.st==="OUT OF STOCK")out++;
    if(x.res>0)resv++; val+=x.on*(p.cost||0); }
  var sub=0,rev=0,rdy=0,shrt=0,mine=0;
  for(i=0;i<L.length;i++){ var r=L[i];
    if(r.status==="SUBMITTED")sub++;
    if(r.status==="ADMIN REVIEW")rev++;
    if(r.status==="READY FOR RELEASE"||r.status==="RESERVED")rdy++;
    if(r.status==="PURCHASE REQUIRED")shrt++;
    if(r.by===ME.e)mine++; }

  var proc=DB.proc||[], prOpen=0, poOpen=0;
  for(i=0;i<proc.length;i++){
    var st=proc[i].stage;
    if(st==="PR RAISED"||st==="APPROVED") prOpen++;
    else if(st==="PO RAISED"||st==="GRN IN PROGRESS") poOpen++;
  }
  var lic=DB.lic||[], licAttn=0;
  for(i=0;i<lic.length;i++){ var s=Store.licStatus(lic[i].expiry); if(s==="Expired"||s==="Expiring Soon") licAttn++; }

  var h=head("Dashboard", ME.r+" view · "+fmtDate(today()));
  if(isAdmin()||isMgr()){
    h+='<div class="tiles">'+
      tile("a","Open requests",sub+rev,(sub+rev)?"waiting for the store":"nothing waiting")+
      tile(rdy?"g":"","Ready to release",rdy,"stock held, awaiting collection")+
      tile(shrt?"r":"","Purchase required",shrt,"shortages needing a PR")+
      tile(out?"r":"","Out of stock",out,"of "+num(tot)+" components")+
      tile(low?"w":"","Low stock",low,"below reorder threshold")+
      (isMgr()||ME.r==="Lab Lead" ? tile("b","Stock value",inrShort(val),"at last purchase price") : "")+
    '</div><div class="tiles">'+
      tile(prOpen?"w":"","PRs in progress",prOpen,"raised, awaiting approval")+
      tile(poOpen?"a":"","POs in progress",poOpen,"ordered, awaiting GRN / delivery")+
      tile(licAttn?"r":"","Licences need attention",licAttn,"expiring or expired")+
    '</div>';
  } else {
    h+='<div class="tiles">'+
      tile("a","My open requests",mine,"raised by you")+
      tile("","Components",num(tot),"in the lab catalogue")+
      tile(low?"w":"","Low stock",low,"check before you plan a build")+
      tile(out?"r":"","Out of stock",out,"will need purchasing")+
    '</div>';
  }

  /* attention list */
  h+='<div class="card"><h3>'+(isAdmin()?"Needs your action":"Your requests")+'<span class="sp"></span>'+
     '<button class="btn sec sm" data-go="'+(isAdmin()?"queue":"myreq")+'">Open all</button></h3>';
  var rows=L.filter(function(r){ return isAdmin()||isMgr() ? r.status!=="COMPLETED"&&r.status!=="CANCELLED" : r.by===ME.e; }).slice(0,8);
  if(!rows.length){
    h+='<div class="empty"><b>Nothing here yet</b>'+(isAdmin()
      ?"When an engineer submits a BOM it lands here."
      :'Use <strong>BOM Compare</strong> to check a harness, then raise a request.')+'</div>';
  } else {
    h+='<div class="tw"><table><thead><tr><th>Request</th><th>Harness</th><th>Requester</th>'+
       '<th class="num">Lines</th><th class="num">Short</th><th>Status</th><th>Submitted</th></tr></thead><tbody>';
    for(i=0;i<rows.length;i++){ var r=rows[i];
      h+='<tr data-req="'+esc(r.no)+'" style="cursor:pointer"><td class="mono">'+esc(r.no)+'</td>'+
         '<td class="mono">'+esc(r.harness)+'</td><td>'+esc(r.byName)+'</td>'+
         '<td class="num">'+r.lines.length+'</td><td class="num">'+shortCount(r)+'</td>'+
         '<td>'+kpill(r.status)+'</td><td class="mono">'+esc(fmtDate(r.on||""))+'</td></tr>';
    }
    h+='</tbody></table></div>';
  }
  h+='</div>';

  /* The manager's slide puts this button on the engineer dashboard, directly
     below My Requests — a part the lab has never bought does not belong in a
     BOM comparison, so it needs its own way in. */
  if(!isAdmin() && !isMgr()){
    h+='<div class="card"><h3>Need something the lab does not stock?</h3><div class="cb">'+
       '<p class="muted" style="margin:0 0 14px;font-size:13px">If the part has never been bought before it will '+
       'not show up in Check Stock or BOM Compare. Raise it here and the store turns it into a purchase request.</p>'+
       '<button class="btn" data-go="newpart">Brand new purchase part</button></div></div>';
  }

  /* low stock watchlist */
  if(isAdmin()||isMgr()){
    var ls=DB.parts.filter(function(p){ var x=b[p.id]; return x.st==="OUT OF STOCK"||x.st==="LOW STOCK"; })
             .sort(function(a,c){ return b[a.id].on-b[c.id].on; }).slice(0,10);
    h+='<div class="card"><h3>Low and out of stock<span class="sp"></span>'+
       '<button class="btn sec sm" data-go="inventory">Full inventory</button></h3><div class="tw"><table>'+
       '<thead><tr><th>Part</th><th>Description</th><th>Location</th><th class="num">On hand</th>'+
       '<th class="num">Reserved</th><th class="num">Available</th><th>Status</th></tr></thead><tbody>';
    for(i=0;i<ls.length;i++){ var p=ls[i], x=b[p.id];
      h+='<tr><td class="mono">'+esc(p.pn)+'</td><td>'+esc(p.d)+'</td><td class="mono">'+esc(p.l||"—")+'</td>'+
         '<td class="num">'+meter(x.on,p.ref)+num(x.on,0)+'</td><td class="num">'+num(x.res,0)+'</td>'+
         '<td class="num">'+num(x.av,0)+'</td><td>'+kpill(x.st)+'</td></tr>';
    }
    h+='</tbody></table></div></div>';
  }
  return h;
}
function tile(c,t,v,s){ return '<dl class="tile '+c+'"><dt>'+esc(t)+'</dt><dd>'+(typeof v==="number"?num(v):esc(v))+
  '<small>'+esc(s||"")+'</small></dd></dl>'; }
function shortCount(r){ var n=0; for(var i=0;i<r.lines.length;i++){ var l=r.lines[i];
  if(l.st==="SHORTAGE"||l.st==="NEW PART") n++; } return n; }

/* ---------- CHECK STOCK ------------------------------------------ */
function vStock(){
  return head("Check Stock","Search the catalogue by part number or description")+
  '<div class="card"><div class="cb"><div class="bar">'+
    '<input type="text" id="q" placeholder="Type a part number, e.g. 7219/0373 — or a word from the description" autofocus>'+
    '<select id="fc"><option value="">All categories</option>'+
      DB.cats.map(function(c){return '<option>'+esc(c)+'</option>';}).join("")+'</select>'+
    '<select id="fs"><option value="">Any status</option><option>IN STOCK</option><option>LOW STOCK</option>'+
      '<option>OUT OF STOCK</option></select>'+
  '</div><div id="sres"></div></div></div>';
}
vStock.after=function(){
  function run(){
    var q=$("#q").value.trim().toUpperCase(), fc=$("#fc").value, fs=$("#fs").value, b=balances();
    var r=DB.parts.filter(function(p){
      var x=b[p.id];
      if(fc && p.c!==fc) return false;
      if(fs && x.st!==fs) return false;
      if(!q) return true;
      return String(p.pn).toUpperCase().indexOf(q)>=0 || String(p.d).toUpperCase().indexOf(q)>=0;
    });
    $("#sres").innerHTML = partTable(r.slice(0,300), r.length);
  }
  $("#q").oninput=run; $("#fc").onchange=run; $("#fs").onchange=run; run();
};
function partTable(rows,total){
  if(!rows.length) return '<div class="empty"><b>No match</b>Nothing in the catalogue matches that. If the part is genuinely new, raise it on a request and the store will create it.</div>';
  var b=balances(),h='<p class="muted" style="margin:0 0 10px;font-size:12.5px">Showing '+num(rows.length)+
    (total>rows.length?" of "+num(total):"")+' components</p><div class="tw"><table><thead><tr>'+
    '<th>Part number</th><th>Description</th><th>Category</th><th>Loc</th><th class="num">On hand</th>'+
    '<th class="num">Resv</th><th class="num">Avail</th><th>UOM</th><th>Status</th></tr></thead><tbody>';
  for(var i=0;i<rows.length;i++){ var p=rows[i],x=b[p.id];
    h+='<tr><td class="mono">'+esc(p.pn)+'</td><td>'+esc(p.d)+'</td><td>'+esc(p.s)+'</td>'+
      '<td class="mono">'+esc(p.l||"—")+'</td><td class="num">'+meter(x.on,p.ref)+num(x.on,0)+'</td>'+
      '<td class="num">'+num(x.res,0)+'</td><td class="num"><b>'+num(x.av,0)+'</b></td>'+
      '<td class="mono">'+esc(p.u)+'</td><td>'+kpill(x.st)+'</td></tr>';
  }
  return h+'</tbody></table></div>';
}

/* ---------- BOM COMPARE ------------------------------------------ */
function vBom(){
  return head("BOM Compare","Paste two columns from Excel — part number and quantity — and see instantly what the lab can supply")+
  '<div class="card"><h3>1 · Paste your BOM</h3><div class="cb">'+
    '<textarea id="bp" rows="7" placeholder="7219/0373&#9;20&#10;7250/0075&#9;26&#10;7210/0274&#9;70&#10;&#10;Select the two columns in Excel, press Ctrl+C, click here, press Ctrl+V."></textarea>'+
    '<div class="bar" style="margin:13px 0 0">'+
      '<button class="btn" id="bgo">Compare against stock</button>'+
      '<button class="btn sec" id="bsample">Load a sample harness</button>'+
      '<button class="btn sec" id="bclear">Clear</button>'+
      '<span class="muted" style="font-size:12.5px">Tab, comma or multiple spaces all work as the separator.</span>'+
    '</div></div></div><div id="bout"></div>';
}
vBom.after=function(){
  $("#bgo").onclick=function(){ BOM=parseBom($("#bp").value); drawBom(); };
  $("#bclear").onclick=function(){ $("#bp").value=""; BOM=[]; $("#bout").innerHTML=""; };
  $("#bsample").onclick=function(){
    var b=balances(), pick=[], i;
    for(i=0;i<DB.parts.length && pick.length<14;i+=Math.max(1,Math.floor(DB.parts.length/40))){
      var p=DB.parts[i]; pick.push(p.pn+"\t"+(Math.floor(Math.random()*40)+2));
    }
    pick.push("9999/XXXX\t4");
    $("#bp").value=pick.join("\n"); BOM=parseBom($("#bp").value); drawBom();
  };
  if(BOM.length) drawBom();
};
function parseBom(txt){
  var lines=String(txt||"").replace(/\r/g,"").split("\n"), out=[], n=0;
  for(var i=0;i<lines.length;i++){
    var L=lines[i].trim(); if(!L) continue;
    var c=L.split(/\t|,|\s{2,}/).filter(function(s){return s!=="";});
    if(c.length<2){ c=L.split(/\s+/); }
    var pn=String(c[0]||"").trim().toUpperCase();
    var qty=parseFloat(String(c[c.length-1]||"").replace(/[^0-9.\-]/g,""));
    if(!pn || !isFinite(qty) || qty<=0) continue;
    if(/^(PART|JCB|SR|S\.NO|ITEM)/i.test(pn) && !isFinite(parseFloat(c[1]))) continue;
    n++; out.push({n:n,pn:pn,q:qty});
  }
  return compareBom(out);
}
function compareBom(rows){
  for(var i=0;i<rows.length;i++){
    var r=rows[i], p=partBy(r.pn);
    if(!p){ r.pid=0; r.d="— not in the lab catalogue —"; r.st="NEW PART"; r.av=0; r.on=0; r.res=0; r.short=r.q; r.u=""; r.l=""; r.cost=0; continue; }
    var b=bal(p.id);
    r.pid=p.id; r.d=p.d; r.u=p.u; r.l=p.l||"—"; r.on=b.on; r.res=b.res; r.av=b.av; r.cost=p.cost||0;
    r.short=Math.max(0,Math.round((r.q-b.av)*1000)/1000);
    r.st = r.q<=b.av ? "AVAILABLE" : (b.av<=0 ? "OUT OF STOCK" : "SHORTAGE");
  }
  return rows;
}
function drawBom(){
  if(!BOM.length){ $("#bout").innerHTML='<div class="card"><div class="empty"><b>Nothing to compare</b>Paste at least one line with a part number and a quantity.</div></div>'; return; }
  var av=0,sh=0,np=0,cost=0,i;
  for(i=0;i<BOM.length;i++){ var r=BOM[i];
    if(r.st==="AVAILABLE")av++; else if(r.st==="NEW PART")np++; else sh++;
    cost+=r.q*(r.cost||0); }
  var h='<div class="tiles">'+
    tile("","Lines",BOM.length,"in this BOM")+
    tile(av?"g":"","Available",av,"can be issued today")+
    tile(sh?"r":"","Short",sh,"not enough in store")+
    tile(np?"b":"","New parts",np,"not in the catalogue at all")+
    tile("a","Estimated material",inrShort(cost),"at last purchase price")+
  '</div>';
  h+='<div class="card"><h3>2 · Comparison<span class="sp"></span>'+
     '<button class="btn sec sm" id="bcsv">Download CSV</button>'+
     (ME.r==="Engineer"||isAdmin()?'<button class="btn sm" id="btoreq">Raise part request &rsaquo;</button>':'')+
     '</h3><div class="tw"><table><thead><tr><th>#</th><th>Part number</th><th>Description</th>'+
     '<th class="num">Req</th><th class="num">On hand</th><th class="num">Resv</th><th class="num">Avail</th>'+
     '<th class="num">Short</th><th>UOM</th><th>Loc</th><th>Status</th></tr></thead><tbody>';
  for(i=0;i<BOM.length;i++){ var r=BOM[i];
    h+='<tr><td class="mono muted">'+r.n+'</td><td class="mono">'+esc(r.pn)+'</td><td>'+esc(r.d)+'</td>'+
      '<td class="num">'+num(r.q,0)+'</td><td class="num">'+(r.pid?num(r.on,0):"—")+'</td>'+
      '<td class="num">'+(r.pid?num(r.res,0):"—")+'</td><td class="num"><b>'+(r.pid?num(r.av,0):"—")+'</b></td>'+
      '<td class="num">'+(r.short?'<b style="color:#dc7361">'+num(r.short,0)+'</b>':"0")+'</td>'+
      '<td class="mono">'+esc(r.u)+'</td><td class="mono">'+esc(r.l)+'</td><td>'+kpill(r.st)+'</td></tr>';
  }
  h+='</tbody></table></div>'+
    '<div class="cb" style="border-top:1px solid #31353c;font-size:12.5px">'+
    '<span class="muted">A <strong>new part</strong> is not the same as an out-of-stock part. New means the lab has never carried it and the store must create it first — that is why the two are coloured differently.</span></div></div>';
  $("#bout").innerHTML=h;
  $("#bcsv").onclick=function(){
    var L=["Line,PartNumber,Description,Requested,OnHand,Reserved,Available,Shortage,UOM,Location,Status"];
    for(var i=0;i<BOM.length;i++){ var r=BOM[i];
      L.push([r.n,'"'+r.pn+'"','"'+String(r.d).replace(/"/g,"")+'"',r.q,r.on,r.res,r.av,r.short,r.u,'"'+r.l+'"',r.st].join(",")); }
    dl("BOM-comparison-"+today()+".csv",L.join("\n"));
  };
  if($("#btoreq")) $("#btoreq").onclick=function(){ VIEW="newreq"; renderNav(); render(); };
}
function dl(name,text){
  if(IS_HTA){
    try{
      var f=new ActiveXObject("Scripting.FileSystemObject");
      var sh=new ActiveXObject("WScript.Shell");
      var p=sh.SpecialFolders("Desktop")+"\\"+name;
      var st=f.CreateTextFile(p,true); st.Write(text); st.Close();
      toast("Saved to your Desktop as "+name,"Exported");
      return;
    }catch(e){ /* fall through to copy-out */ }
  }
  modal("Export &mdash; "+esc(name),
    '<p style="margin:0 0 10px;font-size:13px" class="muted">Click inside the box, press <strong>Ctrl+A</strong> then <strong>Ctrl+C</strong>, and paste straight into Excel. Excel will split it into columns for you.</p>'+
    '<textarea id="dlbox" rows="15" spellcheck="false">'+esc(text)+'</textarea>',
    '<button class="btn sec" onclick="closeModal()">Close</button>'+
    '<button class="btn" onclick="var t=document.getElementById(\'dlbox\');t.focus();t.select();">Select all</button>');
}

/* ---------- NEW REQUEST ------------------------------------------ */
function vNewReq(){
  var h=head("NEW REQUEST","Project details, then the BOM. Both are needed before the store can act.");
  if(!BOM.length){
    h+='<div class="card"><div class="empty"><b>Load a BOM first</b>'+
       'Go to <strong>BOM Compare</strong>, paste your harness BOM, then come back — the lines carry across so you never type them twice.'+
       '<div style="margin-top:16px"><button class="btn" data-go="bom">Go to BOM Compare</button></div></div></div>';
    return h;
  }
  h+='<div class="card"><h3>1 · Project information</h3><div class="cb">'+
   '<div class="f3">'+
     fld("Machine / variant","f_mach","text","3CX 74KW",1)+
     fld("Project code","f_pcode","text","PCODE-00042",1)+
     fld("Harness part number","f_harn","text","405/F8525",1)+
   '</div><div class="f3">'+
     sel("Build stage","f_stage",["Mule","DVP","Proto","PPAP","Production"],1)+
     sel("Business unit","f_bu",["BHL INDIA","EXCAVATOR","LOADALL","COMPACTION"],1)+
     fld("Cost centre / BU","f_cc","text","IDC00005",1)+
   '</div><div class="f2">'+
     fld("Business unit contact","f_buc","text","Shashank G",1)+
     fld("DC contact","f_dcc","text","Mahendra M",1)+
   '</div><div class="f2">'+
     fld("No. of circuits","f_circ","number","48",1)+
     fld("Required by","f_req","date",today(),1)+
   '</div>'+
   '<div class="fg"><label>Scope of work <i>*</i></label>'+
     '<textarea id="f_scope" rows="4" placeholder="Feature name, component change, add or delete, old concept vs new concept."></textarea>'+
     '<span class="muted" style="font-size:11.5px" id="scount">0 / 1800 characters</span></div>'+
   '</div></div>';
  var sh=0; for(var i=0;i<BOM.length;i++) if(BOM[i].st!=="AVAILABLE") sh++;
  h+='<div class="card"><h3>2 · BOM — '+BOM.length+' lines'+(sh?', '+sh+' need purchasing':'')+
     '<span class="sp"></span><button class="btn sec sm" data-go="bom">Edit BOM</button></h3><div class="tw"><table>'+
     '<thead><tr><th>#</th><th>Part</th><th>Description</th><th class="num">Qty</th><th class="num">Avail</th><th>Status</th></tr></thead><tbody>';
  for(i=0;i<BOM.length;i++){ var r=BOM[i];
    h+='<tr><td class="mono muted">'+r.n+'</td><td class="mono">'+esc(r.pn)+'</td><td>'+esc(r.d)+'</td>'+
       '<td class="num">'+num(r.q,0)+'</td><td class="num">'+(r.pid?num(r.av,0):"—")+'</td><td>'+kpill(r.st)+'</td></tr>';
  }
  h+='</tbody></table></div><div class="cb" style="border-top:1px solid #31353c;text-align:right">'+
     '<button class="btn sec" data-go="bom">Back</button><button class="btn" id="submitreq">Submit request</button></div></div>';
  return h;
}
/* One helper for every plain field in the app. A "date" here is NOT a native
   <input type="date"> — the IE engine has no such control and silently renders
   a bare text box showing 2026-09-18 with no picker, which is exactly what the
   lab saw. dfield() draws a text box in DD-MMM-YYYY plus a calendar button
   that behaves the same in both engines. */
function fld(l,id,t,ph,req){
  if(t==="date") return dfield(l,id,ph,req);
  return '<div class="fg"><label>'+esc(l)+(req?' <i>*</i>':'')+'</label>'+
    '<input type="'+t+'" id="'+id+'" placeholder="'+esc(ph)+'"></div>';
}
function sel(l,id,opts,req){ return '<div class="fg"><label>'+esc(l)+(req?' <i>*</i>':'')+'</label><select id="'+id+'">'+
  opts.map(function(o){return '<option>'+esc(o)+'</option>';}).join("")+'</select></div>'; }
vNewReq.after=function(){
  if(!$("#f_scope")) return;
  $("#f_scope").oninput=function(){ $("#scount").textContent=this.value.length+" / 1800 characters"; };
  $("#submitreq").onclick=function(){
    var need=[["f_mach","Machine / variant"],["f_pcode","Project code"],["f_harn","Harness part number"],
              ["f_cc","Cost centre"],["f_buc","Business unit contact"],["f_dcc","DC contact"],
              /* the circuit count is the single input the whole cost sheet runs on,
                 so a request without it cannot be costed later */
              ["f_circ","No. of circuits"],["f_scope","Scope of work"]];
    if(!dval("f_req")){
      toast("Required by needs a valid date, for example "+fmtDate(today())+".","Check the date",true);
      $("#f_req").focus(); return;
    }
    for(var i=0;i<need.length;i++){
      if(!$("#"+need[i][0]).value.trim()){
        toast(need[i][1]+" is required before this can be submitted.","Missing information",true);
        $("#"+need[i][0]).focus(); return;
      }
    }
    var lines=[];
    for(i=0;i<BOM.length;i++){ var r=BOM[i];
      lines.push({n:r.n,pn:r.pn,pid:r.pid,d:r.d,q:r.q,u:r.u,resv:0,rel:0,
        st:r.pid?(r.q<=bal(r.pid).av?"AVAILABLE":(bal(r.pid).av<=0?"SHORTAGE":"PARTIAL")):"NEW PART",
        cost:r.cost||0,rem:""});
    }
    /* pad by hand — String.padStart is ES6 and the .hta's IE engine throws
       "Object doesn't support property or method" on it, which would have
       killed every request submission on a real desktop. */
    var seq="00000"+(reqList().length+1); seq=seq.slice(seq.length-5);
    var no="REQ-"+new Date().getFullYear()+"-"+seq;
    var r={no:no,status:"SUBMITTED",by:ME.e,byName:ME.n,on:today(),
      machine:$("#f_mach").value.trim(),pcode:$("#f_pcode").value.trim(),harness:$("#f_harn").value.trim(),
      stage:$("#f_stage").value,bu:$("#f_bu").value,cc:$("#f_cc").value.trim(),
      buc:$("#f_buc").value.trim(),dcc:$("#f_dcc").value.trim(),
      circ:$("#f_circ").value||"",need:dval("f_req"),scope:$("#f_scope").value.trim(),lines:lines,log:[]};
    r.log.push({t:new Date().toISOString(),by:ME.n,a:"Submitted with "+lines.length+" lines"});
    saveReq(r); BOM=[];
    toast(no+" is with the store. You will see it move through the stages on My Requests.","Request submitted");
    VIEW="myreq"; renderNav(); render();
  };
};

/* ---------- MY REQUESTS ------------------------------------------ */
function vMyReq(){
  var L=reqList().filter(function(r){ return r.by===ME.e; });
  var h=head("My Requests","Everything you have raised, and where it has got to");
  if(!L.length) return h+'<div class="card"><div class="empty"><b>No requests yet</b>'+
    'Check a BOM first, then raise a request from the comparison screen.'+
    '<div style="margin-top:16px"><button class="btn" data-go="bom">Check a BOM</button></div></div></div>';
  h+='<div class="card"><div class="tw"><table class="flt"><thead><tr><th>Request</th><th>Harness</th><th>Machine</th>'+
     '<th>Stage</th><th class="num">Lines</th><th class="num">Short</th><th>Status</th><th>Raised</th><th></th></tr></thead><tbody>';
  for(var i=0;i<L.length;i++){ var r=L[i];
    var sc=shortCount(r);
    h+='<tr><td class="mono">'+esc(r.no)+'</td><td class="mono">'+esc(r.harness)+'</td><td>'+esc(r.machine)+'</td>'+
       '<td>'+esc(r.stage)+'</td><td class="num">'+r.lines.length+'</td>'+
       '<td class="num">'+(sc?'<b style="color:#dc7361">'+sc+'</b>':'0')+'</td>'+
       '<td>'+kpill(r.status)+(r.kind==="SHORTAGE"?' <span class="pill k-b">SHORTFALL</span>':'')+'</td>'+
       '<td class="mono">'+esc(fmtDate(r.on))+'</td>'+
       '<td class="num"><button class="btn sec sm" data-req="'+esc(r.no)+'">Open</button></td></tr>';
  }
  return h+'</tbody></table></div></div>';
}

/* ---------- REQUEST QUEUE (admin / manager) ---------------------- */
function vQueue(){
  var L=reqList();
  var h=head(isMgr()?"All Requests":"Request Queue",
    isMgr()?"Read-only view of everything in flight":"Oldest first. Open a request to reserve or release material.");
  h+='<div class="bar"><select id="qf"><option value="">All statuses</option>'+
     ["SUBMITTED","ADMIN REVIEW","PURCHASE REQUIRED","RESERVED","READY FOR RELEASE","PARTIALLY RELEASED","RELEASED","COMPLETED","CANCELLED"]
       .map(function(s){return '<option>'+s+'</option>';}).join("")+'</select>'+
     '<input type="text" id="qs" placeholder="Search request, harness, machine or requester"></div>'+
     '<div class="card"><div id="qout"></div></div>';
  return h;
}
vQueue.after=function(){
  function run(){
    var f=$("#qf").value, q=$("#qs").value.trim().toUpperCase();
    var L=reqList().filter(function(r){
      if(f && r.status!==f) return false;
      if(!q) return true;
      return (r.no+" "+r.harness+" "+r.machine+" "+r.byName).toUpperCase().indexOf(q)>=0;
    });
    if(!L.length){ $("#qout").innerHTML='<div class="empty"><b>Nothing matches</b>No requests with that filter.</div>'; return; }
    var h='<div class="tw"><table class="flt"><thead><tr><th>Request</th><th>Requester</th><th>Harness</th><th>Machine</th>'+
      '<th>Stage</th><th class="num">Lines</th><th class="num">Short</th><th>Status</th><th>Raised</th><th></th></tr></thead><tbody>';
    for(var i=0;i<L.length;i++){ var r=L[i];
      h+='<tr><td class="mono">'+esc(r.no)+'</td><td>'+esc(r.byName)+'</td><td class="mono">'+esc(r.harness)+'</td>'+
        '<td>'+esc(r.machine)+'</td><td>'+esc(r.stage)+'</td><td class="num">'+r.lines.length+'</td>'+
        '<td class="num">'+(shortCount(r)?'<b style="color:#dc7361">'+shortCount(r)+'</b>':"0")+'</td>'+
        '<td>'+kpill(r.status)+'</td><td class="mono">'+esc(fmtDate(r.on))+'</td>'+
        '<td><button class="btn '+(isMgr()?"sec ":"")+'sm" data-req="'+esc(r.no)+'">'+(isMgr()?"View":"Open")+'</button></td></tr>';
    }
    $("#qout").innerHTML=h+'</tbody></table></div>';
    wire();
  }
  $("#qf").onchange=run; $("#qs").oninput=run; run();
};

/* ===================================================================
   v6 MODULES
   Everything the manager asked for that did not exist in v5:
   cost sheet, invoice, brand-new-purchase-part, shortage flow,
   high-demand parts, ongoing purchase, PR/PO form, dashboard charts.

   ES5 ONLY. This file is rendered by the Windows IE engine inside the
   .hta — no arrow functions, no template literals, no let/const, no
   ES6 methods, and no CSS the IE engine cannot read (no flex, no grid,
   no gap, no var()). The ietest linter fails the build if any appear.
   =================================================================== */

/* ---------- FINANCE-LOCKED COST CONSTANTS -------------------------
   Straight off the Assumptions sheet. Finance owns every one of these.
   The lab incharge's ONLY input is the circuit count, which the
   engineer supplies on the request — everything else is locked and
   simply displayed, so that the printed sheet Finance sees matches
   the workbook they already signed off. */
var COST_K = {
  machineCost   : 418000,
  depreciationPA: 41800,
  protoPerHrs   : 12,
  hrsPerDay     : 15,
  daysPerMonth  : 20,
  monthsPA      : 12,
  stdHrsPA      : 3600,
  technicians   : 1,
  ratePerHour   : 1239,   /* the label on the sheet says 1236; the cell is 1239 — cell wins */
  kwhPerHr      : 10,
  ratePerKwh    : 9,
  totalKwhPA    : 36000,
  elecTotalCost : 324000,
  amcPerHours   : 50,     /* shown on the sheet, deliberately NOT in the total */
  transport     : 200,
  circuitsPerHr : 7.5     /* derived from the 100 and 200 circuit sheets */
};

/* hours = circuits / 7.5, then the three cost legs. AMC is excluded from
   the total — that matches the Excel, and is flagged for Finance. */
function costCalc(ckt, matTotal){
  var c     = Number(ckt)||0;
  var hours = c / COST_K.circuitsPerHr;
  var mach  = (COST_K.depreciationPA / COST_K.stdHrsPA) * hours;
  var man   = COST_K.ratePerHour * hours;
  var elec  = COST_K.kwhPerHr * hours;
  var asm   = mach + man + elec;
  var mat   = Number(matTotal)||0;
  return { ckt:c, hours:hours, mach:mach, man:man, manHr:man/COST_K.stdHrsPA,
           elec:elec, asm:asm, mat:mat, trn:COST_K.transport,
           tot: mat + asm + COST_K.transport };
}

/* ---------- CHARTS ------------------------------------------------
   Drawn as inline SVG and plain divs on purpose. A chart library would
   need a CDN the lab desktops cannot reach, and canvas is patchy in a
   legacy document mode; inline SVG has worked since IE9. */
var CHART_COL = ["#f2b01e","#6c9cc6","#4fae7d","#dc7361","#a3a8b0","#c88f10","#d99b3c","#8a7fc0"];

function pieSvg(slices, size){
  var i, tot=0;
  for(i=0;i<slices.length;i++) tot += Number(slices[i].v)||0;
  var S = size||188, R = S/2 - 2, CX = S/2, CY = S/2;
  if(tot<=0){
    return '<svg width="'+S+'" height="'+S+'" viewBox="0 0 '+S+' '+S+'">'+
      '<circle cx="'+CX+'" cy="'+CY+'" r="'+R+'" fill="#24272d" stroke="#31353c" stroke-width="1"></circle>'+
      '<text x="'+CX+'" y="'+CY+'" text-anchor="middle" fill="#71767e" font-size="12" font-family="Segoe UI,sans-serif">no data yet</text></svg>';
  }
  var a0 = -Math.PI/2, h='';
  for(i=0;i<slices.length;i++){
    var frac=(Number(slices[i].v)||0)/tot; if(frac<=0) continue;
    var a1 = a0 + frac*Math.PI*2;
    var x0 = CX+R*Math.cos(a0), y0 = CY+R*Math.sin(a0);
    var x1 = CX+R*Math.cos(a1), y1 = CY+R*Math.sin(a1);
    var big = frac>0.5 ? 1 : 0;
    var col = slices[i].c || CHART_COL[i%CHART_COL.length];
    /* a single full slice has no arc to draw — use a plain circle instead */
    if(frac>0.999){
      h+='<circle cx="'+CX+'" cy="'+CY+'" r="'+R+'" fill="'+col+'"></circle>';
    } else {
      h+='<path d="M '+CX+' '+CY+' L '+x0.toFixed(2)+' '+y0.toFixed(2)+
         ' A '+R+' '+R+' 0 '+big+' 1 '+x1.toFixed(2)+' '+y1.toFixed(2)+' Z" fill="'+col+
         '" stroke="#1d1f24" stroke-width="1"></path>';
    }
    a0=a1;
  }
  h+='<circle cx="'+CX+'" cy="'+CY+'" r="'+(R*0.54).toFixed(1)+'" fill="#1d1f24"></circle>';
  return '<svg width="'+S+'" height="'+S+'" viewBox="0 0 '+S+' '+S+'">'+h+'</svg>';
}

function pieLegend(slices){
  var i, tot=0, h='';
  for(i=0;i<slices.length;i++) tot += Number(slices[i].v)||0;
  for(i=0;i<slices.length;i++){
    var s=slices[i], col=s.c||CHART_COL[i%CHART_COL.length];
    var pc = tot>0 ? ((Number(s.v)||0)/tot*100) : 0;
    h+='<div class="lg"><i style="background:'+col+'"></i>'+
       '<span class="lgn">'+esc(s.k)+'</span>'+
       '<span class="lgv">'+inrShort(s.v)+'</span>'+
       '<span class="lgp">'+pc.toFixed(0)+'%</span></div>';
  }
  return h||'<div class="muted" style="font-size:12.5px">Nothing invoiced yet.</div>';
}

/* horizontal bars — a table, because it lines up in the IE engine
   without flexbox and prints correctly too */
function barRows(rows){
  var i, max=0;
  for(i=0;i<rows.length;i++) if(Number(rows[i].v)>max) max=Number(rows[i].v);
  if(max<=0) max=1;
  var h='<table class="bars">';
  for(i=0;i<rows.length;i++){
    var r=rows[i], pc=Math.max(2,(Number(r.v)||0)/max*100);
    var col=r.c||CHART_COL[i%CHART_COL.length];
    h+='<tr><th>'+esc(r.k)+'</th>'+
       '<td><span class="bw"><i style="width:'+pc.toFixed(1)+'%;background:'+col+'"></i></span></td>'+
       '<td class="bv">'+num(r.v,0)+'</td></tr>';
  }
  return h+'</table>';
}

/* ---------- SHORTAGE BOOK -----------------------------------------
   "Shortage is logged, AND accumulates if another engineer requests the
   same part." So the shortage is never stored as a number on one
   request — it is derived by walking every open request and adding up
   what each one still cannot be given. Two engineers short of the same
   connector show as one line with the combined quantity and both names,
   which is what makes it usable for raising a single PR. */
function shortageBook(){
  var L=reqList(), map={}, out=[], i, j, DEAD={COMPLETED:1,CANCELLED:1,REJECTED:1};
  for(i=0;i<L.length;i++){
    var r=L[i]; if(DEAD[r.status]) continue;
    for(j=0;j<r.lines.length;j++){
      var l=r.lines[j];
      var gap=(Number(l.q)||0)-Math.max(Number(l.resv)||0,Number(l.rel)||0);
      if(gap<=0) continue;
      var key=String(l.pn).toUpperCase();
      if(!map[key]){
        map[key]={pn:l.pn,pid:l.pid,d:l.d,qty:0,reqs:[],who:[],newPart:!l.pid};
        out.push(map[key]);
      }
      map[key].qty+=gap;
      if(map[key].reqs.indexOf(r.no)<0) map[key].reqs.push(r.no);
      if(map[key].who.indexOf(r.byName)<0) map[key].who.push(r.byName);
    }
  }
  out.sort(function(a,b){ return b.qty-a.qty; });
  return out;
}

/* what is already covered by a PR row in the OngoingPurchase tab */
function purchFor(pn){
  var P=DB.purch||[], i, out=[];
  for(i=0;i<P.length;i++) if(String(P[i].pn).toUpperCase()===String(pn).toUpperCase()) out.push(P[i]);
  return out;
}

/* ---------- SHORTAGE REQUEST (engineer) ---------------------------
   From the notes: A=10 B=20 C=30, A is out of stock. B and C get
   released now; A must not hold them up. So every short line carries a
   button next to its status. The engineer clicks it, types only the
   part number and the quantity, submits, and that one line travels to
   the admin as its own small request while the rest of the original
   request carries on to release. */
function openShortForm(no, idx){
  var R=reqIndex(), r=R[no]; if(!r) return;
  var l=r.lines[idx]; if(!l) return;
  var gap=(Number(l.q)||0)-Math.max(Number(l.resv)||0,Number(l.rel)||0);
  if(gap<1) gap=Number(l.q)||1;
  var h='<p class="muted" style="margin:0 0 14px;font-size:13px">'+
    'This raises a separate request for the part that could not be given to you, so the rest of '+
    '<span class="mono">'+esc(no)+'</span> can be released without waiting. It goes to the store for approval.</p>'+
    '<div class="f2">'+
      '<div class="fg"><label>Part number <i>*</i></label>'+
        '<input type="text" id="sf_pn" value="'+esc(l.pn)+'"></div>'+
      '<div class="fg"><label>Quantity still needed <i>*</i></label>'+
        '<input type="number" id="sf_q" min="1" step="1" value="'+gap+'"></div>'+
    '</div>'+
    '<div class="fg"><label>Note for the store</label>'+
      '<input type="text" id="sf_n" placeholder="Optional — when you need it, or an alternative you would accept"></div>';
  var f='<button class="btn sec" onclick="closeModal()">Cancel</button>'+
        '<button class="btn" id="sf_go">Submit to store</button>';
  modal("Request the shortfall separately", h, f);
  $("#sf_go").onclick=function(){
    var pn=$("#sf_pn").value.replace(/^\s+|\s+$/g,"");
    var q=Number($("#sf_q").value)||0;
    if(!pn){ toast("Part number is required.","Missing information",true); return; }
    if(q<=0){ toast("Quantity must be more than zero.","Check the quantity",true); return; }
    var p=partBy(pn);
    var seq="00000"+(reqList().length+1); seq=seq.slice(seq.length-5);
    var sn="SHT-"+new Date().getFullYear()+"-"+seq;
    var nr={no:sn,kind:"SHORTAGE",parent:no,status:"SUBMITTED",by:ME.e,byName:ME.n,on:today(),
      machine:r.machine,pcode:r.pcode,harness:r.harness,stage:r.stage,bu:r.bu,cc:r.cc,
      buc:r.buc,dcc:r.dcc,circ:r.circ||"",need:r.need,
      scope:"Shortfall from "+no+" — "+pn+" x "+q+(($("#sf_n").value)?(". "+$("#sf_n").value):""),
      lines:[{n:1,pn:pn,pid:p?p.id:null,d:p?p.d:(l.d||"New part — not in the Parts tab"),
              q:q,u:p?p.u:(l.u||"NO"),resv:0,rel:0,
              st:p?(q<=bal(p.id).av?"AVAILABLE":(bal(p.id).av<=0?"SHORTAGE":"PARTIAL")):"NEW PART",
              cost:p?p.cost:0,rem:$("#sf_n").value||""}],
      log:[{t:new Date().toISOString(),by:ME.n,a:"Raised as a shortfall of "+no}]};
    saveReq(nr); closeModal();
    toast(sn+" is with the store. "+esc(no)+" can be released without it.","Shortfall request raised");
    renderNav(); render();
  };
}

/* ---------- BRAND NEW PURCHASE PART -------------------------------
   Twelve columns off the manager's slide, entered row by row in the
   portal (not by opening Excel), with no row limit. Mandatory columns
   are marked; the rest are "if applicable" exactly as the slide says. */
var NPCOLS = [
  {k:"by",    t:"Requester Name",  m:1, w:150},
  {k:"cat",   t:"Category",        m:1, w:130},
  {k:"sub",   t:"Sub category",    m:0, w:130},
  {k:"plant", t:"Plant Code",      m:1, w:92,  ph:"5040"},
  {k:"name",  t:"Part / Machine Name", m:1, w:210},
  {k:"make",  t:"Make / Brand",    m:0, w:130},
  {k:"model", t:"Model No.",       m:0, w:130},
  {k:"specs", t:"Other specs",     m:0, w:170, ph:"size, weight, colour"},
  {k:"rem",   t:"Remarks",         m:0, w:160},
  {k:"uom",   t:"UOM",             m:1, w:78,  ph:"NO"},
  {k:"hsn",   t:"8-Digit HSN",     m:1, w:112, ph:"85366990"}
];
var NPROWS = [];

function npBlank(){
  return {by:(ME?ME.n:""),cat:"",sub:"",plant:"",name:"",make:"",model:"",
          specs:"",rem:"",uom:"NO",hsn:""};
}
function vNewPart(){
  if(!NPROWS.length){ NPROWS=[npBlank(),npBlank(),npBlank()]; }
  var h=head("Brand New Purchase Part",
    "Parts the lab does not stock yet. Fill a row per part — there is no row limit — and submit to the store, which turns them into a PR.");
  h+='<div class="card"><h3>Entry sheet<span class="sp"></span>'+
     '<button class="btn sec sm" id="np_add">+ Add row</button>'+
     '<button class="btn sec sm" id="np_add10">+ 10 rows</button></h3>'+
     '<div class="tw" style="max-height:54vh"><table class="np"><thead><tr><th style="width:44px">Sr</th>';
  for(var c=0;c<NPCOLS.length;c++)
    h+='<th style="width:'+NPCOLS[c].w+'px">'+esc(NPCOLS[c].t)+(NPCOLS[c].m?' <i style="color:#dc7361;font-style:normal">*</i>':'')+'</th>';
  h+='<th style="width:46px"></th></tr></thead><tbody id="np_body"></tbody></table></div>'+
     '<div class="cb" style="border-top:1px solid #31353c;text-align:right">'+
     '<span class="muted" style="float:left;font-size:12px" id="np_count"></span>'+
     '<button class="btn sec" id="np_clear">Clear sheet</button>'+
     '<button class="btn" id="np_go">Submit to store</button></div></div>';
  return h;
}
function npDraw(){
  var b=$("#np_body"); if(!b) return;
  var h="", i, c;
  for(i=0;i<NPROWS.length;i++){
    h+='<tr><td class="num muted">'+(i+1)+'</td>';
    for(c=0;c<NPCOLS.length;c++){
      var col=NPCOLS[c];
      h+='<td><input type="text" data-r="'+i+'" data-k="'+col.k+'" value="'+esc(NPROWS[i][col.k]||"")+
         '"'+(col.ph?' placeholder="'+esc(col.ph)+'"':'')+'></td>';
    }
    h+='<td class="num"><button class="btn sec sm" data-npdel="'+i+'">&times;</button></td></tr>';
  }
  b.innerHTML=h;
  var filled=0;
  for(i=0;i<NPROWS.length;i++) if(String(NPROWS[i].name||"").replace(/\s/g,"")) filled++;
  $("#np_count").innerHTML=NPROWS.length+" row(s) on the sheet, "+filled+" with a part name";
  $$("#np_body input").forEach(function(el){
    el.onchange=el.onkeyup=function(){
      NPROWS[Number(el.getAttribute("data-r"))][el.getAttribute("data-k")]=el.value;
    };
  });
  $$("#np_body [data-npdel]").forEach(function(bt){
    bt.onclick=function(){ NPROWS.splice(Number(bt.getAttribute("data-npdel")),1);
      if(!NPROWS.length) NPROWS=[npBlank()]; npDraw(); };
  });
}
vNewPart.after=function(){
  npDraw();
  $("#np_add").onclick=function(){ NPROWS.push(npBlank()); npDraw(); };
  $("#np_add10").onclick=function(){ for(var i=0;i<10;i++) NPROWS.push(npBlank()); npDraw(); };
  $("#np_clear").onclick=function(){ NPROWS=[npBlank(),npBlank(),npBlank()]; npDraw(); };
  $("#np_go").onclick=function(){
    var live=[], i, c;
    for(i=0;i<NPROWS.length;i++) if(String(NPROWS[i].name||"").replace(/\s/g,"")) live.push(NPROWS[i]);
    if(!live.length){ toast("Fill in at least one part name before submitting.","Nothing to submit",true); return; }
    for(i=0;i<live.length;i++){
      for(c=0;c<NPCOLS.length;c++){
        if(!NPCOLS[c].m) continue;
        if(!String(live[i][NPCOLS[c].k]||"").replace(/\s/g,"")){
          toast('Row '+(i+1)+' is missing "'+NPCOLS[c].t+'", which is mandatory.',"Missing information",true);
          return;
        }
      }
    }
    var seq="00000"+((DB.npart?DB.npart.length:0)+1); seq=seq.slice(seq.length-5);
    var no="NPR-"+new Date().getFullYear()+"-"+seq;
    for(i=0;i<live.length;i++){
      var r=live[i];
      Store.pushNewPart({sr:i+1,no:no,by:r.by,cat:r.cat,sub:r.sub,plant:r.plant,name:r.name,
        make:r.make,model:r.model,specs:r.specs,rem:r.rem,uom:r.uom,hsn:r.hsn,
        status:"SUBMITTED",on:today()});
    }
    NPROWS=[npBlank(),npBlank(),npBlank()];
    toast(no+" submitted with "+live.length+" part(s). The store turns these into a PR.","Sent to the store");
    VIEW="dash"; renderNav(); render();
  };
};

/* ---------- ADMIN: NEW PURCHASE PART QUEUE ------------------------ */
function vNewPartQ(){
  var L=(DB.npart||[]).slice(0);
  var h=head("New Purchase Parts","Parts engineers have asked the lab to buy for the first time. Approve a row and it becomes a line in Ongoing Purchase, ready for a PR.");
  if(!L.length) return h+'<div class="card"><div class="empty"><b>Nothing waiting</b>'+
    'When an engineer submits the Brand New Purchase Part sheet, the rows land here.</div></div>';
  L.sort(function(a,b){ return (b.on||"").localeCompare(a.on||""); });
  h+='<div class="card"><div class="tw"><table class="flt"><thead><tr><th>Request</th><th>Sr</th><th>Requester</th>'+
     '<th>Part / Machine</th><th>Category</th><th>Plant</th><th>Make</th><th>HSN</th><th>UOM</th>'+
     '<th>Status</th><th>Raised</th>'+(isAdmin()?'<th></th>':'')+'</tr></thead><tbody>';
  for(var i=0;i<L.length;i++){ var r=L[i];
    h+='<tr><td class="mono">'+esc(r.no)+'</td><td class="num muted">'+r.sr+'</td>'+
       '<td>'+esc(r.by)+'</td><td>'+esc(r.name)+
       (r.specs?'<br><span class="muted" style="font-size:11.5px">'+esc(r.specs)+'</span>':'')+'</td>'+
       '<td>'+esc(r.cat)+(r.sub?' &middot; '+esc(r.sub):'')+'</td><td class="mono">'+esc(r.plant)+'</td>'+
       '<td>'+esc(r.make)+(r.model?' '+esc(r.model):'')+'</td><td class="mono">'+esc(r.hsn)+'</td>'+
       '<td>'+esc(r.uom)+'</td><td>'+kpill(r.status)+'</td><td class="mono">'+esc(fmtDate(r.on))+'</td>'+
       (isAdmin()?'<td class="num">'+(r.status==="SUBMITTED"?
         '<button class="btn sm" data-npok="'+esc(r.no)+'|'+r.sr+'">Approve</button>':
         '<span class="muted">&mdash;</span>')+'</td>':'')+
       '</tr>';
  }
  return h+'</tbody></table></div></div>';
}

/* ---------- HIGH DEMAND PARTS -------------------------------------
   From the handwritten note: which parts are released or consumed most
   often, with quantity, so it can be used for inventory planning. The
   ranking is by how many separate times a part went out, not by the
   total quantity, because one big issue is not a demand pattern —
   twelve small ones are. Quantity is shown alongside so the planner
   sees both. */
function vDemand(){
  var h=head("High Demand Parts","Which material actually moves. Ranked by how often it is issued, with the quantity beside it, so reorder levels can be set on evidence rather than memory.");
  h+='<div class="bar"><label>Period</label><select id="dm_p">'+
     '<option value="90">Last 90 days</option><option value="180">Last 180 days</option>'+
     '<option value="365" selected>Last 12 months</option><option value="0">Everything</option>'+
     '</select><input type="text" id="dm_s" placeholder="Search part or description"></div>'+
     '<div class="card"><div id="dm_out"></div></div>';
  return h;
}
function demandRows(days){
  var L=DB.ledger, map={}, out=[], i;
  var cut=null;
  if(days>0){ var d=new Date(); d.setDate(d.getDate()-days); cut=d.toISOString().slice(0,10); }
  for(i=0;i<L.length;i++){
    var t=L[i];
    if(t.q>=0) continue;                       /* only material going out */
    if(cut && String(t.dt) < cut) continue;
    var p=partById(t.p); if(!p) continue;
    if(!map[p.id]){ map[p.id]={p:p,times:0,qty:0,last:""}; out.push(map[p.id]); }
    map[p.id].times++; map[p.id].qty += Math.abs(t.q);
    if(String(t.dt)>map[p.id].last) map[p.id].last=String(t.dt);
  }
  out.sort(function(a,b){ return (b.times-a.times) || (b.qty-a.qty); });
  return out;
}
vDemand.after=function(){
  function run(){
    var days=Number($("#dm_p").value)||0, q=$("#dm_s").value.replace(/^\s+|\s+$/g,"").toUpperCase();
    var rows=demandRows(days), i;
    if(q) rows=rows.filter(function(r){ return (r.p.pn+" "+r.p.d).toUpperCase().indexOf(q)>=0; });
    if(!rows.length){ $("#dm_out").innerHTML='<div class="empty"><b>No movement in this period</b>Nothing has been issued against that filter.</div>'; return; }
    var top=rows[0].times||1, R=[];
    var thead='<thead><tr><th style="width:44px">#</th><th>Part</th><th>Description</th>'+
      '<th class="num">Times issued</th><th style="width:150px">Frequency</th><th class="num">Qty out</th>'+
      '<th class="num">On hand</th><th class="num">Reorder ref</th><th>Status</th><th class="mono">Last out</th></tr></thead><tbody>';
    for(i=0;i<rows.length && i<200;i++){
      var r=rows[i], b=bal(r.p.id), pc=Math.max(3,r.times/top*100);
      var risk = (b.av<=0) ? "#dc7361" : (r.p.ref>0 && b.on<=r.p.ref*0.2 ? "#d99b3c" : "#4fae7d");
      R.push('<tr><td class="num muted">'+(i+1)+'</td><td class="mono">'+esc(r.p.pn)+'</td>'+
         '<td>'+esc(r.p.d)+'</td><td class="num"><b>'+num(r.times,0)+'</b></td>'+
         '<td><span class="bw"><i style="width:'+pc.toFixed(1)+'%;background:'+risk+'"></i></span></td>'+
         '<td class="num">'+num(r.qty,0)+' '+esc(r.p.u)+'</td>'+
         '<td class="num">'+num(b.on,0)+'</td><td class="num muted">'+num(r.p.ref,0)+'</td>'+
         '<td>'+kpill(b.st)+'</td><td class="mono muted">'+esc(fmtDate(r.last))+'</td></tr>');
    }
    var more = rows.length>200 ? '<div class="cb muted" style="font-size:12px">Showing the top 200 of '+rows.length+' parts that moved.</div>' : '';
    paintBig($("#dm_out"), function(n,partial){
      return '<div class="tw"><table'+(partial?'':' class="flt"')+'>'+thead+R.slice(0,n).join('')+'</tbody></table></div>'+more;
    }, R.length, function(){ wireFilters(); });
  }
  $("#dm_p").onchange=run; $("#dm_s").oninput=run; run();
};

/* ---------- ONGOING PURCHASE / REQUIRED ---------------------------
   The second handwritten note: once a shortage is approved and the qty
   confirmed, Excel must show that this part has a PR against it, with
   the supplier number. This screen is that tab — shortage on the left,
   PR and supplier on the right, both editable by the store. */
function vPurch(){
  var h=head("Ongoing Purchase / Required",
    isAdmin()?"What the lab is short of, and what has been raised against it. Fill in the PR number and supplier as they are issued.":
              "What the lab is short of, and what has been raised against it.");
  var book=shortageBook(), P=(DB.purch||[]).slice(0), i;
  var open=0; for(i=0;i<P.length;i++) if(P[i].stage!=="RECEIVED") open++;

  h+='<div class="tiles">'+
     tile("r","Parts short right now",book.length,"across all open requests")+
     tile("a","On the purchase tab",P.length,open+" still open")+
     tile("w","Total shortfall qty",(function(){var t=0;for(i=0;i<book.length;i++)t+=book[i].qty;return num(t,0);})(),"units to be bought")+
     '</div>';

  h+='<div class="card"><h3>Shortfall across every open request'+
     (isAdmin()?'<span class="sp"></span><button class="btn sec sm" id="pu_pull">Add all shortfalls to the purchase tab</button>':'')+
     '</h3>';
  if(!book.length){
    h+='<div class="empty"><b>Nothing is short</b>Every open request can be met from stock.</div>';
  } else {
    h+='<div class="tw"><table><thead><tr><th>Part</th><th>Description</th><th class="num">Short by</th>'+
       '<th>Requests</th><th>Who is waiting</th><th>Already raised</th>'+(isAdmin()?'<th></th>':'')+
       '</tr></thead><tbody>';
    for(i=0;i<book.length;i++){ var s=book[i], got=purchFor(s.pn);
      var prs=[]; for(var g=0;g<got.length;g++) if(got[g].pr) prs.push(got[g].pr);
      h+='<tr><td class="mono">'+esc(s.pn)+(s.newPart?' <span class="pill k-b">NEW PART</span>':'')+'</td>'+
         '<td>'+esc(s.d)+'</td><td class="num"><b style="color:#dc7361">'+num(s.qty,0)+'</b></td>'+
         '<td class="mono" style="font-size:12px">'+esc(s.reqs.join(", "))+'</td>'+
         '<td style="font-size:12.5px">'+esc(s.who.join(", "))+'</td>'+
         '<td class="mono" style="font-size:12px">'+(prs.length?esc(prs.join(", ")):'<span class="muted">&mdash;</span>')+'</td>'+
         (isAdmin()?'<td class="num"><button class="btn sec sm" data-pu-add="'+esc(s.pn)+'">Add</button></td>':'')+
         '</tr>';
    }
    h+='</tbody></table></div>';
  }
  h+='</div>';

  h+='<div class="card"><h3>Purchase tab &mdash; what is on order</h3>';
  if(!P.length){
    h+='<div class="empty"><b>Nothing on the purchase tab yet</b>'+
       'Add a shortfall above, then fill in the PR number and supplier once purchasing issues them.</div>';
  } else {
    h+='<div class="tw"><table class="flt"><thead><tr><th>Part</th><th class="num">Required</th><th class="num">Confirmed</th>'+
       '<th>Request</th><th>PR number</th><th>Supplier no</th><th>Supplier</th><th>Stage</th>'+
       '<th class="mono">Expected</th>'+(isAdmin()?'<th></th>':'')+'</tr></thead><tbody>';
    for(i=0;i<P.length;i++){ var p=P[i];
      h+='<tr><td class="mono">'+esc(p.pn)+'</td><td class="num">'+num(p.need,0)+'</td>'+
         '<td class="num">'+num(p.conf,0)+'</td><td class="mono" style="font-size:12px">'+esc(p.req||"—")+'</td>'+
         '<td class="mono">'+esc(p.pr||"—")+'</td><td class="mono">'+esc(p.supNo||"—")+'</td>'+
         '<td>'+esc(p.sup||"—")+'</td><td>'+kpill(p.stage)+'</td>'+
         '<td class="mono muted">'+esc(p.eta?fmtDate(p.eta):"—")+'</td>'+
         (isAdmin()?'<td class="num"><button class="btn sec sm" data-pu-edit="'+esc(p.pn)+'|'+esc(p.req||"")+'">Edit</button></td>':'')+
         '</tr>';
    }
    h+='</tbody></table></div>';
  }
  return h+'</div>';
}

/* ---------- BOM PARSING FOR COST / INVOICE ------------------------
   One fixed upload format, as agreed:
     Part Number (A) | Qty (B) | Cost/unit (C) | Cost (B x C)
   The fourth column is ignored on the way in and recalculated, so a
   stale Cost column in someone's spreadsheet can never quietly change
   an invoice total. */
function parseCostBom(txt){
  var L=String(txt||"").split(/\r?\n/), out=[], i;
  for(i=0;i<L.length;i++){
    var s=L[i].replace(/^\s+|\s+$/g,""); if(!s) continue;
    var f=s.split(/\t|,|;|\s{2,}/);
    var pn=String(f[0]||"").replace(/^\s+|\s+$/g,"");
    if(!pn) continue;
    if(/^(part\s*number|part\s*no|partno|part)/i.test(pn)) continue;   /* header row */
    var q=Number(String(f[1]||"").replace(/[^0-9.\-]/g,""))||0;
    var c=Number(String(f[2]||"").replace(/[^0-9.\-]/g,""))||0;
    var p=partBy(pn);
    if(!c && p) c=p.cost;                       /* fall back to the Parts tab price */
    out.push({pn:pn,q:q||1,cpu:c,d:p?p.d:""});
  }
  return out;
}
function bomTotal(rows){
  var t=0; for(var i=0;i<rows.length;i++) t += (Number(rows[i].q)||0)*(Number(rows[i].cpu)||0);
  return t;
}
/* an .hta can read a picked file off disk; a browser demo cannot, so the
   paste box is always there as the path that works everywhere */
function readLocalFile(p){
  try{
    var f=new ActiveXObject("Scripting.FileSystemObject");
    if(!f.FileExists(p)) return null;
    var s=f.OpenTextFile(p,1), t=s.ReadAll(); s.Close(); return t;
  }catch(e){ return null; }
}
function openBomPaste(cb){
  var h='<p class="muted" style="margin:0 0 12px;font-size:13px">One line per part, in this order. '+
    'Tab, comma or two spaces between the columns. A header row is ignored.</p>'+
    '<div class="hz" style="margin:0 0 10px"></div>'+
    '<div class="lbl" style="margin-bottom:6px">Part Number (A) &nbsp; Qty (B) &nbsp; Cost / unit (C)</div>'+
    (IS_HTA?'<div class="fg"><label>Pick a file (csv or txt) &mdash; or paste below</label>'+
            '<input type="file" id="bm_f"></div>':'')+
    '<div class="fg"><label>Paste the BOM</label>'+
    '<textarea id="bm_t" rows="12" placeholder="405/F8525&#9;2&#9;1250&#10;721/K7473&#9;10&#9;86"></textarea></div>';
  modal("Upload BOM", h,
    '<button class="btn sec" onclick="closeModal()">Cancel</button>'+
    '<button class="btn" id="bm_go">Load these lines</button>');
  if($("#bm_f")){
    $("#bm_f").onchange=function(){
      var t=readLocalFile(this.value);
      if(t===null){ toast("That file could not be read. Paste the lines instead.","Could not read the file",true); return; }
      $("#bm_t").value=t;
    };
  }
  $("#bm_go").onclick=function(){
    var rows=parseCostBom($("#bm_t").value);
    if(!rows.length){ toast("No part lines were found in that text.","Nothing to load",true); return; }
    closeModal(); cb(rows);
  };
}

/* ---------- COST SHEET --------------------------------------------
   The Cost sheet tab in the workbook has no formulas in it — Finance
   owns the assumptions and the lab incharge only ever types the circuit
   count. So the portal holds the arithmetic, shows every locked constant
   read-only, and prints both sheets. Printing from here rather than
   Excel is the point: the numbers on the paper are the numbers the
   portal used. */
var COSTJOB = {job:"",part:"",mach:"",bu:"",eng:"",date:"",ckt:200,lines:[]};

function vCost(){
  var h=head("Cost Sheet & Assumptions",
    "Finance owns every assumption below. The only figure the lab enters is the circuit count, which comes from the engineer's request.");
  h+='<div class="card"><h3>Job details<span class="sp"></span>'+
     '<button class="btn sec sm" id="cs_from">Fill from a request</button></h3><div class="cb">'+
     '<div class="f3">'+
       fld("Request / Job No","cs_job","text","REQ-2026-00001",0)+
       fld("Harness part no","cs_part","text","405/F8525",0)+
       fld("Machine / variant","cs_mach","text","3CX 74KW",0)+
     '</div><div class="f3">'+
       fld("Business unit","cs_bu","text","BHL INDIA",0)+
       fld("Requested by","cs_eng","text","Engineer name",0)+
       dfield("Date","cs_date",COSTJOB.date||today(),0)+
     '</div></div></div>';

  h+='<div class="card"><h3>Input<span class="sp"></span>'+
     '<span class="pill k-a">the only field you may change</span></h3><div class="cb">'+
     '<div class="fg" style="max-width:260px"><label>No of circuits change (Nos) <i>*</i></label>'+
     '<input type="number" id="cs_ckt" class="big" min="0" step="1" value="'+(Number(COSTJOB.ckt)||0)+'"></div>'+
     '<div id="cs_hrs" class="muted" style="font-size:13.5px;margin-top:-4px"></div></div></div>';

  h+='<div class="card"><h3>Material cost (BOM)<span class="sp"></span>'+
     '<button class="btn sec sm" id="cs_up">Upload BOM</button>'+
     '<button class="btn sec sm" id="cs_add">+ Add row</button></h3>'+
     '<div class="tw" style="max-height:40vh"><table><thead><tr>'+
     '<th style="width:44px">Sr</th><th>Part Number <span class="muted">(A)</span></th>'+
     '<th class="num" style="width:110px">Qty <span class="muted">(B)</span></th>'+
     '<th class="num" style="width:150px">Cost / Unit <span class="muted">(C)</span></th>'+
     '<th class="num" style="width:160px">Cost <span class="muted">(B&times;C)</span></th>'+
     '<th style="width:46px"></th></tr></thead><tbody id="cs_body"></tbody></table></div></div>';

  h+='<div class="card"><h3>Calculated</h3><div class="cb">'+
     '<table class="tot"><tr><td class="k">Material cost (BOM)</td><td class="v" id="cs_mat">0.00</td></tr>'+
     '<tr><td class="k">Harness assembly cost</td><td class="v" id="cs_asm">0.00</td></tr>'+
     '<tr><td class="k">Transportation cost</td><td class="v" id="cs_trn">0.00</td></tr>'+
     '<tr class="grand"><td class="k">TOTAL COST (INR)</td><td class="v" id="cs_tot">0.00</td></tr></table>'+
     '<div style="margin-top:16px;text-align:right">'+
       '<button class="btn sec" id="cs_pa">Print Assumptions</button>'+
       '<button class="btn" id="cs_pc">Print Cost Sheet</button></div>'+
     '<div class="warn" id="cs_note"></div>'+
     '</div></div>';
  return h;
}
function csDraw(){
  var b=$("#cs_body"); if(!b) return;
  var h="", i;
  for(i=0;i<COSTJOB.lines.length;i++){
    var L=COSTJOB.lines[i], c=(Number(L.q)||0)*(Number(L.cpu)||0);
    h+='<tr><td class="num muted">'+(i+1)+'</td>'+
       '<td><input type="text" data-ci="'+i+'" data-cf="pn" value="'+esc(L.pn)+'">'+
       (L.d?'<div class="muted" style="font-size:11.5px;padding-top:3px">'+esc(L.d)+'</div>':'')+'</td>'+
       '<td><input type="number" class="num" data-ci="'+i+'" data-cf="q" value="'+esc(L.q)+'" style="text-align:right"></td>'+
       '<td><input type="number" class="num" data-ci="'+i+'" data-cf="cpu" value="'+esc(L.cpu)+'" style="text-align:right"></td>'+
       '<td class="num calc">'+inr(c)+'</td>'+
       '<td class="num"><button class="btn sec sm" data-cdel="'+i+'">&times;</button></td></tr>';
  }
  if(!COSTJOB.lines.length)
    h='<tr><td colspan="6" class="muted" style="padding:16px">No material lines yet &mdash; upload a BOM or add a row.</td></tr>';
  b.innerHTML=h;
  $$("#cs_body input").forEach(function(el){
    el.onkeyup=el.onchange=function(){
      var i=Number(el.getAttribute("data-ci")), f=el.getAttribute("data-cf");
      COSTJOB.lines[i][f] = (f==="pn") ? el.value : (Number(el.value)||0);
      if(f==="pn"){ var p=partBy(el.value); if(p){ COSTJOB.lines[i].d=p.d;
        if(!COSTJOB.lines[i].cpu) COSTJOB.lines[i].cpu=p.cost; } }
      csRefresh();
      var row=el.parentNode.parentNode, cells=row.getElementsByTagName("td");
      if(cells.length>4) cells[4].innerHTML=inr((Number(COSTJOB.lines[i].q)||0)*(Number(COSTJOB.lines[i].cpu)||0));
    };
  });
  $$("#cs_body [data-cdel]").forEach(function(bt){
    bt.onclick=function(){ COSTJOB.lines.splice(Number(bt.getAttribute("data-cdel")),1); csDraw(); csRefresh(); };
  });
}
function csGrab(){
  COSTJOB.job=$("#cs_job")?$("#cs_job").value:COSTJOB.job;
  COSTJOB.part=$("#cs_part")?$("#cs_part").value:COSTJOB.part;
  COSTJOB.mach=$("#cs_mach")?$("#cs_mach").value:COSTJOB.mach;
  COSTJOB.bu=$("#cs_bu")?$("#cs_bu").value:COSTJOB.bu;
  COSTJOB.eng=$("#cs_eng")?$("#cs_eng").value:COSTJOB.eng;
  COSTJOB.date=$("#cs_date")?dval("cs_date"):COSTJOB.date;
  COSTJOB.ckt=$("#cs_ckt")?(Number($("#cs_ckt").value)||0):COSTJOB.ckt;
}
function csRefresh(){
  csGrab();
  var r=costCalc(COSTJOB.ckt, bomTotal(COSTJOB.lines));
  if($("#cs_hrs")) $("#cs_hrs").innerHTML='&rarr; Harness assembly hours: <b style="color:#eae8e3">'+
    r.hours.toFixed(2)+'</b> Hours &nbsp;('+COSTJOB.ckt+' circuits &divide; '+COST_K.circuitsPerHr+')';
  if($("#cs_mat")) $("#cs_mat").innerHTML=inr(r.mat);
  if($("#cs_asm")) $("#cs_asm").innerHTML=inr(r.asm);
  if($("#cs_trn")) $("#cs_trn").innerHTML=inr(r.trn);
  if($("#cs_tot")) $("#cs_tot").innerHTML=inr(r.tot);
  if($("#cs_note")) $("#cs_note").innerHTML=
    'Assembly hours = circuits &divide; '+COST_K.circuitsPerHr+', derived from the two sample sheets '+
    '(100 ckt &rarr; 13.33 hrs &rarr; 16,808.15 and 200 ckt &rarr; 26.67 hrs &rarr; 33,616.30) and verified to the paisa against both. '+
    '<b>Finance still needs to confirm this ratio, and that AMC is deliberately left out of the total</b> &mdash; '+
    'AMC is printed on the assumptions sheet but not added in, which is what the workbook does today.';
  return r;
}
vCost.after=function(){
  var ids=["cs_job","cs_part","cs_mach","cs_bu","cs_eng"];
  for(var i=0;i<ids.length;i++){ if($("#"+ids[i])) $("#"+ids[i]).value=COSTJOB[ids[i].slice(3)]||""; }
  dset("cs_date", COSTJOB.date||today());
  csDraw(); csRefresh();
  $$("#cs_job,#cs_part,#cs_mach,#cs_bu,#cs_eng,#cs_date,#cs_ckt").forEach(function(el){
    el.onkeyup=el.onchange=csRefresh;
  });
  $("#cs_add").onclick=function(){ COSTJOB.lines.push({pn:"",q:1,cpu:0,d:""}); csDraw(); csRefresh(); };
  $("#cs_up").onclick=function(){ openBomPaste(function(rows){
    COSTJOB.lines=rows; csDraw(); csRefresh();
    toast(rows.length+" line(s) loaded.","BOM uploaded"); }); };
  $("#cs_from").onclick=pickRequestInto;
  $("#cs_pa").onclick=function(){ csRefresh(); printSheet("assume"); };
  $("#cs_pc").onclick=function(){ csRefresh(); printSheet("cost"); };
};

/* pull a released request straight into the cost sheet, so the lab
   incharge never retypes what the engineer already submitted */
function pickRequestInto(){
  var L=reqList(), i;
  if(!L.length){ toast("There are no requests to pull from yet.","Nothing to fill from",true); return; }
  var h='<div class="fg"><label>Request</label><select id="pr_pick">';
  for(i=0;i<L.length;i++)
    h+='<option value="'+esc(L[i].no)+'">'+esc(L[i].no)+' — '+esc(L[i].harness)+' — '+esc(L[i].byName)+'</option>';
  h+='</select></div><p class="muted" style="font-size:12.5px;margin:10px 0 0">'+
     'This fills the job details, the circuit count the engineer entered, and every BOM line with its price. '+
     'Everything stays editable afterwards.</p>';
  modal("Fill from a request",h,
    '<button class="btn sec" onclick="closeModal()">Cancel</button>'+
    '<button class="btn" id="pr_go">Fill</button>');
  $("#pr_go").onclick=function(){
    var R=reqIndex(), r=R[$("#pr_pick").value]; if(!r) return;
    COSTJOB.job=r.no; COSTJOB.part=r.harness; COSTJOB.mach=r.machine;
    COSTJOB.bu=r.bu; COSTJOB.eng=r.byName; COSTJOB.date=today();
    COSTJOB.ckt=Number(r.circ)||COSTJOB.ckt;
    COSTJOB.lines=[];
    for(var i=0;i<r.lines.length;i++){
      var l=r.lines[i], p=l.pid?partById(l.pid):partBy(l.pn);
      COSTJOB.lines.push({pn:l.pn,q:Number(l.q)||0,cpu:Number(l.cost)||(p?p.cost:0),d:l.d||(p?p.d:"")});
    }
    closeModal(); render();
    toast(r.no+" loaded with "+r.lines.length+" BOM line(s).","Filled from request");
  };
}

/* ---------- PRINT ENGINE ------------------------------------------
   The sheets are built into a hidden #pz block, the body gets a print
   class, and window.print() runs. Screen CSS hides #pz; the print
   stylesheet hides everything except #pz. That is how one .hta can
   print three quite different documents without a second window. */
function pzOpen(cls, html){
  var z=$("#pz"); if(!z) return;
  z.innerHTML=html;
  document.body.className=cls;
  try{ window.print(); }catch(e){}
  document.body.className="";
}
function xlRow(a,b,cls){ return '<tr><td class="'+(cls||"")+'">'+a+'</td><td class="'+(cls||"")+' r">'+b+'</td></tr>'; }

function printSheet(which){
  var r=costCalc(COSTJOB.ckt, bomTotal(COSTJOB.lines));
  var meta='Job '+esc(COSTJOB.job||"—")+' &middot; Harness '+esc(COSTJOB.part||"—")+
           ' &middot; '+esc(fmtDate(COSTJOB.date||today()));
  if(which==="assume"){
    var h='<p class="docttl">Harness Assembly Cost &mdash; Assumptions</p>'+
      '<p class="docsub">JCB India &middot; EDS Lab &middot; '+meta+'</p>'+
      '<table class="xl">'+
      '<tr><td class="banner" colspan="6">Assumptions</td></tr>'+
      '<tr><td class="grn" colspan="6">Harness Assembly Cost</td></tr>'+
      '<tr><td class="org" colspan="2">Cost of Machine / Per hr rate</td><td class="org"></td>'+
          '<td class="org" colspan="2">Inputs</td><td class="org"></td></tr>'+
      '<tr><td colspan="2">Cost of Machine (Stripping cutting + Pull force)</td><td class="r">'+num(COST_K.machineCost,0)+'</td>'+
          '<td colspan="2">No of circuits change</td><td class="inputcell">'+num(r.ckt,0)+'</td></tr>'+
      '<tr><td colspan="2">Depreciation PA</td><td class="r">'+num(COST_K.depreciationPA,0)+'</td>'+
          '<td colspan="2">Harness assembly Hours</td><td class="r">'+r.hours.toFixed(2)+'</td></tr>'+
      '<tr><td class="rose" colspan="2">Proto Harness Per Hrs</td><td class="rose r">'+COST_K.protoPerHrs+'</td>'+
          '<td colspan="2"></td><td></td></tr>'+
      '<tr><td class="yel b" colspan="2">Capacity / Standard Available HRS</td><td class="yel"></td><td colspan="2"></td><td></td></tr>'+
      '<tr><td class="yel" colspan="2">NO of HRS / Day</td><td class="yel r">'+COST_K.hrsPerDay+'</td><td colspan="2"></td><td></td></tr>'+
      '<tr><td class="yel" colspan="2">Days / Month</td><td class="yel r">'+COST_K.daysPerMonth+'</td><td colspan="2"></td><td></td></tr>'+
      '<tr><td class="yel" colspan="2">Month PA</td><td class="yel r">'+COST_K.monthsPA+'</td>'+
          '<td class="org" colspan="2">Electricity</td><td class="org"></td></tr>'+
      '<tr><td class="yel b" colspan="2">Total Standard Available Hrs PA</td><td class="yel r b">'+num(COST_K.stdHrsPA,0)+'</td>'+
          '<td colspan="2">No of KWH per HR</td><td class="r">'+COST_K.kwhPerHr+'</td></tr>'+
      '<tr><td class="org" colspan="2">Manpower Cost</td><td class="org"></td>'+
          '<td colspan="2">No of Std HRS PA</td><td class="r">'+num(COST_K.stdHrsPA,0)+'</td></tr>'+
      '<tr><td colspan="2">No of Employee / Technician</td><td class="r">'+COST_K.technicians+'</td>'+
          '<td colspan="2">Total KWH PA</td><td class="r">'+num(COST_K.totalKwhPA,0)+'</td></tr>'+
      '<tr><td colspan="2">Per hour rate 1236 INR</td><td class="r">'+COST_K.ratePerHour+'</td>'+
          '<td colspan="2">Rate / KWH</td><td class="r">'+COST_K.ratePerKwh+'</td></tr>'+
      '<tr><td class="rose" colspan="2">Total Manpower cost</td><td class="rose r b">'+num(r.man,0)+'</td>'+
          '<td colspan="2">Total cost</td><td class="r">'+num(COST_K.elecTotalCost,0)+'</td></tr>'+
      '<tr><td class="rose" colspan="2">Total Manpower cost per Hrs</td><td class="rose r">'+r.manHr.toFixed(2)+'</td>'+
          '<td class="rose" colspan="2">Total cost per hrs</td><td class="rose r">90</td></tr>'+
      '<tr><td class="yel red" colspan="2">AMC of Machine</td><td class="yel red r">Required AMC cost</td>'+
          '<td colspan="2">Cost of machine Utilisation</td><td class="r">'+r.mach.toFixed(2)+'</td></tr>'+
      '<tr><td class="yel red" colspan="2">AMC Per Hours</td><td class="yel red r">'+COST_K.amcPerHours+'</td>'+
          '<td colspan="2">Manpower Cost</td><td class="r">'+num(r.man,0)+'</td></tr>'+
      '<tr><td class="yel" colspan="2"></td><td class="yel r">1</td>'+
          '<td colspan="2">Electricity</td><td class="r">'+r.elec.toFixed(2)+'</td></tr>'+
      '<tr><td class="brown c" colspan="4">Harness Assembly Cost</td>'+
          '<td class="brown r">'+r.asm.toFixed(2)+'</td><td class="brown">INR</td></tr>'+
      '<tr><td class="brown c" colspan="4">Transportation cost</td>'+
          '<td class="brown r">'+COST_K.transport+'</td><td class="brown">INR</td></tr>'+
      '</table>'+
      '<p class="fnote">AMC is shown above and is deliberately not included in the Harness Assembly Cost, '+
      'matching the Finance workbook. Assembly hours = circuits &divide; '+COST_K.circuitsPerHr+'.</p>'+
      '<table class="sigrow"><tr><td><div class="sigline">Prepared by (Lab Incharge)</div></td>'+
      '<td><div class="sigline">Checked by (Finance)</div></td></tr></table>';
    pzOpen("pA",h);
    return;
  }
  var rows="", i;
  for(i=0;i<COSTJOB.lines.length;i++){
    var L=COSTJOB.lines[i], c=(Number(L.q)||0)*(Number(L.cpu)||0);
    rows+='<tr><td class="c">'+(i+1)+'</td><td>'+esc(L.pn)+'</td>'+
      '<td class="r">'+num(L.q,0)+'</td><td class="r">'+num(L.cpu,2)+'</td>'+
      '<td class="r">'+num(c,2)+'</td></tr>';
  }
  if(!COSTJOB.lines.length) rows='<tr><td class="c" colspan="5">&mdash; no material lines &mdash;</td></tr>';
  var ch='<p class="docttl">Harness Cost Sheet</p>'+
    '<p class="docsub">JCB India &middot; EDS Lab &middot; '+meta+'</p>'+
    '<table class="xl" style="margin-bottom:14px">'+
    '<tr><td class="ltyel b" style="width:150px">Request / Job No</td><td>'+esc(COSTJOB.job||"&nbsp;")+'</td>'+
        '<td class="ltyel b" style="width:150px">Business Unit</td><td>'+esc(COSTJOB.bu||"&nbsp;")+'</td></tr>'+
    '<tr><td class="ltyel b">Harness Part No</td><td>'+esc(COSTJOB.part||"&nbsp;")+'</td>'+
        '<td class="ltyel b">Requested by</td><td>'+esc(COSTJOB.eng||"&nbsp;")+'</td></tr>'+
    '<tr><td class="ltyel b">Machine / Variant</td><td>'+esc(COSTJOB.mach||"&nbsp;")+'</td>'+
        '<td class="ltyel b">No of circuits change</td><td class="b">'+num(r.ckt,0)+' Nos</td></tr>'+
    '</table>'+
    '<table class="xl"><tr><td class="org c" colspan="5">Material Cost</td></tr>'+
    '<tr><td class="rose c b" style="width:44px">Sr</td><td class="rose b">Part Number (A)</td>'+
    '<td class="rose b r" style="width:90px">Qty (B)</td><td class="rose b r" style="width:120px">Cost / Unit (C)</td>'+
    '<td class="rose b r" style="width:130px">Cost (B&times;C)</td></tr>'+rows+
    '<tr><td class="ltyel b" colspan="4">Total Material Cost</td><td class="ltyel b r">'+num(r.mat,2)+'</td></tr></table>'+
    '<table class="xl" style="margin-top:14px">'+
    '<tr><td class="grn" colspan="2">Summary</td></tr>'+
    '<tr><td>Material cost (BOM)</td><td class="r" style="width:180px">'+num(r.mat,2)+'</td></tr>'+
    '<tr><td>Harness assembly cost <span style="color:#555">(as per Finance assumptions)</span></td><td class="r">'+num(r.asm,2)+'</td></tr>'+
    '<tr><td>Transportation cost <span style="color:#555">(at actual)</span></td><td class="r">'+num(r.trn,2)+'</td></tr>'+
    '<tr><td class="brown">TOTAL COST</td><td class="brown r">'+num(r.tot,2)+'</td></tr></table>'+
    '<table class="sigrow"><tr><td><div class="sigline">Prepared by (Lab Incharge)</div></td>'+
    '<td><div class="sigline">Approved by (Finance)</div></td></tr></table>';
  pzOpen("pC",ch);
}

/* ---------- INVOICE -----------------------------------------------
   Number runs IDC EDS/26-27/001 and restarts at 001 every 1 April,
   because that is when the Indian financial year turns over. It is
   generated automatically and then left editable, as agreed. */
function fyLabel(d){
  var y=d.getFullYear(), m=d.getMonth();        /* 0 = January, so April is 3 */
  var start = (m>=3) ? y : y-1;
  return ("0"+(start%100)).slice(-2)+"-"+("0"+((start+1)%100)).slice(-2);
}
function nextInvNo(){
  var pre="IDC EDS/"+fyLabel(new Date())+"/", L=DB.invs||[], max=0, i;
  for(i=0;i<L.length;i++){
    var s=String(L[i].no||"");
    if(s.indexOf(pre)!==0) continue;
    var n=Number(s.slice(pre.length).replace(/[^0-9]/g,""))||0;
    if(n>max) max=n;
  }
  var seq="000"+(max+1);
  return pre+seq.slice(seq.length-3);
}
/* every name this lab has already sent an invoice to, plus the roster —
   "recurring and available", as asked */
function nameBook(field){
  var out=[], seen={}, L=DB.invs||[], i;
  for(i=0;i<L.length;i++){
    var v=String(L[i][field]||"").replace(/^\s+|\s+$/g,"");
    if(v && !seen[v.toUpperCase()]){ seen[v.toUpperCase()]=1; out.push(v); }
  }
  for(i=0;i<DB.users.length;i++){
    var n=DB.users[i].n;
    if(n && !seen[n.toUpperCase()]){ seen[n.toUpperCase()]=1; out.push(n); }
  }
  return out;
}
function dataList(id, items){
  var h='<datalist id="'+id+'">', i;
  for(i=0;i<items.length && i<300;i++) h+='<option value="'+esc(items[i])+'"></option>';
  return h+'</datalist>';
}
/* a labelled field with the manager's blue guidance text kept as the
   hint under the box, so whoever fills it in knows what belongs there */
function gfld(label,id,type,ph,guide,list){
  return '<div class="fg"><label>'+esc(label)+'</label>'+
    '<input type="'+type+'" id="'+id+'" placeholder="'+esc(ph||"")+'"'+(list?' list="'+list+'"':'')+'>'+
    (guide?'<span class="guide">'+esc(guide)+'</span>':'')+'</div>';
}

/* An .hta can display a picture straight off the disk, which is what makes
   "the uploaded harness label should be visible here" possible at all without
   a server. A browser cannot (file:// from a page is blocked), so in demo mode
   the path is shown as text instead of a broken image icon. */
function fileUrl(p){
  var s=String(p||"").replace(/^\s+|\s+$/g,"");
  if(!s) return "";
  if(/^(https?|file):/i.test(s)) return s;
  return "file:///"+s.replace(/\\/g,"/").replace(/ /g,"%20");
}
function imgList(v){
  var out=[], L=String(v||"").split(";"), i;
  for(i=0;i<L.length;i++){
    var p=L[i].replace(/^\s+|\s+$/g,"");
    if(p) out.push(p);
  }
  return out;
}
function imgName(p){
  var s=String(p||"").replace(/\\/g,"/");
  var i=s.lastIndexOf("/");
  return i>=0 ? s.slice(i+1) : s;
}

var INV = null;
function invBlank(){
  return {no:nextInvNo(),date:today(),to:"",cc:"Mudassir Shaikh",from:"",ext:"",mob:"",
          harness:"",job:"",bu:"",buc:"",cost:"",app:"",details:"",circ:0,dcc:"",dcm:"",
          recd:today(),start:today(),done:"",mat:0,asm:0,trn:COST_K.transport,tot:0,
          ref:"",img:"",status:"DRAFT",notes:"",lines:[]};
}

function vInvoice(){
  if(!INV) INV=invBlank();
  var toBook=nameBook("to"), fromBook=nameBook("from"), dccBook=nameBook("dcc");
  var h=head("Create Invoice","Everything that can be filled in from the request is filled in, and nothing is locked — change anything before you print.");
  h+=dataList("dl_to",toBook)+dataList("dl_from",fromBook)+dataList("dl_dcc",dccBook);

  h+='<div class="card"><h3>Invoice<span class="sp"></span>'+
     '<button class="btn sec sm" id="iv_from">Fill from a request</button>'+
     '<button class="btn sec sm" id="iv_new">Start a new one</button></h3><div class="cb">'+
     '<div class="f3">'+
       gfld("Invoice number","iv_no","text","IDC EDS/26-27/001","Generated automatically, next after the last one. Editable.")+
       dfield("Invoice date","iv_date",INV.date,0)+
       gfld("Reference request","iv_ref","text","REQ-2026-00001","The request this job came from.")+
     '</div>'+
     '<div class="f3">'+
       gfld("TO","iv_to","text","Shashank Goel","Receiver's name.","dl_to")+
       gfld("CC","iv_cc","text","Mudassir Shaikh","Usually Mudassir Shaikh.")+
       gfld("From","iv_fromn","text","Samir Khanduri / Sujay Gorde","Whoever is sending it. Autofills from previous invoices.","dl_from")+
     '</div>'+
     '<div class="f3">'+
       gfld("From — Ext No","iv_ext","text","4107 / 5172","")+
       gfld("From — Mobile","iv_mob","text","7720047022 / 9011545252","")+
       gfld("DC Contact & Mobile Number","iv_dcc","text","Mahendra M","Receiver's name.","dl_dcc")+
     '</div>'+
     '<div class="f2">'+
       gfld("Harness Part Number","iv_harn","text","405/F8525, 721/K7473","All part numbers being sent at one time.")+
       gfld("Job Description","iv_job","text","Proto harness build","")+
     '</div>'+
     '<div class="f3">'+
       gfld("Business Unit","iv_bu","text","BHL INDIA","Business unit name.")+
       gfld("Business Unit contact","iv_buc","text","Shashank Goel","Receiver's name, or whoever leads the project.")+
       gfld("Cost Center BU","iv_cc2","text","IDC00005","Cost centre as per SAP.")+
     '</div>'+
     '<div class="f2">'+
       gfld("Application description","iv_app","text","Functional Prototype / BHL Christmas launch","Reason for the change.")+
       gfld("No of circuits","iv_circ","number","200","Total across all the parts being sent — this drives the assembly cost.")+
     '</div>'+
     '<div class="fg"><label>Details of request</label>'+
       '<textarea id="iv_det" rows="3" placeholder="Reason for change"></textarea>'+
       '<span class="guide">Reason for the change.</span></div>'+
     '<div class="f3">'+
       dfield("Job Received","iv_recd",INV.recd,0)+
       dfield("Start Date","iv_start",INV.start,0)+
       dfield("Completion Date","iv_done",INV.done,0)+
     '</div>'+
     '<div class="fg"><label>Harness label image (for reference)</label>'+
       (IS_HTA?'<input type="file" id="iv_img">':'<input type="text" id="iv_img" placeholder="Path or note — file picking works in the .hta on a desktop">')+
       '<span class="guide">Optional. Anyone can attach a picture for reference; it is noted on the invoice.</span></div>'+
     '<div id="iv_imgn" class="muted" style="font-size:12px"></div>'+
     '</div></div>';

  h+='<div class="card"><h3>Material (BOM)<span class="sp"></span>'+
     '<button class="btn sec sm" id="iv_up">Upload BOM</button>'+
     '<button class="btn sec sm" id="iv_proc">Add process cost</button></h3>'+
     '<div class="tw" style="max-height:34vh"><table><thead><tr><th style="width:44px">Sr</th>'+
     '<th>Part Number <span class="muted">(A)</span></th><th class="num" style="width:100px">Qty <span class="muted">(B)</span></th>'+
     '<th class="num" style="width:140px">Cost / Unit <span class="muted">(C)</span></th>'+
     '<th class="num" style="width:150px">Cost <span class="muted">(B&times;C)</span></th>'+
     '<th style="width:46px"></th></tr></thead><tbody id="iv_body"></tbody></table></div>'+
     '<div class="cb" style="border-top:1px solid #31353c">'+
     '<table class="tot"><tr><td class="k">BOM cost</td><td class="v" id="iv_mat">0.00</td></tr>'+
     '<tr><td class="k">Harness assembly cost <span class="muted" id="iv_asmn"></span></td><td class="v" id="iv_asm">0.00</td></tr>'+
     '<tr><td class="k">Transport cost</td><td class="v"><input type="number" id="iv_trn" class="tin" step="0.01" value="'+(INV.trn||0)+'"></td></tr>'+
     '<tr class="grand"><td class="k">TOTAL COST (INR)</td><td class="v" id="iv_tot">0.00</td></tr></table>'+
     '<div style="margin-top:16px;text-align:right">'+
       '<button class="btn sec" id="iv_prev">Print preview</button>'+
       '<button class="btn sec" id="iv_dl">Download invoice</button>'+
       '<button class="btn" id="iv_save">Save invoice</button></div>'+
     '</div></div>';
  return h;
}
function ivGrab(){
  function v(id){ var e=$("#"+id); return e?e.value:""; }
  INV.no=v("iv_no"); INV.date=dval("iv_date"); INV.ref=v("iv_ref");
  INV.to=v("iv_to"); INV.cc=v("iv_cc"); INV.from=v("iv_fromn");
  INV.ext=v("iv_ext"); INV.mob=v("iv_mob"); INV.dcc=v("iv_dcc");
  INV.harness=v("iv_harn"); INV.job=v("iv_job");
  INV.bu=v("iv_bu"); INV.buc=v("iv_buc"); INV.cost=v("iv_cc2");
  INV.app=v("iv_app"); INV.circ=Number(v("iv_circ"))||0; INV.details=v("iv_det");
  INV.recd=dval("iv_recd"); INV.start=dval("iv_start"); INV.done=dval("iv_done");
  INV.trn=Number(v("iv_trn"))||0;
  INV.mat=bomTotal(INV.lines);
  var c=costCalc(INV.circ,INV.mat);
  INV.asm=c.asm;
  INV.tot=INV.mat+INV.asm+INV.trn;
  return c;
}
function ivDraw(){
  var b=$("#iv_body"); if(!b) return;
  var h="", i;
  for(i=0;i<INV.lines.length;i++){
    var L=INV.lines[i], c=(Number(L.q)||0)*(Number(L.cpu)||0);
    h+='<tr><td class="num muted">'+(i+1)+'</td>'+
       '<td><input type="text" data-ii="'+i+'" data-if="pn" value="'+esc(L.pn)+'"></td>'+
       '<td><input type="number" data-ii="'+i+'" data-if="q" value="'+esc(L.q)+'" style="text-align:right"></td>'+
       '<td><input type="number" data-ii="'+i+'" data-if="cpu" value="'+esc(L.cpu)+'" style="text-align:right"></td>'+
       '<td class="num calc">'+inr(c)+'</td>'+
       '<td class="num"><button class="btn sec sm" data-idel="'+i+'">&times;</button></td></tr>';
  }
  if(!INV.lines.length) h='<tr><td colspan="6" class="muted" style="padding:16px">No material lines &mdash; upload a BOM or fill from a request.</td></tr>';
  b.innerHTML=h;
  $$("#iv_body input").forEach(function(el){
    el.onkeyup=el.onchange=function(){
      var i=Number(el.getAttribute("data-ii")), f=el.getAttribute("data-if");
      INV.lines[i][f] = (f==="pn") ? el.value : (Number(el.value)||0);
      ivRefresh();
      var cells=el.parentNode.parentNode.getElementsByTagName("td");
      if(cells.length>4) cells[4].innerHTML=inr((Number(INV.lines[i].q)||0)*(Number(INV.lines[i].cpu)||0));
    };
  });
  $$("#iv_body [data-idel]").forEach(function(bt){
    bt.onclick=function(){ INV.lines.splice(Number(bt.getAttribute("data-idel")),1); ivDraw(); ivRefresh(); };
  });
}
function ivRefresh(){
  var c=ivGrab();
  if($("#iv_mat")) $("#iv_mat").innerHTML=inr(INV.mat);
  if($("#iv_asm")) $("#iv_asm").innerHTML=inr(INV.asm);
  if($("#iv_tot")) $("#iv_tot").innerHTML=inr(INV.tot);
  if($("#iv_asmn")) $("#iv_asmn").innerHTML= INV.circ
      ? "("+INV.circ+" circuits &rarr; "+c.hours.toFixed(2)+" hrs, Finance assumptions)"
      : "(enter the circuit count to calculate)";
}
vInvoice.after=function(){
  var map={iv_no:"no",iv_date:"date",iv_ref:"ref",iv_to:"to",iv_cc:"cc",iv_fromn:"from",
    iv_ext:"ext",iv_mob:"mob",iv_dcc:"dcc",iv_harn:"harness",iv_job:"job",iv_bu:"bu",
    iv_buc:"buc",iv_cc2:"cost",iv_app:"app",iv_circ:"circ",iv_det:"details",
    iv_recd:"recd",iv_start:"start",iv_done:"done",iv_trn:"trn"};
  for(var id in map){
    var e=$("#"+id); if(!e) continue;
    /* date fields carry their own formatted display, so never stamp raw ISO into them */
    if(e.className==="dt"){ dset(id, INV[map[id]]||""); continue; }
    e.value=INV[map[id]]||(map[id]==="circ"||map[id]==="trn"?0:"");
  }
  drawShots();
  ivDraw(); ivRefresh();
  $$("#iv_no,#iv_date,#iv_ref,#iv_to,#iv_cc,#iv_fromn,#iv_ext,#iv_mob,#iv_dcc,#iv_harn,#iv_job,#iv_bu,#iv_buc,#iv_cc2,#iv_app,#iv_circ,#iv_det,#iv_recd,#iv_start,#iv_done,#iv_trn")
    .forEach(function(el){ el.onkeyup=el.onchange=ivRefresh; });
  if($("#iv_img")) $("#iv_img").onchange=function(){
    var p=String(this.value||"").replace(/^\s+|\s+$/g,"");
    if(!p) return;
    var have=imgList(INV.img);
    if(have.indexOf(p)<0){ have.push(p); INV.img=have.join(";"); }
    try{ this.value=""; }catch(e){}
    drawShots();
    toast(imgName(p)+" attached.","Image added");
  };
  $("#iv_new").onclick=function(){ INV=invBlank(); render(); toast("Blank invoice "+INV.no+" started.","New invoice"); };
  $("#iv_up").onclick=function(){ openBomPaste(function(rows){
    INV.lines=rows; ivDraw(); ivRefresh(); toast(rows.length+" line(s) loaded.","BOM uploaded"); }); };
  $("#iv_proc").onclick=function(){
    ivGrab();
    if(!INV.circ){ toast("Enter the circuit count first — the assembly cost is worked out from it.","No circuits yet",true); return; }
    var c=costCalc(INV.circ,INV.mat);
    modal("Process cost",
      '<p class="muted" style="margin:0 0 12px;font-size:13px">Worked out from the Finance assumptions. '+
      'Nothing here is editable — only the circuit count changes it.</p>'+
      '<table class="tot">'+
      xlRow("Circuits",num(c.ckt,0))+
      xlRow("Assembly hours (circuits &divide; "+COST_K.circuitsPerHr+")",c.hours.toFixed(2))+
      xlRow("Cost of machine utilisation",inr(c.mach))+
      xlRow("Manpower cost",inr(c.man))+
      xlRow("Electricity",inr(c.elec))+
      '<tr class="grand"><td class="k">Harness assembly cost</td><td class="v">'+inr(c.asm)+'</td></tr>'+
      '</table>'+
      '<p class="muted" style="font-size:12px;margin-top:12px">AMC is excluded, matching the Finance workbook.</p>',
      '<button class="btn sec" onclick="closeModal()">Close</button>'+
      '<button class="btn" id="iv_pcok">Apply to this invoice</button>');
    $("#iv_pcok").onclick=function(){ ivRefresh(); closeModal(); toast("Assembly cost applied.","Process cost added"); };
  };
  $("#iv_from").onclick=invFromRequest;
  $("#iv_prev").onclick=function(){ ivRefresh(); printInvoice(INV); };
  $("#iv_dl").onclick=function(){ ivRefresh(); dl(String(INV.no).replace(/[^A-Za-z0-9._-]/g,"_")+".html", invoiceHtml(INV,true)); };
  $("#iv_save").onclick=function(){
    ivRefresh();
    if(!INV.to){ toast("TO is required before an invoice can be saved.","Missing information",true); $("#iv_to").focus(); return; }
    var L=DB.invs||[], i, dup=false;
    for(i=0;i<L.length;i++) if(L[i].no===INV.no) dup=true;
    if(dup){
      Store.updateInvoice(INV.no,{date:INV.date,to:INV.to,cc:INV.cc,from:INV.from,ext:INV.ext,mob:INV.mob,
        harness:INV.harness,job:INV.job,bu:INV.bu,buc:INV.buc,cost:INV.cost,app:INV.app,
        details:INV.details,circ:INV.circ,dcc:INV.dcc,dcm:INV.dcm,recd:INV.recd,start:INV.start,
        done:INV.done,mat:INV.mat,asm:INV.asm,trn:INV.trn,tot:INV.tot,ref:INV.ref,img:INV.img,
        status:"ISSUED",notes:INV.notes});
      toast(INV.no+" updated.","Invoice saved");
    } else {
      INV.status="ISSUED";
      Store.pushInvoice(INV);
      toast(INV.no+" saved. It counts towards revenue on the manager dashboard.","Invoice saved");
    }
    bust(); VIEW="invlist"; renderNav(); render();
  };
};
/* Thumbnails under the field, each removable. In the .hta these are the real
   pictures; in a browser demo the file cannot be read, so the name is shown
   in a placeholder tile rather than a broken image. */
function drawShots(){
  var box=$("#iv_imgn"); if(!box) return;
  var L=imgList(INV.img), h="", i;
  for(i=0;i<L.length;i++){
    h+='<span class="shot">'+
       (IS_HTA?'<img src="'+esc(fileUrl(L[i]))+'" alt="">'
              :'<span class="shotph">'+esc(imgName(L[i]))+'</span>')+
       '<button type="button" class="shotx" data-img="'+esc(L[i])+'" title="Remove">&times;</button>'+
       '<em>'+esc(imgName(L[i]))+'</em></span>';
  }
  if(!L.length) h='<span class="muted" style="font-size:12px">No images attached yet.</span>';
  box.innerHTML=h;
  $$("#iv_imgn [data-img]").forEach(function(b){
    b.onclick=function(){
      var keep=[], L2=imgList(INV.img), want=b.getAttribute("data-img");
      for(var k=0;k<L2.length;k++) if(L2[k]!==want) keep.push(L2[k]);
      INV.img=keep.join(";");
      drawShots();
    };
  });
}

function invFromRequest(){
  var L=reqList(), i;
  if(!L.length){ toast("There are no requests to pull from yet.","Nothing to fill from",true); return; }
  var h='<div class="fg"><label>Request</label><select id="if_pick">';
  for(i=0;i<L.length;i++)
    h+='<option value="'+esc(L[i].no)+'">'+esc(L[i].no)+' — '+esc(L[i].harness)+' — '+esc(L[i].byName)+'</option>';
  h+='</select></div><p class="muted" style="font-size:12.5px;margin:10px 0 0">'+
     'Fills the job details, circuit count and every BOM line. Nothing is locked afterwards.</p>';
  modal("Fill from a request",h,
    '<button class="btn sec" onclick="closeModal()">Cancel</button><button class="btn" id="if_go">Fill</button>');
  $("#if_go").onclick=function(){
    var R=reqIndex(), r=R[$("#if_pick").value]; if(!r) return;
    INV.ref=r.no; INV.harness=r.harness; INV.job=r.scope||r.machine;
    INV.bu=r.bu; INV.buc=r.buc; INV.cost=r.cc; INV.dcc=r.dcc;
    INV.app=r.stage?("Build stage: "+r.stage):""; INV.details=r.scope;
    INV.circ=Number(r.circ)||0; INV.to=INV.to||r.buc;
    INV.recd=r.on; INV.start=r.on; INV.done=today();
    INV.lines=[];
    for(var i=0;i<r.lines.length;i++){
      var l=r.lines[i], p=l.pid?partById(l.pid):partBy(l.pn);
      INV.lines.push({pn:l.pn,q:Number(l.rel)||Number(l.q)||0,
        cpu:Number(l.cost)||(p?p.cost:0),d:l.d||(p?p.d:"")});
    }
    closeModal(); render(); toast(r.no+" loaded.","Filled from request");
  };
}

/* The printed invoice deliberately mirrors the Final Invoice tab in the
   workbook — same blocks in the same places — so that what comes off the
   printer is recognisable to everyone who already uses that sheet. */
function invoiceHtml(v, standalone){
  var rows="", i, c;
  for(i=0;i<(v.lines||[]).length;i++){
    var L=v.lines[i]; c=(Number(L.q)||0)*(Number(L.cpu)||0);
    rows+='<tr><td class="c">'+(i+1)+'</td><td>'+esc(L.pn)+'</td><td class="r">'+num(L.q,0)+
      '</td><td class="r">'+num(L.cpu,2)+'</td><td class="r">'+num(c,2)+'</td></tr>';
  }
  if(!rows) rows='<tr><td class="c" colspan="5">&mdash; no material lines &mdash;</td></tr>';
  var body=
    '<p class="docttl">EDS Lab &mdash; Job Invoice</p>'+
    '<p class="docsub">JCB India &middot; Pune &middot; Design Centre</p>'+
    '<table class="xl">'+
      '<tr><td colspan="2" style="width:56%"><b>To:</b> '+esc(v.to||"")+'<br><br>'+
          '<b>Cc:</b> '+esc(v.cc||"")+'</td>'+
        '<td colspan="2"><b>From</b> : '+esc(v.from||"")+'<br>'+
          '<b>Ext No</b> : '+esc(v.ext||"")+'<br>'+
          '<b>Mobile</b> : '+esc(v.mob||"")+'</td></tr>'+
    '</table>'+
    '<table class="xl" style="margin-top:10px">'+
      '<tr><td class="ltyel b" style="width:20%">Job No</td><td class="b red" style="width:36%">'+esc(v.no||"")+'</td>'+
          '<td class="ltyel b" style="width:22%">DC Contact</td><td class="b">'+esc(v.dcc||"")+'</td></tr>'+
      '<tr><td class="ltyel b">Harness Part Nos.</td><td>'+esc(v.harness||"")+'</td>'+
          '<td class="ltyel b">Job Received</td><td class="r">'+esc(v.recd?fmtDate(v.recd):"")+'</td></tr>'+
      '<tr><td class="ltyel b">Job Description</td><td>'+esc(v.job||"")+'</td>'+
          '<td class="ltyel b">Start Date</td><td class="r">'+esc(v.start?fmtDate(v.start):"")+'</td></tr>'+
      '<tr><td class="ltyel b">Business Unit</td><td>'+esc(v.bu||"")+'</td>'+
          '<td class="ltyel b">Completion Date</td><td class="r">'+esc(v.done?fmtDate(v.done):"")+'</td></tr>'+
      '<tr><td class="ltyel b">Business Unit Contact</td><td>'+esc(v.buc||"")+'</td>'+
          '<td class="ltyel b">No of circuits</td><td class="r b">'+num(v.circ||0,0)+'</td></tr>'+
      '<tr><td class="ltyel b">Cost Centre / BU</td><td>'+esc(v.cost||"")+'</td>'+
          '<td class="ltyel b">Invoice Date</td><td class="r">'+esc(v.date?fmtDate(v.date):"")+'</td></tr>'+
      '<tr><td class="ltyel b">Application description</td><td colspan="3">'+esc(v.app||"")+'</td></tr>'+
      '<tr><td class="ltyel b">Details of request</td><td colspan="3">'+esc(v.details||"")+'</td></tr>'+
    '</table>'+
    '<table class="xl" style="margin-top:12px">'+
      '<tr><td class="org c" colspan="5">Material Cost (BOM)</td></tr>'+
      '<tr><td class="rose c b" style="width:44px">Sr</td><td class="rose b">Part Number (A)</td>'+
      '<td class="rose b r" style="width:80px">Qty (B)</td><td class="rose b r" style="width:110px">Cost / Unit (C)</td>'+
      '<td class="rose b r" style="width:120px">Cost (B&times;C)</td></tr>'+rows+
    '</table>'+
    '<table class="xl" style="margin-top:12px">'+
      '<tr><td class="grn" colspan="2">Description</td></tr>'+
      '<tr><td>Harness Assembly</td><td class="r" style="width:180px">'+num(v.asm||0,2)+'</td></tr>'+
      '<tr><td>BOM COST</td><td class="r">'+num(v.mat||0,2)+'</td></tr>'+
      '<tr><td class="org">Transport Cost</td><td class="org r">'+num(v.trn||0,2)+'</td></tr>'+
      '<tr><td class="brown">Total Cost (INR)</td><td class="brown r">'+num(v.tot||0,2)+'</td></tr>'+
    '</table>'+
    '<table class="xl imgblk" style="margin-top:12px"><tr><td class="ltblue c b">Harness label Images</td></tr>'+
      '<tr><td class="shotcell">'+invImagesHtml(v)+'</td></tr></table>'+
    '<table class="sigrow"><tr><td><div class="sigline">Prepared by (Lab Incharge)</div></td>'+
    '<td><div class="sigline">Received by</div></td></tr></table>';
  if(!standalone) return body;
  return '<!DOCTYPE html><html><head><meta charset="utf-8">'+
    '<meta http-equiv="X-UA-Compatible" content="IE=edge"><title>'+esc(v.no||"Invoice")+'</title><style>'+
    'body{font-family:Calibri,Segoe UI,Arial,sans-serif;font-size:12px;color:#000;background:#fff;margin:22px}'+
    'table.xl{border-collapse:collapse;width:100%}'+
    'table.xl td{border:1px solid #8A8A8A;padding:4px 6px;vertical-align:top}'+
    '.grn{background:#22B14C;color:#fff;font-weight:bold;text-align:center}'+
    '.org{background:#E8A33D;font-weight:bold}.rose{background:#E8B4B8;font-weight:bold}'+
    '.ltyel{background:#FAF4A0}.ltblue{background:#CDE3F0}'+
    '.brown{background:#7A6B3A;color:#fff;font-weight:bold}'+
    '.r{text-align:right}.c{text-align:center}.b{font-weight:bold}.red{color:#C00000}'+
    '.muted{color:#777}.docttl{font-size:17px;font-weight:bold;margin:0 0 3px}'+
    '.docsub{font-size:11px;color:#444;margin:0 0 12px}'+
    '.sigrow{margin-top:30px;width:100%}.sigrow td{border:0;padding-top:26px}'+
    '.sigline{border-top:1px solid #000;width:210px;padding-top:3px}'+
    '.shotcell{padding:8px!important;text-align:center}'+
    '.pshot{display:inline-block;vertical-align:top;margin:4px;text-align:center}'+
    '.pshot img{display:block;margin:0 auto;border:1px solid #999}'+
    '.pshot.one img{max-width:100%;max-height:120mm}'+
    '.pshot.two img{max-width:100%;max-height:78mm}'+
    '.pshot.many img{max-width:100%;max-height:52mm}'+
    '.pshot.one{width:98%}.pshot.two{width:47%}.pshot.many{width:31%}'+
    '.pshotph{display:block;border:1px dashed #999;padding:26px 10px;color:#777;font-size:11px}'+
    '</style></head><body>'+body+'</body></html>';
}
/* The printed image block. One picture gets the full page width; two share it;
   three or more tile at a third each. Heights are capped so the block never
   pushes the signature line onto a second sheet. */
function invImagesHtml(v){
  var L=imgList(v.img), i, h="";
  if(!L.length) return '<span class="muted">&nbsp;</span>';
  var cls = L.length===1 ? "one" : (L.length===2 ? "two" : "many");
  for(i=0;i<L.length && i<6;i++){
    h+='<span class="pshot '+cls+'">'+
       (IS_HTA?'<img src="'+esc(fileUrl(L[i]))+'" alt="">'
              :'<span class="pshotph">'+esc(imgName(L[i]))+'</span>')+
       '</span>';
  }
  if(L.length>6) h+='<span class="muted">+'+(L.length-6)+' more attached</span>';
  return h;
}
function printInvoice(v){ pzOpen("pI", invoiceHtml(v,false)); }

function vInvList(){
  var L=(DB.invs||[]).slice(0);
  var h=head("Invoices", isMgr()?"Every invoice the lab has issued. Revenue on the dashboard is the sum of these.":
    "Every invoice the lab has issued. Open one to reprint or edit it.");
  if(!L.length) return h+'<div class="card"><div class="empty"><b>No invoices yet</b>'+
    'Create one under Deliveries &rsaquo; Create Invoice.'+
    (isAdmin()?'<div style="margin-top:16px"><button class="btn" data-go="invoice">Create invoice</button></div>':'')+
    '</div></div>';
  L.sort(function(a,b){ return String(b.no).localeCompare(String(a.no)); });
  var tot=0, i; for(i=0;i<L.length;i++) tot+=Number(L[i].tot)||0;
  h+='<div class="tiles">'+
     tile("a","Invoices issued",L.length,"all time")+
     tile("g","Total invoiced",inrShort(tot),"sum of every invoice")+
     tile("b","This financial year",(function(){
        var p="IDC EDS/"+fyLabel(new Date())+"/", n=0;
        for(var k=0;k<L.length;k++) if(String(L[k].no).indexOf(p)===0) n++; return n;
     })(),"since 1 April")+
     '</div>';
  h+='<div class="card"><div class="tw"><table class="flt"><thead><tr><th>Invoice</th><th class="mono">Date</th><th>To</th>'+
     '<th>Business unit</th><th>Harness</th><th class="num">Circuits</th><th class="num">BOM</th>'+
     '<th class="num">Assembly</th><th class="num">Total</th><th></th></tr></thead><tbody>';
  for(i=0;i<L.length;i++){ var v=L[i];
    h+='<tr><td class="mono">'+esc(v.no)+'</td><td class="mono">'+esc(fmtDate(v.date))+'</td><td>'+esc(v.to)+'</td>'+
       '<td>'+esc(v.bu)+'</td><td class="mono" style="font-size:12px">'+esc(v.harness)+'</td>'+
       '<td class="num">'+num(v.circ,0)+'</td><td class="num">'+inrShort(v.mat)+'</td>'+
       '<td class="num">'+inrShort(v.asm)+'</td><td class="num"><b>'+inrShort(v.tot)+'</b></td>'+
       '<td class="num"><button class="btn sec sm" data-inv="'+esc(v.no)+'">Open</button></td></tr>';
  }
  return h+'</tbody></table></div></div>';
}
function openInvoice(no){
  var L=DB.invs||[], v=null, i;
  for(i=0;i<L.length;i++) if(L[i].no===no) v=L[i];
  if(!v) return;
  if(!v.lines) v.lines=[];
  var h='<dl class="kv">'+
    '<dt>To</dt><dd>'+esc(v.to)+'</dd>'+
    '<dt>Cc</dt><dd>'+esc(v.cc)+'</dd>'+
    '<dt>From</dt><dd>'+esc(v.from)+' · Ext '+esc(v.ext)+' · '+esc(v.mob)+'</dd>'+
    '<dt>Harness</dt><dd><span class="mono">'+esc(v.harness)+'</span></dd>'+
    '<dt>Business unit</dt><dd>'+esc(v.bu)+' · '+esc(v.buc)+' · cost centre <span class="mono">'+esc(v.cost)+'</span></dd>'+
    '<dt>Circuits</dt><dd>'+num(v.circ,0)+'</dd>'+
    '<dt>Dates</dt><dd>received '+esc(v.recd?fmtDate(v.recd):"—")+' · start '+esc(v.start?fmtDate(v.start):"—")+' · completed '+esc(v.done?fmtDate(v.done):"—")+'</dd>'+
    '<dt>Costs</dt><dd>BOM '+inr(v.mat)+' · assembly '+inr(v.asm)+' · transport '+inr(v.trn)+
      ' &nbsp;<b>total '+inr(v.tot)+'</b></dd>'+
    (v.ref?'<dt>From request</dt><dd class="mono">'+esc(v.ref)+'</dd>':'')+
    '</dl>';
  var f='<button class="btn sec" onclick="closeModal()">Close</button>'+
        '<button class="btn sec" data-ivprint="'+esc(no)+'">Print</button>';
  if(isAdmin()) f+='<button class="btn" data-ivedit="'+esc(no)+'">Edit</button>';
  modal(v.no, h, f);
  $$("#modal [data-ivprint]").forEach(function(b){ b.onclick=function(){ closeModal(); printInvoice(v); }; });
  $$("#modal [data-ivedit]").forEach(function(b){ b.onclick=function(){
    INV=v; closeModal(); VIEW="invoice"; renderNav(); render(); }; });
}

/* ---------- PR / PO ENTRY FORM (admin) ----------------------------
   The sixteen fields off the manager's slide, in the order the slide
   groups them. Autosuggest is fed from what is already in the
   Procurement tab, so the second PR for the same vendor or department
   is mostly typing-free. */
var PROC_STAGES=["PR RAISED","APPROVED","PO RAISED","GRN IN PROGRESS","DELIVERED (CLOSED)"];
var INVEST_TYPES=["REVENUE","CAPEX","OPEX","AMC / SERVICE"];
var PROC_TYPES=["MATERIAL","SERVICE","TOOL","SOFTWARE","CALIBRATION"];

function procBook(field){
  var L=DB.proc||[], out=[], seen={}, i;
  for(i=0;i<L.length;i++){
    var v=String(L[i][field]||"").replace(/^\s+|\s+$/g,"");
    if(v && !seen[v.toUpperCase()]){ seen[v.toUpperCase()]=1; out.push(v); }
  }
  return out;
}
function openPrPo(existingNo){
  var P=DB.proc||[], cur=null, i;
  if(existingNo) for(i=0;i<P.length;i++) if(P[i].no===existingNo) cur=P[i];
  var e=cur||{no:"",dept:"EDS",summary:"",svc:"MATERIAL",qty:1,raised:today(),raisedBy:(ME?ME.n:""),
    apprBy:"",apprDate:"",po:"",vendor:"",amt:0,stage:"PR RAISED",poDate:"",delivered:"",notes:"",
    prAmt:0,inv:"REVENUE",poApprDate:"",own:"",poCopy:""};

  function opt(list,val){
    var h="", k;
    for(k=0;k<list.length;k++) h+='<option'+(String(list[k])===String(val)?' selected':'')+'>'+esc(list[k])+'</option>';
    return h;
  }
  var h=dataList("dl_dept",procBook("dept"))+dataList("dl_vend",procBook("vendor"))+
        dataList("dl_own",procBook("own"))+dataList("dl_ttl",procBook("summary"))+
    '<div class="f3">'+
      '<div class="fg"><label>IDC Department <i>*</i></label><input type="text" id="pp_dept" list="dl_dept" value="'+esc(e.dept)+'"></div>'+
      '<div class="fg"><label>PR Number <i>*</i></label><input type="text" id="pp_no" value="'+esc(e.no)+'"'+(cur?' readonly':'')+' placeholder="800011175"></div>'+
      '<div class="fg"><label>Type</label><select id="pp_svc">'+opt(PROC_TYPES,e.svc)+'</select></div>'+
    '</div>'+
    '<div class="fg"><label>Title <i>*</i></label><input type="text" id="pp_ttl" list="dl_ttl" value="'+esc(e.summary)+'" placeholder="32 CHANNEL RELAY"></div>'+
    '<div class="f3">'+
      '<div class="fg"><label>PR Amount (INR)</label><input type="number" id="pp_pramt" step="0.01" value="'+(Number(e.prAmt)||0)+'"></div>'+
      dfield("PR Date Raised","pp_prd",e.raised,0)+
      dfield("PR Fully Approved Date","pp_prapp",e.apprDate,0)+
    '</div>'+
    '<div class="f3">'+
      '<div class="fg"><label>Investment Type</label><select id="pp_inv">'+opt(INVEST_TYPES,e.inv)+'</select></div>'+
      '<div class="fg"><label>PO Number</label><input type="text" id="pp_po" value="'+esc(e.po)+'"></div>'+
      '<div class="fg"><label>PO Amount (INR)</label><input type="number" id="pp_amt" step="0.01" value="'+(Number(e.amt)||0)+'"></div>'+
    '</div>'+
    '<div class="f3">'+
      dfield("PO Date Raised","pp_pod",e.poDate,0)+
      dfield("PO Fully Approve Date","pp_poapp",e.poApprDate,0)+
      dfield("Delivered date","pp_del",e.delivered,0)+
    '</div>'+
    '<div class="f3">'+
      '<div class="fg"><label>Ownership</label><input type="text" id="pp_own" list="dl_own" value="'+esc(e.own)+'" placeholder="Who is chasing it"></div>'+
      '<div class="fg"><label>GRN Status</label><select id="pp_stage">'+opt(PROC_STAGES,e.stage)+'</select></div>'+
      '<div class="fg"><label>Vendor</label><input type="text" id="pp_vend" list="dl_vend" value="'+esc(e.vendor)+'"></div>'+
    '</div>'+
    '<div class="f2">'+
      '<div class="fg"><label>Quantity</label><input type="number" id="pp_qty" min="0" step="1" value="'+(Number(e.qty)||0)+'"></div>'+
      '<div class="fg"><label>Upload PO copy</label>'+
        (IS_HTA?'<input type="file" id="pp_copy">':'<input type="text" id="pp_copy" value="'+esc(e.poCopy)+'" placeholder="Path — file picking works in the .hta">')+
        '<span class="guide">The path is recorded on the PR row so the copy can be found later.</span></div>'+
    '</div>'+
    '<div class="fg"><label>Remarks</label><textarea id="pp_rem" rows="2">'+esc(e.notes)+'</textarea></div>';
  modal(cur?("Edit PR "+e.no):"New PR / PO entry", h,
    '<button class="btn sec" onclick="closeModal()">Cancel</button>'+
    '<button class="btn" id="pp_save">Save</button>');
  $("#pp_save").onclick=function(){
    function v(id){ var el=$("#"+id); return el?el.value:""; }
    var no=v("pp_no").replace(/^\s+|\s+$/g,"");
    if(!no){ toast("PR Number is required.","Missing information",true); $("#pp_no").focus(); return; }
    if(!v("pp_ttl").replace(/^\s+|\s+$/g,"")){ toast("Title is required.","Missing information",true); $("#pp_ttl").focus(); return; }
    var copy = $("#pp_copy") ? $("#pp_copy").value : "";
    var fields={dept:v("pp_dept"),summary:v("pp_ttl"),svc:v("pp_svc"),qty:Number(v("pp_qty"))||0,
      raised:dval("pp_prd"),apprDate:dval("pp_prapp"),po:v("pp_po"),vendor:v("pp_vend"),
      amt:Number(v("pp_amt"))||0,stage:v("pp_stage"),poDate:dval("pp_pod"),delivered:dval("pp_del"),
      notes:v("pp_rem"),prAmt:Number(v("pp_pramt"))||0,inv:v("pp_inv"),
      poApprDate:dval("pp_poapp"),own:v("pp_own"),poCopy:copy};
    if(cur){
      var ok=Store.advanceProc(no,fields);
      if(!ok){ toast("The workbook is open somewhere, so the row could not be edited. Close it and try again.","Could not save",true); return; }
      toast(no+" updated.","PR saved");
    } else {
      var dup=false, L=DB.proc||[], i;
      for(i=0;i<L.length;i++) if(L[i].no===no) dup=true;
      if(dup){ toast("PR "+no+" already exists. Open it from the list to edit it.","Duplicate PR number",true); return; }
      var row={no:no,dept:fields.dept,summary:fields.summary,svc:fields.svc,qty:fields.qty,
        raised:fields.raised,raisedBy:(ME?ME.n:""),apprBy:"",apprDate:fields.apprDate,
        po:fields.po,vendor:fields.vendor,amt:fields.amt,stage:fields.stage,poDate:fields.poDate,
        delivered:fields.delivered,notes:fields.notes,prAmt:fields.prAmt,inv:fields.inv,
        poApprDate:fields.poApprDate,own:fields.own,poCopy:fields.poCopy};
      Store.pushProc(row);
      /* the five v6 columns are not part of the append row the v5 writer
         builds, so they are patched straight afterwards */
      Store.advanceProc(no,{prAmt:row.prAmt,inv:row.inv,poApprDate:row.poApprDate,
                            own:row.own,poCopy:row.poCopy});
      toast(no+" raised.","PR saved");
    }
    closeModal(); bust(); renderNav(); render();
  };
}

/* ---------- ONGOING PURCHASE EDIT --------------------------------- */
function openPurchEdit(pn, req){
  var P=DB.purch||[], p=null, i;
  for(i=0;i<P.length;i++) if(P[i].pn===pn && (P[i].req||"")===(req||"")) p=P[i];
  if(!p) return;
  var prs=procBook("no");
  var h=dataList("dl_pr",prs)+dataList("dl_sup",(function(){
      var L=DB.parts, o=[], s={}, k;
      for(k=0;k<L.length;k++){ var v=L[k].v; if(v && !s[v.toUpperCase()]){ s[v.toUpperCase()]=1; o.push(v); } }
      return o;
    })())+
    '<dl class="kv"><dt>Part</dt><dd class="mono">'+esc(p.pn)+'</dd>'+
    '<dt>Description</dt><dd>'+esc(p.d||"—")+'</dd>'+
    '<dt>From request</dt><dd class="mono">'+esc(p.req||"—")+'</dd></dl>'+
    '<div class="f2">'+
      '<div class="fg"><label>Quantity required</label><input type="number" id="pe_need" min="0" value="'+(Number(p.need)||0)+'"></div>'+
      '<div class="fg"><label>Quantity confirmed</label><input type="number" id="pe_conf" min="0" value="'+(Number(p.conf)||0)+'"></div>'+
    '</div>'+
    '<div class="f3">'+
      '<div class="fg"><label>PR number</label><input type="text" id="pe_pr" list="dl_pr" value="'+esc(p.pr||"")+'"></div>'+
      '<div class="fg"><label>Supplier number</label><input type="text" id="pe_supno" value="'+esc(p.supNo||"")+'"></div>'+
      '<div class="fg"><label>Supplier name</label><input type="text" id="pe_sup" list="dl_sup" value="'+esc(p.sup||"")+'"></div>'+
    '</div>'+
    '<div class="f2">'+
      '<div class="fg"><label>Stage</label><select id="pe_stage">'+
        ["REQUIRED","PR RAISED","PO RAISED","IN TRANSIT","RECEIVED"].map(function(s){
          return '<option'+(s===p.stage?' selected':'')+'>'+s+'</option>'; }).join("")+'</select></div>'+
      dfield("Expected date","pe_eta",p.eta||"",0)+
    '</div>'+
    '<div class="fg"><label>Notes</label><input type="text" id="pe_n" value="'+esc(p.notes||"")+'"></div>';
  modal("Purchase line — "+p.pn, h,
    '<button class="btn sec" onclick="closeModal()">Cancel</button><button class="btn" id="pe_go">Save</button>');
  $("#pe_go").onclick=function(){
    var ok=Store.updatePurch(p.pn,p.req||"",{
      need:Number($("#pe_need").value)||0, conf:Number($("#pe_conf").value)||0,
      pr:$("#pe_pr").value, supNo:$("#pe_supno").value, sup:$("#pe_sup").value,
      stage:$("#pe_stage").value, eta:dval("pe_eta"), notes:$("#pe_n").value});
    if(!ok){ toast("The workbook is open somewhere, so the row could not be edited. Close it and try again.","Could not save",true); return; }
    closeModal(); toast(p.pn+" updated.","Purchase line saved"); bust(); render();
  };
}
function purchAdd(pn){
  var book=shortageBook(), s=null, i;
  for(i=0;i<book.length;i++) if(String(book[i].pn).toUpperCase()===String(pn).toUpperCase()) s=book[i];
  if(!s) return false;
  var P=DB.purch||[], key=s.reqs.join(",");
  for(i=0;i<P.length;i++) if(P[i].pn===s.pn && P[i].req===key) return false;   /* already there */
  Store.pushPurch({pn:s.pn,d:s.d,need:s.qty,conf:0,req:key,by:(ME?ME.n:""),pr:"",supNo:"",sup:"",
                   stage:"REQUIRED",on:today(),eta:"",notes:s.who.join(", ")+" waiting"});
  return true;
}

/* ---------- CALIBRATION -------------------------------------------
   The one item the requirement owner was unsure about. Rather than
   guess, the tab exists and the card reads from it: with no rows the
   card says so plainly instead of showing a made-up number, so nobody
   mistakes an empty tab for "nothing is due". */
function calibDue(){
  var C=DB.calib||[], out={due:0,soon:0,total:C.length,rows:[]}, i;
  var t=new Date(); t.setHours(0,0,0,0);
  for(i=0;i<C.length;i++){
    var c=C[i]; if(!c.due){ continue; }
    var d=new Date(c.due+"T00:00:00");
    var days=Math.round((d-t)/86400000);
    if(days<0){ out.due++; out.rows.push({c:c,days:days}); }
    else if(days<=30){ out.soon++; out.rows.push({c:c,days:days}); }
  }
  out.rows.sort(function(a,b){ return a.days-b.days; });
  return out;
}
function licSoon(){
  var L=DB.lic||[], n=0, i;
  for(i=0;i<L.length;i++){
    var s=Store.licStatus(L[i].expiry);
    if(s==="Expired"||s==="Expiring Soon") n++;
  }
  return n;
}
/* "how many parts reserved and are in PR" — the upcoming-projects figure */
function upcomingCount(){
  var L=reqList(), n=0, i, j;
  for(i=0;i<L.length;i++){
    var r=L[i];
    if(r.status==="COMPLETED"||r.status==="CANCELLED"||r.status==="REJECTED") continue;
    var has=false;
    for(j=0;j<r.lines.length;j++){
      var l=r.lines[j];
      if((Number(l.resv)||0)>0 || (Number(l.q)||0)>(Number(l.rel)||0)) has=true;
    }
    if(has) n++;
  }
  return n;
}

/* ---------- MANAGER DASHBOARD -------------------------------------
   Laid out to match the manager's slide: KPI strip, revenue pie,
   PR/PO bar chart, deliveries count, ongoing and upcoming projects. */
function vMgrDash(){
  var b=balances(), P=DB.parts, i;
  var onHand=0, low=0;
  for(i=0;i<P.length;i++){
    var x=b[P[i].id]||{on:0};
    onHand+=x.on;
    if(x.st==="LOW STOCK"||x.st==="OUT OF STOCK") low++;
  }
  var INVS=DB.invs||[], rev=0;
  for(i=0;i<INVS.length;i++) rev+=Number(INVS[i].tot)||0;

  /* revenue by business unit — "all department revenue", summing invoice totals */
  var byBu={}, slices=[];
  for(i=0;i<INVS.length;i++){
    var k=String(INVS[i].bu||"UNSPECIFIED").toUpperCase();
    if(!byBu[k]){ byBu[k]={k:k,v:0}; slices.push(byBu[k]); }
    byBu[k].v += Number(INVS[i].tot)||0;
  }
  slices.sort(function(a,z){ return z.v-a.v; });

  /* PR/PO bar — counts of requests at each stage, not amounts */
  var PR=DB.proc||[], nDel=0, nPo=0, nPr=0;
  for(i=0;i<PR.length;i++){
    var s=String(PR[i].stage||"").toUpperCase();
    if(s.indexOf("DELIVERED")>=0) nDel++;
    else if(s.indexOf("PO")>=0 || s.indexOf("GRN")>=0) nPo++;
    else nPr++;
  }
  var poAmt=0; for(i=0;i<PR.length;i++) poAmt+=Number(PR[i].amt)||0;

  var L=reqList(), ongoing=0;
  for(i=0;i<L.length;i++) if(L[i].status!=="COMPLETED"&&L[i].status!=="CANCELLED"&&L[i].status!=="REJECTED") ongoing++;

  var cal=calibDue();
  var h=head("Dashboard","Live overview of electrical and controls inventory, spend and delivery");

  h+='<div class="tiles">'+
     tile("b","Materials tracked",P.length,num(onHand,0)+" units in stock")+
     tile("a","Software licences",(DB.lic||[]).length,"products tracked")+
     tile("w","Low / out of stock",low,"below reorder threshold")+
     tile("g","Invoices issued",INVS.length,"deliveries billed")+
     tile(cal.due?"r":"m","Calibration due",
        cal.total?(cal.due+cal.soon):"—",
        cal.total?(cal.due+" overdue, "+cal.soon+" within 30 days"):"Calibration tab is empty")+
     tile(licSoon()?"r":"m","Expiring licences",licSoon(),"within 45 days or expired")+
     '</div>';

  h+='<div class="split">'+
     '<div class="card half"><h3>Revenue<span class="sp"></span>'+
       '<span class="pill k-ok">'+inrShort(rev)+'</span></h3><div class="cb">'+
       '<div class="pie">'+pieSvg(slices,182)+'</div>'+
       '<div class="pielg">'+pieLegend(slices)+'</div>'+
       '<div class="clr"></div>'+
       '<p class="muted" style="font-size:12px;margin:12px 0 0">Every invoice the lab has issued, split by business unit.</p>'+
     '</div></div>'+
     '<div class="card half last"><h3>Ongoing Purchases (PR/PO) Status<span class="sp"></span>'+
       '<span class="pill k-a">'+PR.length+' open</span></h3><div class="cb">'+
       barRows([{k:"DELIVERED",v:nDel,c:"#4fae7d"},{k:"PO",v:nPo,c:"#6c9cc6"},{k:"PR",v:nPr,c:"#f2b01e"}])+
       '<p class="muted" style="font-size:12px;margin:14px 0 0">Number of purchase requests at each stage. '+
       'Released PO value so far: <b style="color:#eae8e3">'+inrShort(poAmt)+'</b>.</p>'+
     '</div></div><div class="clr"></div></div>';

  h+='<div class="split">'+
     '<div class="card half"><h3>Deliveries</h3><div class="cb">'+
       '<div class="big2">'+num(INVS.length,0)+'</div>'+
       '<p class="muted" style="font-size:12.5px;margin:4px 0 0">Total invoices generated, all periods. '+
       'Worth '+inrShort(rev)+' in total.</p>'+
     '</div></div>'+
     '<div class="card half last"><h3>Projects</h3><div class="cb">'+
       '<table class="kvt"><tr><td class="k">Ongoing Projects</td><td class="v">'+num(ongoing,0)+'</td></tr>'+
       '<tr><td class="s" colspan="2">Part requests received and still moving</td></tr>'+
       '<tr><td class="k">Upcoming Projects</td><td class="v">'+num(upcomingCount(),0)+'</td></tr>'+
       '<tr><td class="s" colspan="2">Requests with material reserved or waiting on a PR</td></tr></table>'+
     '</div></div><div class="clr"></div></div>';

  if(cal.rows.length){
    h+='<div class="card"><h3>Calibration &mdash; due and overdue</h3><div class="tw"><table>'+
       '<thead><tr><th>Asset</th><th>Name</th><th>Location</th><th class="mono">Due</th><th class="num">Days</th><th>Owner</th></tr></thead><tbody>';
    for(i=0;i<cal.rows.length && i<20;i++){ var c=cal.rows[i].c, dd=cal.rows[i].days;
      h+='<tr><td class="mono">'+esc(c.no)+'</td><td>'+esc(c.name)+'</td><td>'+esc(c.loc)+'</td>'+
         '<td class="mono">'+esc(fmtDate(c.due))+'</td><td class="num"><b style="color:'+(dd<0?"#dc7361":"#d99b3c")+'">'+
         (dd<0?("overdue "+Math.abs(dd)):dd)+'</b></td><td>'+esc(c.own)+'</td></tr>';
    }
    h+='</tbody></table></div></div>';
  } else if(!cal.total){
    h+='<div class="card"><div class="cb muted" style="font-size:12.5px">'+
       '<b style="color:#eae8e3">Calibration tracking is not set up yet.</b><br>'+
       'The workbook now has a <span class="mono">Calibration</span> tab with columns for asset, last calibration '+
       'date, interval and due date. Fill in one row per instrument and this card starts working. '+
       'Until then it deliberately shows a dash rather than a zero, so an empty tab is never mistaken for "nothing is due".'+
       '</div></div>';
  }
  return h;
}

/* ---------- WIRING FOR EVERY v6 SCREEN ---------------------------- */
function v6wire(){
  $$("[data-short]").forEach(function(b){
    b.onclick=function(){
      var p=b.getAttribute("data-short").split("|");
      openShortForm(p[0],Number(p[1]));
    };
  });
  $$("[data-inv]").forEach(function(b){ b.onclick=function(){ openInvoice(b.getAttribute("data-inv")); }; });
  $$("[data-npok]").forEach(function(b){
    b.onclick=function(){
      var p=b.getAttribute("data-npok").split("|");
      Store.updateNewPart(p[0],Number(p[1]),{status:"APPROVED"});
      toast("Row approved. Add it to the Parts tab in Excel once it has a part number.","New part approved");
      render();
    };
  });
  $$("[data-pu-add]").forEach(function(b){
    b.onclick=function(){
      if(purchAdd(b.getAttribute("data-pu-add"))){ toast("Added to the purchase tab.","Added"); bust(); render(); }
      else toast("That part is already on the purchase tab.","Nothing to add",true);
    };
  });
  $$("[data-pu-edit]").forEach(function(b){
    b.onclick=function(){ var p=b.getAttribute("data-pu-edit").split("|"); openPurchEdit(p[0],p[1]||""); };
  });
  if($("#pu_pull")) $("#pu_pull").onclick=function(){
    var book=shortageBook(), n=0, i;
    for(i=0;i<book.length;i++) if(purchAdd(book[i].pn)) n++;
    if(n){ toast(n+" shortfall line(s) added to the purchase tab.","Added"); bust(); render(); }
    else toast("Every shortfall is already on the purchase tab.","Nothing to add",true);
  };
  if($("#pp_new")) $("#pp_new").onclick=function(){ openPrPo(null); };
  $$("[data-pp-edit]").forEach(function(b){ b.onclick=function(){ openPrPo(b.getAttribute("data-pp-edit")); }; });
  $$("[data-loc]").forEach(function(b){ b.onclick=function(){ openLocEdit(b.getAttribute("data-loc")); }; });
}

/* ---------- STORE LOCATION ----------------------------------------
   "Take from Excel but make it manual edit." The value comes from the
   Parts tab and is written straight back to that same cell, so Excel
   and the portal can never drift apart on where something is kept. */
function openLocEdit(pn){
  var p=partBy(pn); if(!p) return;
  var locs=[], seen={}, i;
  for(i=0;i<DB.parts.length;i++){
    var v=DB.parts[i].l;
    if(v && !seen[v.toUpperCase()]){ seen[v.toUpperCase()]=1; locs.push(v); }
  }
  locs.sort();
  modal("Store location — "+p.pn,
    dataList("dl_loc",locs)+
    '<dl class="kv"><dt>Part</dt><dd class="mono">'+esc(p.pn)+'</dd>'+
    '<dt>Description</dt><dd>'+esc(p.d)+'</dd></dl>'+
    '<div class="fg"><label>Store location</label>'+
    '<input type="text" id="lc_v" list="dl_loc" value="'+esc(p.l||"")+'" placeholder="Rack / bin, e.g. L-09"></div>'+
    '<p class="muted" style="font-size:12px;margin:8px 0 0">This writes back into the Location column of the '+
    'Parts tab, so the workbook and the portal always agree.</p>',
    '<button class="btn sec" onclick="closeModal()">Cancel</button><button class="btn" id="lc_go">Save</button>');
  $("#lc_go").onclick=function(){
    /* Read the field BEFORE closing: closeModal() empties the modal, so any
       later $("#lc_v") is null and reading .value off it throws — which on the
       IE engine is a Script Error dialog, not a quiet console line. */
    var val=$("#lc_v").value;
    var ok=Store.setLocation(p.pn,val);
    if(!ok){ toast("The workbook is open somewhere, so the Parts tab could not be edited. Close it and try again.","Could not save",true); return; }
    closeModal(); toast(p.pn+" is now at "+(val||"\u2014")+".","Location updated"); bust(); render();
  };
}

/* ---------- REQUEST DETAIL — reserve / release ------------------- */
function openReq(no){
  var R=reqIndex(), r=R[no]; if(!r) return;
  var b=balances(), canAct=isAdmin(), mine=(r.by===ME.e), i;
  var h='<dl class="kv">'+
    '<dt>Status</dt><dd>'+kpill(r.status)+(r.kind==="SHORTAGE"?' <span class="pill k-b">SHORTFALL OF '+esc(r.parent||"")+'</span>':'')+'</dd>'+
    '<dt>Requester</dt><dd>'+esc(r.byName)+' · '+esc(r.by)+'</dd>'+
    '<dt>Harness / machine</dt><dd><span class="mono">'+esc(r.harness)+'</span> · '+esc(r.machine)+'</dd>'+
    '<dt>Project / stage</dt><dd><span class="mono">'+esc(r.pcode)+'</span> · '+esc(r.stage)+'</dd>'+
    '<dt>Business unit</dt><dd>'+esc(r.bu)+' · cost centre <span class="mono">'+esc(r.cc)+'</span></dd>'+
    '<dt>Contacts</dt><dd>BU: '+esc(r.buc)+' · DC: '+esc(r.dcc)+'</dd>'+
    /* The circuit count drives the cost sheet, so the store can correct it
       here as well as the engineer entering it — "add by engineer as well as
       admin also". */
    '<dt>No. of circuits</dt><dd>'+(canAct
        ? '<input type="number" id="rq_circ" min="0" step="1" value="'+esc(r.circ||0)+'" style="width:110px;text-align:right">'+
          ' <button class="btn sec sm" data-circ="'+esc(no)+'">Save</button>'+
          ' <span class="muted" style="font-size:11.5px">feeds the cost sheet</span>'
        : (esc(r.circ||"—")))+'</dd>'+
    '<dt>Required by</dt><dd class="mono">'+esc(r.need?fmtDate(r.need):"—")+'</dd>'+
    '<dt>Scope of work</dt><dd>'+esc(r.scope)+'</dd></dl>';

  h+='<div style="margin:18px 0 8px" class="lbl">BOM lines</div><div class="tw" style="max-height:38vh">'+
     '<table><thead><tr><th>Part</th><th>Store location</th><th class="num">Req</th><th class="num">Avail</th>'+
     '<th class="num">Resv</th><th class="num">Rel</th><th>Status</th>'+
     (canAct?'<th class="num">Release now</th>':'')+'</tr></thead><tbody>';
  for(i=0;i<r.lines.length;i++){ var l=r.lines[i], x=l.pid?b[l.pid]:{av:0};
    var pend=(l.resv||0)-(l.rel||0);
    var p=l.pid?partById(l.pid):null;
    var gap=(Number(l.q)||0)-Math.max(Number(l.resv)||0,Number(l.rel)||0);
    /* The handwritten note: a line that cannot be met gets its own button next
       to the status, so the engineer can chase that one part separately while
       the rest of the request is released. */
    var shortBtn = (gap>0 && (mine||canAct))
      ? ' <button class="btn sec sm" data-short="'+esc(no)+'|'+i+'" title="Raise this shortfall as its own request">Request separately</button>'
      : '';
    h+='<tr><td class="mono">'+esc(l.pn)+'<br><span class="muted" style="font-family:Segoe UI,system-ui,sans-serif;font-size:11.5px">'+esc(l.d)+'</span></td>'+
      '<td class="mono">'+(p?esc(p.l||"—"):'<span class="muted">—</span>')+
        (canAct&&p?' <button class="btn sec sm" data-loc="'+esc(p.pn)+'" title="Edit the Location cell in the Parts tab">Edit</button>':'')+'</td>'+
      '<td class="num">'+num(l.q,0)+'</td><td class="num">'+(l.pid?num(x.av+pend,0):"—")+'</td>'+
      '<td class="num">'+num(l.resv||0,0)+'</td><td class="num">'+num(l.rel||0,0)+'</td>'+
      '<td>'+kpill(l.st)+shortBtn+'</td>'+
      (canAct?'<td class="num">'+(l.pid&&pend>0?'<input type="number" class="relq" data-i="'+i+'" value="'+pend+'" min="0" max="'+pend+'" style="width:74px;text-align:right">':'<span class="muted">—</span>')+'</td>':'')+
      '</tr>';
  }
  h+='</tbody></table></div>';
  if(r.log&&r.log.length){
    h+='<div style="margin:16px 0 8px" class="lbl">History</div><div style="font-size:12.5px" class="muted">';
    for(i=r.log.length-1;i>=0;i--) h+='<div>'+esc(r.log[i].t.slice(0,16).replace("T"," "))+' · '+esc(r.log[i].by)+' — '+esc(r.log[i].a)+'</div>';
    h+='</div>';
  }
  var f='<button class="btn sec" onclick="closeModal()">Close</button>';
  if(canAct){
    if(r.status==="SUBMITTED"||r.status==="ADMIN REVIEW")
      f='<button class="btn dg" data-act="reject" data-no="'+esc(no)+'">Reject</button>'+
        '<button class="btn sec" onclick="closeModal()">Close</button>'+
        '<button class="btn" data-act="reserve" data-no="'+esc(no)+'">Reserve available stock</button>';
    else if(r.status==="RESERVED"||r.status==="READY FOR RELEASE"||r.status==="PARTIALLY RELEASED"||r.status==="PURCHASE REQUIRED")
      f='<button class="btn sec" onclick="closeModal()">Close</button>'+
        '<button class="btn" data-act="release" data-no="'+esc(no)+'">RELEASE</button>';
    else if(r.status==="RELEASED")
      f='<button class="btn sec" onclick="closeModal()">Close</button>'+
        '<button class="btn sec" data-invfrom="'+esc(no)+'">Create invoice</button>'+
        '<button class="btn" data-act="complete" data-no="'+esc(no)+'">Mark completed</button>';
  }
  if(r.status==="RELEASED"||r.status==="PARTIALLY RELEASED"||r.status==="COMPLETED"){
    if(canAct||mine)
      f='<button class="btn sec" data-jobcard="'+esc(no)+'">Print job card</button>'+f;
  }
  modal(no+" · "+r.harness,h,f);
  $$("#modal [data-jobcard]").forEach(function(bt){
    bt.onclick=function(){ SEL=bt.getAttribute("data-jobcard"); VIEW="jobcard"; closeModal(); renderNav(); render(); };
  });
  $$("#modal [data-invfrom]").forEach(function(bt){
    bt.onclick=function(){
      INV=invBlank(); closeModal(); VIEW="invoice"; renderNav(); render();
      /* prefill straight from this request rather than making the admin pick it again */
      var RR=reqIndex(), rr=RR[bt.getAttribute("data-invfrom")];
      if(rr){
        INV.ref=rr.no; INV.harness=rr.harness; INV.job=rr.scope||rr.machine; INV.bu=rr.bu;
        INV.buc=rr.buc; INV.cost=rr.cc; INV.dcc=rr.dcc; INV.to=rr.buc;
        INV.app=rr.stage?("Build stage: "+rr.stage):""; INV.details=rr.scope;
        INV.circ=Number(rr.circ)||0; INV.recd=rr.on; INV.start=rr.on; INV.done=today();
        INV.lines=[];
        for(var k=0;k<rr.lines.length;k++){
          var l2=rr.lines[k], p2=l2.pid?partById(l2.pid):partBy(l2.pn);
          INV.lines.push({pn:l2.pn,q:Number(l2.rel)||Number(l2.q)||0,
            cpu:Number(l2.cost)||(p2?p2.cost:0),d:l2.d||(p2?p2.d:"")});
        }
        render();
      }
    };
  });
  $$("#modal [data-circ]").forEach(function(bt){
    bt.onclick=function(){
      var rr=reqIndex()[bt.getAttribute("data-circ")]; if(!rr) return;
      rr.circ=Number($("#rq_circ").value)||0;
      rr.log.push({t:new Date().toISOString(),by:ME.n,a:"Set circuit count to "+rr.circ});
      saveReq(rr); toast("Circuit count saved as "+rr.circ+".","Updated");
    };
  });
  $$("#modal [data-act]").forEach(function(bt){
    bt.onclick=function(){ act(bt.getAttribute("data-act"),bt.getAttribute("data-no")); };
  });
  v6wire();
}
function act(a,no){
  var R=reqIndex(), r=R[no]; if(!r) return;
  var i,l,b=balances();
  if(a==="reject"){
    r.status="REJECTED"; r.log.push({t:new Date().toISOString(),by:ME.n,a:"Rejected"});
    saveReq(r); closeModal(); toast(no+" rejected. The requester keeps the record.","Rejected"); renderNav(); render(); return;
  }
  if(a==="complete"){
    r.status="COMPLETED"; r.log.push({t:new Date().toISOString(),by:ME.n,a:"Completed"});
    saveReq(r); closeModal(); toast(no+" closed.","Completed"); renderNav(); render(); return;
  }
  if(a==="reserve"){
    var got=0,part=0,none=0;
    for(i=0;i<r.lines.length;i++){ l=r.lines[i];
      if(!l.pid){ l.st="NEW PART"; none++; continue; }
      var av=bal(l.pid).av, want=l.q-(l.resv||0);
      var take=Math.max(0,Math.min(av,want));
      l.resv=(l.resv||0)+take;
      if(l.resv>=l.q){ l.st="AVAILABLE"; got++; }
      else if(l.resv>0){ l.st="PARTIAL"; part++; }
      else { l.st="SHORTAGE"; none++; }
      bust();
    }
    r.status = (part||none) ? "PURCHASE REQUIRED" : "READY FOR RELEASE";
    if(got && !part && !none) r.status="READY FOR RELEASE";
    r.log.push({t:new Date().toISOString(),by:ME.n,a:"Reserved stock — "+got+" full, "+part+" partial, "+none+" short"});
    saveReq(r); closeModal();
    for(i=0;i<r.lines.length;i++){
      l=r.lines[i];
      if((Number(l.q)||0)-Math.max(Number(l.resv)||0,Number(l.rel)||0) > 0) purchAdd(l.pn);
    }
    toast(got+" line(s) fully reserved"+((part+none)?", "+(part+none)+" still short":"")+".","Stock reserved");
    renderNav(); render(); return;
  }
  if(a==="release"){
    var inputs=$$("#modal .relq"), done=0, fail=0, msg="";
    for(var k=0;k<inputs.length;k++){
      var idx=Number(inputs[k].getAttribute("data-i")), q=Number(inputs[k].value)||0;
      if(q<=0) continue;
      l=r.lines[idx];
      var res=move(l.pid,-q,"RELEASE","REQUEST",r.no,"Issued to "+r.byName+" for "+r.harness,l.cost);
      if(res.ok){ l.rel=(l.rel||0)+q; done++; if(l.rel>=l.q) l.st="RELEASED"; }
      else { fail++; msg=res.msg; }
    }
    var all=true; for(i=0;i<r.lines.length;i++){ l=r.lines[i]; if((l.rel||0)<l.q) all=false; }
    r.status = all ? "RELEASED" : (done?"PARTIALLY RELEASED":r.status);
    if(done) r.log.push({t:new Date().toISOString(),by:ME.n,a:"Released material on "+done+" line(s)"});
    saveReq(r);
    /* Whatever still could not be given is a real shortfall now, so it goes
       onto the Ongoing Purchase tab where a PR and supplier number get
       attached to it. Two engineers short of the same part land on one line,
       because shortageBook() adds them up before this runs. */
    var pushed=0;
    for(i=0;i<r.lines.length;i++){
      l=r.lines[i];
      if((Number(l.q)||0)-Math.max(Number(l.resv)||0,Number(l.rel)||0) > 0){
        if(purchAdd(l.pn)) pushed++;
      }
    }
    closeModal();
    if(done) toast(done+" line(s) issued. Stock in the Excel is reduced by exactly that quantity.","Material released");
    if(pushed) toast(pushed+" short line(s) added to Ongoing Purchase, ready for a PR.","Shortfall logged");
    if(fail) toast(msg,"Some lines could not be issued",true);
    bust(); renderNav(); render(); return;
  }
}

/* ---------- INVENTORY -------------------------------------------- */
function vInventory(){
  return head("Component Inventory",num(DB.parts.length)+" components · stock is calculated from the transaction ledger, never typed")+
  '<div class="bar">'+
    '<input type="text" id="iq" placeholder="Part number or description">'+
    '<select id="ic"><option value="">All categories</option>'+DB.cats.map(function(c){return '<option>'+esc(c)+'</option>';}).join("")+'</select>'+
    '<select id="is"><option value="">Any status</option><option>IN STOCK</option><option>LOW STOCK</option><option>OUT OF STOCK</option><option>FULLY RESERVED</option></select>'+
    '<select id="if"><option value="">Any data quality</option><option value="OK">Complete</option><option value="BAD">Needs cleanup</option></select>'+
    '<button class="btn sec" id="icsv">Export CSV</button>'+
  '</div><div class="card"><div id="iout"></div></div>';
}
vInventory.after=function(){
  function rows(){
    var q=$("#iq").value.trim().toUpperCase(),c=$("#ic").value,s=$("#is").value,f=$("#if").value,b=balances();
    return DB.parts.filter(function(p){
      if(c&&p.c!==c) return false;
      if(s&&b[p.id].st!==s) return false;
      if(f==="OK"&&p.f!=="OK") return false;
      if(f==="BAD"&&p.f==="OK") return false;
      if(!q) return true;
      return String(p.pn).toUpperCase().indexOf(q)>=0||String(p.d).toUpperCase().indexOf(q)>=0;
    });
  }
  function run(){
    var r=rows(),b=balances();
    if(!r.length){ $("#iout").innerHTML='<div class="empty"><b>No match</b>Try a shorter search.</div>'; return; }
    var top='<p class="muted" style="padding:11px 15px 0;margin:0;font-size:12.5px">'+num(r.length)+' of '+num(DB.parts.length)+' components</p>';
    var thead='<thead><tr><th>Part</th><th>Description</th><th>Sub-category</th><th>Store location</th>'+
      '<th class="num">On hand</th><th class="num">Resv</th><th class="num">Avail</th><th>UOM</th>'+
      '<th class="num">Unit cost</th><th>Status</th><th>Data</th></tr></thead><tbody>', R=[];
    for(var i=0;i<Math.min(r.length,400);i++){ var p=r[i],x=b[p.id];
      R.push('<tr><td class="mono">'+esc(p.pn)+'</td><td>'+esc(p.d)+'</td><td>'+esc(p.s)+'</td>'+
        '<td class="mono">'+esc(p.l||"—")+
          (isAdmin()?' <button class="btn sec sm" data-loc="'+esc(p.pn)+'" title="Edit the Location cell in the Parts tab">Edit</button>':'')+
        '</td><td class="num">'+meter(x.on,p.ref)+num(x.on,0)+'</td>'+
        '<td class="num">'+num(x.res,0)+'</td><td class="num"><b>'+num(x.av,0)+'</b></td><td class="mono">'+esc(p.u)+'</td>'+
        '<td class="num">'+(p.cost?inr(p.cost):"—")+'</td><td>'+kpill(x.st)+'</td>'+
        '<td>'+(p.f==="OK"?'<span class="pill k-ok">OK</span>':'<span class="pill k-w" title="'+esc(p.f)+'">FIX</span>')+'</td></tr>');
    }
    paintBig($("#iout"), function(n,partial){
      return top+'<div class="tw"><table'+(partial?'':' class="flt"')+'>'+thead+R.slice(0,n).join('')+'</tbody></table></div>'+
             (partial?'<p class="muted" style="padding:8px 15px;font-size:12px">Loading the other '+num(R.length-n)+' rows\u2026</p>':'');
    }, R.length, function(){ wireFilters(); v6wire(); });
  }
  $("#iq").oninput=run; $("#ic").onchange=run; $("#is").onchange=run; $("#if").onchange=run;
  $("#icsv").onclick=function(){
    var b=balances(),r=rows(),L=["PartNumber,Description,SubCategory,Location,OnHand,Reserved,Available,UOM,UnitCost,Status,DataQuality"];
    for(var i=0;i<r.length;i++){ var p=r[i],x=b[p.id];
      L.push(['"'+p.pn+'"','"'+String(p.d).replace(/"/g,"")+'"','"'+p.s+'"','"'+(p.l||"")+'"',x.on,x.res,x.av,p.u,p.cost,x.st,'"'+p.f+'"'].join(",")); }
    dl("EDS-inventory-"+today()+".csv",L.join("\n"));
  };
  run();
};

/* ---------- MATERIAL INWARD -------------------------------------- */
function vInward(){
  return head("Material Inward","Record what arrived. Stock goes up only through this screen.")+
  '<div class="card"><h3>Receive material</h3><div class="cb">'+
   '<div class="f2">'+fld("Part number","w_pn","text","7219/0373",1)+
   '<div class="fg"><label>Matched part</label><div id="w_match" class="muted" style="padding:8px 0">Type a part number above.</div></div></div>'+
   '<div class="f3">'+fld("Quantity received","w_q","number","50",1)+
     sel("Reference type","w_t",["PO","FOC","RETURN","ADJUST","SCRAP"],1)+
     fld("PO / FOC number","w_po","text","9700009778",1)+'</div>'+
   '<div class="f3">'+fld("Unit cost","w_c","number","12.00",0)+
     fld("Landing date","w_d","date",today(),1)+
     fld("Storage location","w_l","text","L-5",0)+'</div>'+
   fld("Remarks / reason","w_r","text","Required for adjustments and scrap",0)+
   '<div style="text-align:right;margin-top:6px">'+
     '<button class="btn" id="w_go">Record receipt</button></div>'+
  '</div></div>'+
  '<div class="card"><h3>Last 15 movements</h3><div class="tw" id="w_recent"></div></div>';
}
vInward.after=function(){
  function recent(){
    var L=DB.ledger.slice(-15).reverse();
    var h='<table><thead><tr><th>Date</th><th>Part</th><th>Type</th><th class="num">Qty</th><th>Ref</th><th>By</th></tr></thead><tbody>';
    for(var i=0;i<L.length;i++){ var l=L[i],p=null;
      for(var j=0;j<DB.parts.length;j++) if(DB.parts[j].id===l.p) p=DB.parts[j];
      h+='<tr><td class="mono">'+esc(fmtDate(l.dt))+'</td><td class="mono">'+esc(p?p.pn:l.p)+'</td>'+
        '<td>'+kpill(l.t)+'</td><td class="num" style="color:'+(l.q<0?"#dc7361":"#4fae7d")+'">'+(l.q>0?"+":"")+num(l.q,0)+'</td>'+
        '<td class="mono">'+esc(l.si||"—")+'</td><td class="muted">'+esc(String(l.by).split("@")[0])+'</td></tr>';
    }
    $("#w_recent").innerHTML=h+'</tbody></table>';
  }
  $("#w_pn").oninput=function(){
    var p=partBy(this.value);
    $("#w_match").innerHTML = p
      ? '<b>'+esc(p.d)+'</b><br><span class="muted">'+esc(p.s)+' · '+esc(p.u)+' · on hand '+num(bal(p.id).on,0)+'</span>'
      : (this.value.trim()? '<span style="color:#d99b3c">Not in the catalogue. Check the number, or add the part first.</span>' : 'Type a part number above.');
    if(p && !$("#w_c").value) $("#w_c").value=p.cost||"";
    if(p && !$("#w_l").value) $("#w_l").value=p.l||"";
  };
  $("#w_go").onclick=function(){
    var p=partBy($("#w_pn").value);
    if(!p){ toast("That part number is not in the catalogue.","Cannot record",true); return; }
    var q=parseFloat($("#w_q").value);
    if(!isFinite(q)||q<=0){ toast("Enter a quantity greater than zero.","Cannot record",true); return; }
    var t=$("#w_t").value, sign=(t==="SCRAP")?-1:1;
    var type = t==="PO"||t==="FOC" ? "RECEIPT" : t;
    var res=move(p.id, sign*q, type, t, $("#w_po").value.trim(), $("#w_r").value.trim(), parseFloat($("#w_c").value)||p.cost);
    if(!res.ok){ toast(res.msg,"Cannot record",true); return; }
    if($("#w_l").value.trim()){ p.l=$("#w_l").value.trim(); Store.saveParts(); }
    toast("Recorded "+num(q,0)+" "+p.u+" of "+p.pn+". Stock is now "+num(res.bal,0)+".","Receipt saved");
    $("#w_q").value=""; $("#w_pn").value=""; $("#w_match").innerHTML="Type a part number above.";
    recent(); renderNav();
  };
  recent();
};

/* ---------- LEDGER ------------------------------------------------ */
function vLedger(){
  return head("Stock Transactions",
    num(DB.ledger.length)+" movements. Nothing here can be edited or deleted \u2014 corrections are new reversing rows.")+
  '<div class="bar"><input type="text" id="lq" placeholder="Part, harness, machine, person or reference">'+
   '<select id="lt"><option value="">All types</option><option>RECEIPT</option><option>RELEASE</option>'+
   '<option>RETURN</option><option>ADJUST</option><option>SCRAP</option></select>'+
   '<button class="btn sec" id="lcsv">Export CSV</button></div>'+
  '<div class="card"><div id="lout"></div></div>';
}
/* Everything a movement can tell you about WHY it happened.
   A release is recorded against a request; that request knows the harness,
   the machine, who asked and what it was for. Until now the ledger showed
   only the part and a reference code, so "who took this and for what" meant
   opening a second screen. This joins the two. */
function txnContext(l){
  var out={harness:"",machine:"",to:"",by:String(l.by||"").split("@")[0],reason:l.r||""};
  var ref=String(l.si||"");
  if(ref){
    var R=reqIndex(), r=R[ref];
    if(r){
      out.harness=r.harness||"";
      out.machine=r.machine||"";
      out.to=r.byName||"";
    }
  }
  if(!out.to && /issued to /i.test(out.reason)){
    /* older rows recorded the recipient only inside the reason text */
    var m=/issued to ([^,;]+?)(?: for |$)/i.exec(out.reason);
    if(m) out.to=m[1].replace(/^\s+|\s+$/g,"");
  }
  return out;
}
vLedger.after=function(){
  function rows(){
    var q=$("#lq").value.trim().toUpperCase(),t=$("#lt").value,map={};
    for(var j=0;j<DB.parts.length;j++) map[DB.parts[j].id]=DB.parts[j];
    return DB.ledger.filter(function(l){
      if(t&&l.t!==t) return false;
      if(!q) return true;
      var p=map[l.p], cx=txnContext(l);
      var hay=((p?p.pn+" "+p.d:"")+" "+(l.si||"")+" "+cx.harness+" "+cx.machine+" "+
               cx.to+" "+cx.by+" "+cx.reason).toUpperCase();
      return hay.indexOf(q)>=0;
    }).slice().reverse();
  }
  function run(){
    var L=rows(),map={};
    for(var j=0;j<DB.parts.length;j++) map[DB.parts[j].id]=DB.parts[j];
    if(!L.length){ $("#lout").innerHTML='<div class="empty"><b>No transactions match</b>Try a different filter.</div>'; return; }
    var top='<p class="muted fltnote" style="padding:11px 15px 0;margin:0;font-size:12.5px">'+num(L.length)+' movements</p>';
    var thead='<thead><tr><th>Date</th><th>Part</th><th>Description</th><th>Harness</th><th>Machine</th>'+
     '<th>Type</th><th class="num">Qty</th><th>Issued to</th><th>Issued by</th>'+
     '<th>Reference</th><th class="num">Unit cost</th><th>Reason</th></tr></thead><tbody>', R=[];
    for(var i=0;i<Math.min(L.length,500);i++){ var l=L[i],p=map[l.p], cx=txnContext(l);
      R.push('<tr><td class="mono">'+esc(fmtDate(l.dt))+'</td><td class="mono">'+esc(p?p.pn:l.p)+'</td>'+
        '<td>'+esc(p?p.d:"")+'</td>'+
        '<td class="mono">'+esc(cx.harness||"—")+'</td><td>'+esc(cx.machine||"—")+'</td>'+
        '<td>'+kpill(l.t)+'</td>'+
        '<td class="num" style="color:'+(l.q<0?"#dc7361":"#4fae7d")+'">'+(l.q>0?"+":"")+num(l.q,0)+'</td>'+
        '<td>'+esc(cx.to||"—")+'</td><td class="muted">'+esc(cx.by)+'</td>'+
        '<td class="mono">'+esc(l.si||"—")+'</td><td class="num">'+(l.c?inr(l.c):"—")+'</td>'+
        '<td class="muted">'+esc(cx.reason||"")+'</td></tr>');
    }
    paintBig($("#lout"), function(n,partial){
      return top+'<div class="tw"><table'+(partial?'':' class="flt"')+'>'+thead+R.slice(0,n).join('')+'</tbody></table></div>'+
             (partial?'<p class="muted" style="padding:8px 15px;font-size:12px">Loading the other '+num(R.length-n)+' rows\u2026</p>':'');
    }, R.length, function(){ wireFilters(); });
  }
  $("#lq").oninput=run; $("#lt").onchange=run;
  $("#lcsv").onclick=function(){
    var L=rows(),map={},O=["Date,Part,Description,Harness,Machine,Type,Qty,IssuedTo,IssuedBy,Reference,UnitCost,Reason"];
    for(var j=0;j<DB.parts.length;j++) map[DB.parts[j].id]=DB.parts[j];
    function csv(v){ return '"'+String(v==null?"":v).replace(/"/g,'""')+'"'; }
    for(var i=0;i<L.length;i++){ var l=L[i],p=map[l.p], cx=txnContext(l);
      O.push([fmtDate(l.dt),csv(p?p.pn:l.p),csv(p?p.d:""),csv(cx.harness),csv(cx.machine),
              l.t,l.q,csv(cx.to),csv(cx.by),csv(l.si||""),l.c,csv(cx.reason)].join(",")); }
    dl("EDS-stock-ledger-"+today()+".csv",O.join("\n"));
  };
  run();
};

/* ---------- PROCUREMENT ------------------------------------------- */
var PROC_NEXT={
  "PR RAISED":{label:"Mark approved",to:"APPROVED"},
  "APPROVED":{label:"Raise PO",to:"PO RAISED",needsPo:true},
  "PO RAISED":{label:"Mark GRN in progress",to:"GRN IN PROGRESS"},
  "GRN IN PROGRESS":{label:"Mark delivered / closed",to:"DELIVERED (CLOSED)"}
};
function procAge(p){
  var base=p.raised; if(!base) return "";
  var d=new Date(base+"T00:00:00"); if(isNaN(d)) return "";
  var days=Math.round((new Date()-d)/86400000);
  return days+"d";
}
function vProc(){
  var foc=0,po=0,val=0;
  for(var i=0;i<DB.pos.length;i++){ if(DB.pos[i].t==="FOC")foc++; else po++; val+=DB.pos[i].amt||0; }
  var L=reqList().filter(function(r){ return r.status==="PURCHASE REQUIRED"; });
  var short={};
  for(i=0;i<L.length;i++){ for(var j=0;j<L[i].lines.length;j++){ var l=L[i].lines[j];
    if(l.st==="SHORTAGE"||l.st==="PARTIAL"||l.st==="NEW PART"){
      var k=l.pn; short[k]=short[k]||{pn:l.pn,d:l.d,q:0,reqs:[]};
      short[k].q+=l.q-(l.resv||0); short[k].reqs.push(L[i].no); } } }
  var S=[]; for(var k in short) S.push(short[k]);
  var proc=(DB.proc||[]).slice().sort(function(a,b){ return (b.raised||"").localeCompare(a.raised||""); });
  var open=proc.filter(function(p){ return p.stage!=="DELIVERED (CLOSED)"&&p.stage!=="REJECTED"; });
  var canAct=isAdmin();

  var h=head("Procurement (PR / PO)","Every requisition raised from this lab, its stage, and legacy purchase references")+
   (canAct?'<div style="margin:-6px 0 16px">'+
      '<button class="btn" id="pp_new">+ New PR / PO entry</button>'+
      '<button class="btn sec" id="p_new">Quick PR from a shortage</button></div>':'')+
   '<div class="tiles">'+
     tile(open.length?"w":"","PRs / POs in progress",open.length,"across all stages")+
     tile("","Purchase orders",po,"legacy paid references")+
     tile("b","FOC receipts",foc,"free of charge, mostly TE Connectivity")+
     tile("a","Committed value",inrShort(val),"across legacy POs")+
   '</div>';

  h+='<div class="card"><h3>PR / PO tracker'+
     '<span class="sp"></span><span class="muted" style="font-size:12px">'+
     (canAct?"Click a stage button to move a requisition forward":"Read-only")+'</span></h3>';
  if(!proc.length) h+='<div class="empty"><b>Nothing raised yet</b>Raise a PR above once a shortage needs purchasing.</div>';
  else{
    h+='<div class="tw"><table><thead><tr><th>PR number</th><th>Summary</th><th>Type</th><th class="num">Qty</th>'+
       '<th>Raised</th><th class="num">Age</th><th>Approved by</th><th>PO number</th><th class="num">PO amount</th>'+
       '<th>Stage</th>'+(canAct?'<th>Action</th>':'')+'</tr></thead><tbody>';
    for(i=0;i<proc.length;i++){ var p=proc[i], nx=PROC_NEXT[p.stage];
      h+='<tr><td class="mono">'+esc(p.no)+'</td><td>'+esc(p.summary)+'</td><td>'+esc(p.svc)+'</td>'+
         '<td class="num">'+num(p.qty,0)+'</td><td class="mono">'+esc(p.raised?fmtDate(p.raised):"—")+'</td>'+
         '<td class="num muted">'+procAge(p)+'</td><td>'+esc(p.apprBy||"—")+'</td>'+
         '<td class="mono">'+esc(p.po||"—")+'</td><td class="num">'+(p.amt?inr(p.amt):"—")+'</td>'+
         '<td>'+kpill(p.stage)+'</td>'+
         (canAct?'<td>'+(nx?'<button class="btn sec sm" data-proc="'+esc(p.no)+'" data-to="'+nx.to+'">'+esc(nx.label)+'</button>':
            (p.stage==="DELIVERED (CLOSED)"||p.stage==="REJECTED"?'<span class="muted">—</span>':''))+
            ' <button class="btn sec sm" data-pp-edit="'+esc(p.no)+'">Edit</button>'+
            (p.stage!=="DELIVERED (CLOSED)"&&p.stage!=="REJECTED"?
              ' <button class="btn dg sm" data-proc="'+esc(p.no)+'" data-to="REJECTED">Reject</button>':'')+'</td>':'')+
         '</tr>';
    }
    h+='</tbody></table></div>';
  }
  h+='</div>';

  h+='<div class="card"><h3>Shortages waiting for a purchase requisition</h3>';
  if(!S.length) h+='<div class="empty"><b>Nothing outstanding</b>No request is currently blocked on material.</div>';
  else{
    h+='<div class="tw"><table><thead><tr><th>Part</th><th>Description</th><th class="num">Qty short</th><th>Raised on</th></tr></thead><tbody>';
    for(i=0;i<S.length;i++) h+='<tr><td class="mono">'+esc(S[i].pn)+'</td><td>'+esc(S[i].d)+'</td>'+
      '<td class="num"><b style="color:#dc7361">'+num(S[i].q,0)+'</b></td><td class="mono">'+esc(S[i].reqs.join(", "))+'</td></tr>';
    h+='</tbody></table></div>';
  }
  h+='</div><div class="card"><h3>Legacy purchase references</h3><div class="tw"><table>'+
    '<thead><tr><th>Reference</th><th>Type</th><th>Supplier</th><th>Date</th><th class="num">Lines</th><th class="num">Value</th></tr></thead><tbody>';
  var P=DB.pos.slice().sort(function(a,b){ return (b.d||"").localeCompare(a.d||""); });
  for(i=0;i<P.length;i++) h+='<tr><td class="mono">'+esc(P[i].no)+'</td>'+
    '<td>'+(P[i].t==="FOC"?'<span class="pill k-b">FOC</span>':'<span class="pill k-m">PO</span>')+'</td>'+
    '<td>'+esc(P[i].v||"—")+'</td><td class="mono">'+esc(fmtDate(P[i].d))+'</td><td class="num">'+num(P[i].n)+'</td>'+
    '<td class="num">'+(P[i].amt?inr(P[i].amt):"—")+'</td></tr>';
  return h+'</tbody></table></div></div>';
}
vProc.after=function(){
  if($("#p_new")) $("#p_new").onclick=openNewPr;
  $$("[data-proc]").forEach(function(bt){
    bt.onclick=function(){ procAdvance(bt.getAttribute("data-proc"),bt.getAttribute("data-to")); };
  });
};
function openNewPr(){
  var h='<div class="cb">'+
    '<div class="f2">'+fld("PR number (from SAP, if you have it yet)","pr_no","text","800011xxx",1)+
      sel("Service type","pr_svc",["MATERIAL","SERVICE","TOOL","LICENSE","COMPONENTS"],1)+'</div>'+
    fld("Summary — what is this for","pr_sum","text","e.g. Connector shortage for IDC EDS/26-27/014",1)+
    '<div class="f2">'+fld("Department","pr_dept","text","EDS",1)+fld("Quantity","pr_qty","number","1",1)+'</div>'+
    fld("Notes","pr_notes","text","",0)+
  '</div>';
  modal("Raise a new PR",h,
    '<button class="btn sec" onclick="closeModal()">Cancel</button>'+
    '<button class="btn" id="pr_go">Save PR</button>');
  $("#pr_go").onclick=function(){
    var no=$("#pr_no").value.trim();
    if(!no){ toast("PR number is required.","Cannot save",true); return; }
    var exists=(DB.proc||[]).some(function(p){ return p.no===no; });
    if(exists){ toast("A PR with that number already exists.","Cannot save",true); return; }
    Store.pushProc({no:no,dept:$("#pr_dept").value.trim()||"EDS",summary:$("#pr_sum").value.trim(),
      svc:$("#pr_svc").value,qty:Number($("#pr_qty").value)||1,raised:today(),raisedBy:ME.n,
      apprBy:"",apprDate:"",po:"",vendor:"",amt:0,stage:"PR RAISED",poDate:"",delivered:"",
      notes:$("#pr_notes").value.trim()});
    closeModal(); toast(no+" logged as PR RAISED.","PR saved"); renderNav(); render();
  };
}
function procAdvance(no,to){
  var p=null; for(var i=0;i<(DB.proc||[]).length;i++) if(DB.proc[i].no===no) p=DB.proc[i];
  if(!p) return;
  if(to==="APPROVED"){
    var ok=Store.advanceProc(no,{stage:"APPROVED",apprBy:ME.n,apprDate:today()});
    if(!ok){ toast("Excel is open elsewhere — close it and try again.","Could not save",true); return; }
    toast(no+" approved by "+ME.n+".","Approved"); renderNav(); render(); return;
  }
  if(to==="PO RAISED"){
    var h='<div class="cb"><div class="f2">'+fld("PO number","po_no","text","4700012345",1)+
      fld("Vendor","po_v","text","Molex / Kostal / …",1)+'</div>'+
      '<div class="f2">'+fld("PO amount (INR)","po_amt","number","25000",0)+
      fld("PO date","po_dt","date",today(),1)+'</div></div>';
    modal("Raise PO for "+no,h,
      '<button class="btn sec" onclick="closeModal()">Cancel</button>'+
      '<button class="btn" id="po_go">Save PO</button>');
    $("#po_go").onclick=function(){
      var pono=$("#po_no").value.trim();
      if(!pono){ toast("PO number is required.","Cannot save",true); return; }
      var ok=Store.advanceProc(no,{stage:"PO RAISED",po:pono,vendor:$("#po_v").value.trim(),
        amt:Number($("#po_amt").value)||0,poDate:dval("po_dt")||today()});
      if(!ok){ toast("Excel is open elsewhere — close it and try again.","Could not save",true); return; }
      closeModal(); toast(no+" moved to PO RAISED ("+pono+").","PO saved"); renderNav(); render();
    };
    return;
  }
  if(to==="DELIVERED (CLOSED)"){
    var ok2=Store.advanceProc(no,{stage:"DELIVERED (CLOSED)",delivered:today()});
    if(!ok2){ toast("Excel is open elsewhere — close it and try again.","Could not save",true); return; }
    toast(no+" closed.","Delivered"); renderNav(); render(); return;
  }
  // GRN IN PROGRESS, REJECTED — simple stage moves
  var ok3=Store.advanceProc(no,{stage:to});
  if(!ok3){ toast("Excel is open elsewhere — close it and try again.","Could not save",true); return; }
  toast(no+" moved to "+to+".","Updated"); renderNav(); render();
}

/* ---------- SOFTWARE LICENSES ------------------------------------- */
function vLicenses(){
  var lic=(DB.lic||[]).slice();
  var attn=lic.filter(function(l){ var s=Store.licStatus(l.expiry); return s==="Expired"||s==="Expiring Soon"; }).length;
  var seatsUsed=0, seatsTotal=0, spend=0;
  for(var i=0;i<lic.length;i++){ seatsUsed+=lic[i].seatsUsed; seatsTotal+=lic[i].seatsTotal; spend+=lic[i].cost; }
  var canAct=isAdmin();
  var h=head("Software Licenses",
    canAct ? "Live from the Licenses tab. Add or edit a licence here and it is written straight back into the workbook."
           : "Live from the Licenses tab of the workbook.")+
   (canAct?'<div style="margin:-6px 0 16px"><button class="btn" id="lic_new">+ Add a licence</button></div>':'')+
   '<div class="tiles">'+
     tile("","Total licences",lic.length,"software products")+
     tile(attn?"r":"","Need attention",attn,"expiring within 45 days or expired")+
     tile("b","Seats in use",seatsUsed+" / "+seatsTotal,"across all products")+
     tile("a","Annual spend",inrShort(spend),"licence renewal cost")+
   '</div><div class="card">';
  if(!lic.length){
    h+='<div class="empty"><b>Nothing recorded</b>'+
       (canAct?'Add a licence above, or type rows straight into the Licenses tab of the workbook.'
              :'Ask the lab admin to add the lab\u2019s licences.')+'</div></div>';
    return h;
  }
  h+='<p class="muted fltnote" style="padding:11px 15px 0;margin:0;font-size:12.5px">'+lic.length+' rows</p>'+
     '<div class="tw"><table class="flt"><thead><tr><th>Software</th><th>Vendor</th><th>Licence type</th>'+
     '<th class="num">Seats used</th><th class="num">Seats total</th><th>Expiry</th><th>Status</th>'+
     '<th class="num">Annual cost</th><th>Notes</th>'+(canAct?'<th></th>':'')+'</tr></thead><tbody>';
  for(i=0;i<lic.length;i++){ var l=lic[i], st=Store.licStatus(l.expiry);
    h+='<tr><td><b>'+esc(l.name)+'</b></td><td>'+esc(l.vendor)+'</td><td>'+esc(l.type)+'</td>'+
      '<td class="num">'+num(l.seatsUsed,0)+'</td><td class="num">'+num(l.seatsTotal,0)+'</td>'+
      '<td class="mono">'+esc(l.expiry?fmtDate(l.expiry):"\u2014")+'</td>'+
      '<td>'+kpill(st.toUpperCase())+'</td>'+
      '<td class="num">'+(l.cost?inr(l.cost):"\u2014")+'</td>'+
      '<td class="muted" style="font-size:12px">'+esc(l.notes||"")+'</td>'+
      (canAct?'<td class="num"><button class="btn sec sm" data-lic="'+esc(l.name)+'">Edit</button></td>':'')+
      '</tr>';
  }
  return h+'</tbody></table></div></div>';
}
vLicenses.after=function(){
  wireFilters();
  if($("#lic_new")) $("#lic_new").onclick=function(){ openLicence(null); };
  $$("[data-lic]").forEach(function(b){ b.onclick=function(){ openLicence(b.getAttribute("data-lic")); }; });
};
/* Add or edit one licence. Writes into the Licenses tab, so what the portal
   shows and what the workbook holds are the same row, not two copies. */
function openLicence(name){
  var L=DB.lic||[], cur=null, i;
  if(name) for(i=0;i<L.length;i++) if(L[i].name===name) cur=L[i];
  var e=cur||{name:"",vendor:"",type:"",seatsTotal:1,seatsUsed:0,expiry:"",cost:0,notes:""};
  var vendors=[], seen={};
  for(i=0;i<L.length;i++) if(L[i].vendor && !seen[L[i].vendor]){ seen[L[i].vendor]=1; vendors.push(L[i].vendor); }
  var h=dataList("dl_licv",vendors)+
    '<div class="f2">'+
      '<div class="fg"><label>Software name <i>*</i></label>'+
        '<input type="text" id="lc_n" value="'+esc(e.name)+'"'+(cur?' readonly':'')+' placeholder="TIA Portal V18"></div>'+
      '<div class="fg"><label>Vendor</label><input type="text" id="lc_v2" list="dl_licv" value="'+esc(e.vendor)+'"></div>'+
    '</div>'+
    '<div class="f3">'+
      '<div class="fg"><label>Licence type</label><input type="text" id="lc_t" value="'+esc(e.type)+'" placeholder="Perpetual + SUS"></div>'+
      '<div class="fg"><label>Seats total</label><input type="number" id="lc_st" min="0" step="1" value="'+(Number(e.seatsTotal)||0)+'"></div>'+
      '<div class="fg"><label>Seats in use</label><input type="number" id="lc_su" min="0" step="1" value="'+(Number(e.seatsUsed)||0)+'"></div>'+
    '</div>'+
    '<div class="f2">'+
      dfield("Expiry date","lc_e",e.expiry,0,"A licence inside 45 days is flagged on the dashboard.")+
      '<div class="fg"><label>Annual cost (INR)</label><input type="number" id="lc_c" step="0.01" value="'+(Number(e.cost)||0)+'"></div>'+
    '</div>'+
    '<div class="fg"><label>Notes</label><input type="text" id="lc_nt" value="'+esc(e.notes||"")+'"></div>';
  modal(cur?("Edit "+e.name):"Add a licence",h,
    '<button class="btn sec" onclick="closeModal()">Cancel</button>'+
    '<button class="btn" id="lc_save">Save</button>');
  wireDates();
  $("#lc_save").onclick=function(){
    var nm=$("#lc_n").value.replace(/^\s+|\s+$/g,"");
    if(!nm){ toast("Software name is required.","Missing information",true); $("#lc_n").focus(); return; }
    var su=Number($("#lc_su").value)||0, st2=Number($("#lc_st").value)||0;
    if(su>st2){ toast("Seats in use ("+su+") cannot be more than seats total ("+st2+").","Check the seat counts",true); return; }
    var row={name:nm,vendor:$("#lc_v2").value,type:$("#lc_t").value,
             seatsTotal:st2,seatsUsed:su,expiry:dval("lc_e"),
             cost:Number($("#lc_c").value)||0,notes:$("#lc_nt").value};
    var ok = cur ? Store.updateLicence(nm,row) : Store.pushLicence(row);
    if(!ok){ toast("The workbook is open somewhere, so the Licenses tab could not be written. Close it and try again.","Could not save",true); return; }
    closeModal(); toast(nm+(cur?" updated.":" added."),"Licence saved"); bust(); render();
  };
}

/* ---------- JOB CARD (printable) ---------------------------------- */
function vJobCard(){
  var R=reqIndex(), r=R[SEL];
  if(!r) return head("Job card","Open a request first, then choose Print job card.")+
    '<div class="empty"><b>No request selected</b>Go to a request in My Requests / Request Queue and click Print job card.</div>';
  var matCost=0; for(var i=0;i<r.lines.length;i++){ var l=r.lines[i]; matCost+=(l.q||0)*(l.cost||partById(l.pid)&&partById(l.pid).cost||0); }
  var perCirc=Number(setting("HarnessAssemblyCostPerCircuit",0));
  var circ=Number(r.circ)||0;
  var asmCost=perCirc*circ;
  var transport=Number(setting("TransportCostFlat",0));
  var total=matCost+asmCost+transport;
  var sample=!perCirc;
  var h='<div class="jc-actions no-print"><button class="btn sec" onclick="history.back?null:null" data-go="myreq">Back</button>'+
    '<button class="btn" onclick="window.print()">Print</button></div>'+
    '<div class="jobcard">'+
    '<div class="jc-hd"><div><b>Design Centre – EDS Lab</b><br><span class="muted">JCB India Limited, Pune</span></div>'+
    '<div class="jc-to"><div><b>To:</b> '+esc(r.buc||"—")+'</div><div><b>Cc:</b> '+esc(r.dcc||"—")+'</div>'+
    '<div><b>From:</b> '+esc(ME.n)+'</div></div></div>'+
    '<table class="jc-kv"><tr><td>Job No.</td><td class="mono">'+esc(r.no)+'</td><td>DC Contact</td><td>'+esc(r.dcc||"—")+'</td></tr>'+
    '<tr><td>Harness Part Nos.</td><td class="mono">'+esc(r.harness)+'</td><td>Job received</td><td class="mono">'+esc(r.on?r.on.slice(0,10):"—")+'</td></tr>'+
    '<tr><td>Job description</td><td colspan="3">'+esc(r.scope||"—")+'</td></tr>'+
    '<tr><td>Business unit</td><td>'+esc(r.bu||"—")+'</td><td>Cost centre / BU</td><td class="mono">'+esc(r.cc||"—")+'</td></tr>'+
    '<tr><td>Machine / variant</td><td>'+esc(r.machine||"—")+'</td><td>Project code</td><td class="mono">'+esc(r.pcode||"—")+'</td></tr>'+
    '<tr><td>No. of circuits</td><td>'+num(circ,0)+'</td><td>Status</td><td>'+kpill(r.status)+'</td></tr></table>'+
    '<table class="jc-cost"><thead><tr><th>Description</th><th class="num">Cost (INR)</th></tr></thead><tbody>'+
    '<tr><td>Material (BOM) cost — sum of qty × unit cost</td><td class="num">'+num(matCost,2)+'</td></tr>'+
    '<tr><td>Harness assembly cost — '+num(circ,0)+' circuits × ₹'+num(perCirc,2)+'/circuit'+(sample?' (SAMPLE rate — set in Settings)':'')+'</td><td class="num">'+num(asmCost,2)+'</td></tr>'+
    '<tr><td>Transport cost</td><td class="num">'+num(transport,2)+'</td></tr>'+
    '<tr class="jc-tot"><td>Total cost</td><td class="num">'+inr(total)+'</td></tr></tbody></table>'+
    (sample?'<p class="muted" style="font-size:12px">Assembly-cost rate is a sample value. Set <b>HarnessAssemblyCostPerCircuit</b> in the Settings tab to your lab\'s real per-circuit rate before treating this total as final.</p>':'')+
    '</div>';
  return h;
}

/* ---------- WIRING ------------------------------------------------ */
function wire(){
  $$("[data-go]").forEach(function(el){ el.onclick=function(){
    VIEW=el.getAttribute("data-go"); SEL=null; renderNav(); render(); }; });
  $$("[data-req]").forEach(function(el){ el.onclick=function(e){
    e.stopPropagation(); openReq(el.getAttribute("data-req")); }; });
  v6wire();
  wireDates();
  wireFilters();
}
document.addEventListener("keydown",function(e){ if(e.key==="Escape") closeModal(); });

/* ---------- LIVE DATA ---------------------------------------------- */
function srcBar(){
  var el=$("#src"), dot=$("#srctext");
  if(!el) return;
  if(Store.live()){
    el.className="src";
    var d=new Date(XLS.stampAt());
    var hh=("0"+d.getHours()).slice(-2)+":"+("0"+d.getMinutes()).slice(-2);
    dot.innerHTML="<b>"+esc(XL_NAME)+"</b> &middot; updated "+hh;
  } else if(IS_HTA){
    /* the .hta could not read the workbook: say so plainly, and make it
       impossible to mistake the sample data on screen for the real thing */
    el.className="src bad";
    dot.innerHTML="<b>Not connected</b> &middot; showing sample data, nothing is saved &middot; "+
      esc(String(XLS.err()||(XL_NAME+" not found next to the portal")).replace(/^Could not read [^:]+: /,""));
  } else {
    el.className="src demo";
    dot.innerHTML="<b>Demo data</b> &middot; nothing real is being changed";
  }
}
/* ---------- SAVE STATUS ----------------------------------------------
   The one place a person can see what the Excel side is doing. Writes now
   happen a moment after the screen changes, so this is what tells them the
   change is on its way, saved, or waiting because the workbook is open. */
var _saveTimer=null;
function saveStatus(st){
  var el=$("#savest"); if(!el) return;
  if(!Store.live()){ el.style.display="none"; return; }
  el.style.display="inline-block";
  var n=0; try{ n=XLS.pendingCount(); }catch(e){}
  if(st.busy){
    el.className="savest busy"; el.innerHTML='<i></i>Saving to Excel…';
  } else if(n>0 && st.error==="locked"){
    el.className="savest wait";
    el.innerHTML='<i></i>'+n+' change'+(n===1?'':'s')+' waiting — workbook is open';
    el.title="Someone has "+XL_NAME+" open, or this login can only read it. "+
             "Nothing is lost: the changes are held beside the workbook and saved automatically "+
             "the moment it is free. Everyone already sees them in the portal.";
  } else if(n>0 && st.error){
    el.className="savest wait"; el.innerHTML='<i></i>'+n+' waiting — will retry';
    el.title=st.error;
  } else if(n>0){
    el.className="savest busy"; el.innerHTML='<i></i>'+n+' change'+(n===1?'':'s')+' to save';
  } else {
    el.className="savest ok"; el.innerHTML='<i></i>All saved';
    el.title=st.savedAt?("Last written to Excel at "+new Date(st.savedAt).toTimeString().slice(0,5)):"";
  }
}

/* Is it safe to redraw the main screen right now? Not while someone is typing
   into a form or has a dialog open — a background refresh that wipes a
   half-written request is worse than a screen that is a few seconds stale. */
var FORM_VIEWS={newreq:1,newpart:1,invoice:1,cost:1,bom:1};
function userIsBusy(){
  if($("#modal") && $("#modal").innerHTML) return true;
  if(FORM_VIEWS[VIEW]) return true;
  var a=document.activeElement;
  if(a && a.tagName){
    var t=a.tagName.toLowerCase();
    if((t==="input"||t==="textarea"||t==="select") && $("#main") && $("#main").contains(a)) return true;
  }
  return false;
}
var _deferredRender=false;
function redrawIfIdle(){
  if(!ME){ if(!($("#modal") && $("#modal").innerHTML)) renderLogin(); return; }
  renderNav();
  if(userIsBusy()){ _deferredRender=true; return; }
  _deferredRender=false;
  render();
}

function refreshNow(quiet){
  if(!Store.live()){ if(!quiet) toast("This is the demo. Put the portal beside "+XL_NAME+" to read live data.","Demo mode",true); return; }
  var okBefore=DB.parts.length;
  try{ XLS.commit(); }catch(e){}
  if(Store.reload()){
    bust(); srcBar();
    if(ME){ renderNav(); render(); } else renderLogin();
    if(!quiet){
      var diff=DB.parts.length-okBefore;
      toast(diff===0 ? "Everything is up to date." :
            (diff>0? diff+" new material added." : Math.abs(diff)+" material retired."), "Refreshed");
    }
  } else if(!quiet){
    toast(XLS.err()||"Could not read the Excel file just now. It may be mid-save. Try again in a moment.","Could not refresh",true);
  }
}
function startPolling(){
  if(!Store.live()) return;
  var lastActive=+new Date();
  function mark(){ lastActive=+new Date(); try{ XLS.noteInput(); }catch(e){} }
  if(document.addEventListener){
    document.addEventListener("keydown",mark,true); document.addEventListener("mousedown",mark,true);
  } else { document.attachEvent("onkeydown",mark); document.attachEvent("onmousedown",mark); }

  setInterval(function(){
    try{
      /* anything waiting for the workbook — ours or another desk's — gets
         another go every tick; this is a folder listing, not an Excel launch */
      XLS.kick();
      /* a background read freezes the window for a second or two across the
         network, so it waits until the person has paused */
      if(+new Date()-lastActive < 2500) return;
      /* NOT "skip while saves are pending". A read is always safe — pending
         work is laid over whatever is read — and while the store keeps the
         workbook open all morning there is ALWAYS a retry pending, so waiting
         for it would mean never seeing the store's own saves. */
      if(!XLS.changed()) {
        if(_deferredRender && !userIsBusy()){ _deferredRender=false; render(); }
        return;
      }
      var before=DB.parts.length, bl=DB.ledger.length;
      if(Store.reload()){
        bust(); srcBar();
        redrawIfIdle();
        if(ME){
          var dp=DB.parts.length-before, dl=DB.ledger.length-bl;
          var msg = dp>0 ? dp+" new material added by the store." :
                    dp<0 ? Math.abs(dp)+" material retired by the store." :
                    dl>0 ? dl+" new stock movement(s)." : "Someone saved a change.";
          toast(msg+(_deferredRender?" Your screen will refresh when you finish here.":" Your screen is up to date."),"Data updated");
        }
      }
    }catch(e){}
  }, Number(setting("AutoRefreshSeconds",10))*1000 || POLL_MS);
}

/* ---------- NEVER A SCRIPT ERROR DIALOG --------------------------------
   An .hta shows any uncaught error as a modal "Script Error" box, and on a
   shared desktop that box is what people remember. Every error now becomes a
   short notice instead, the portal keeps running, and the details go into a
   small log beside the workbook so they can be looked at later. */
window.onerror=function(msg,url,line){
  try{
    toast("Something did not work as expected. Your data is safe — if it keeps happening, tell the lab admin.",
          "Unexpected problem",true);
  }catch(e){}
  try{
    if(IS_HTA && XLS.folder()){
      var f=new ActiveXObject("Scripting.FileSystemObject"), d=XLS.pendDir();
      if(!f.FolderExists(d)) f.CreateFolder(d);
      var s2=f.OpenTextFile(d+"\\errors.log",8,true);
      s2.WriteLine(new Date().toISOString()+"\t"+(ME?ME.e:"-")+"\t"+VIEW+"\t"+line+"\t"+String(msg));
      s2.Close();
    }
  }catch(e){}
  return true;            /* true = handled: suppresses the IE Script Error box */
};

/* ---------- START -------------------------------------------------- */
(function(){
  DB = Store.init(SEED);
  if(!DB.settings) DB.settings={};
  if(!DB.reqs) DB.reqs=[];
  if(!Store.live()){
    DB.cats=SEED.cats; DB.subs=SEED.subs; DB.locs=SEED.locs; DB.sups=SEED.sups; DB.pos=SEED.pos;
  } else {
    var cs={},ss={},ls={},vs={};
    for(var i=0;i<DB.parts.length;i++){ var p=DB.parts[i];
      if(p.c)cs[p.c]=1; if(p.s)ss[p.s]=1; if(p.l)ls[p.l]=1; if(p.v)vs[p.v]=1; }
    function keys(o){ var a=[]; for(var k in o) a.push(k); a.sort(); return a; }
    DB.cats=keys(cs); DB.subs=keys(ss); DB.locs=keys(ls); DB.sups=keys(vs);
    DB.pos=[];
    var seen={};
    for(i=0;i<DB.ledger.length;i++){ var l=DB.ledger[i];
      if(!l.si||seen[l.si]) continue; seen[l.si]=1;
      DB.pos.push({no:l.si,t:/^FOC/i.test(l.si)?"FOC":"PO",v:"",d:l.dt,n:0,amt:0}); }
    var byNo={};
    for(i=0;i<DB.pos.length;i++) byNo[DB.pos[i].no]=DB.pos[i];
    for(i=0;i<DB.ledger.length;i++){ var l2=DB.ledger[i], po=byNo[l2.si];
      if(po && l2.q>0){ po.n++; po.amt+=Math.abs(l2.q)*(l2.c||0); } }
  }
  $("#logout").onclick=logout;
  $("#idback").onclick=showRoles;
  if(Store.live()){
    XLS.onStatus(saveStatus); saveStatus(XLS.status());
    /* nothing may exist only in memory when the window closes, and the hidden
       Excel this portal keeps warm must not outlive it */
    var bye=function(){ try{ XLS.shutdown(); }catch(e){} };
    if(window.addEventListener){ window.addEventListener("beforeunload",bye,false); window.addEventListener("unload",bye,false); }
    else { window.attachEvent("onbeforeunload",bye); window.attachEvent("onunload",bye); }
  } else if($("#savest")) $("#savest").style.display="none";
  $("#refresh").onclick=function(){ refreshNow(false); };
  /* An .hta opens at a small default size, which is why the portal looked
     cropped on the right. Fill the screen on launch — browsers ignore this. */
  if(IS_HTA){ try{ window.resizeTo(screen.availWidth, screen.availHeight); window.moveTo(0,0); }catch(e){} }
  $("#reset").onclick=function(){
    modal("Start again?","<p>This clears every request and transaction you have made in this demo and reloads the original data. It does not touch any real file.</p>",
      '<button class="btn sec" onclick="closeModal()">Keep my data</button><button class="btn dg" onclick="Store.reset()">Reset demo</button>');
  };
  if(Store.live()) $("#reset").style.display="none";
  $("#modal").onclick=function(e){ if(e.target===this) closeModal(); };
  srcBar(); renderLogin(); startPolling();
  /* found the workbook but could not read it — most often the network drive
     was not up yet when the desktop started. Keep trying quietly; the moment
     it reads, restart on the real data. */
  if(Store.canRetryLive && Store.canRetryLive()){
    setInterval(function(){ try{ if(Store.retryLive()) location.reload(); }catch(e){} }, 30000);
  }
})();

</script>
</body>
</html>
